@model List<RealEstateApp.Core.Application.ViewModels.SavedSearch.SavedSearchViewModel>
@{
    ViewData["Title"] = "Mis Búsquedas Guardadas";
}

<div class="container py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="font-heading fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                <i class="bi bi-bookmark-heart text-primary"></i> Mis Búsquedas Guardadas & Alertas
            </h2>
            <p class="text-muted small mb-0">
                Gestiona tus preferencias inmobiliarias y recibe notificaciones automáticas por correo cuando aparezcan nuevos inmuebles.
            </p>
        </div>
        <div>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary-gradient rounded-pill px-4 fw-bold">
                <i class="bi bi-search me-1"></i> Explorar Catálogo
            </a>
        </div>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="card border-0 shadow-sm rounded-4 text-center py-5">
            <div class="card-body">
                <div class="p-3 bg-light d-inline-block rounded-circle mb-3">
                    <i class="bi bi-bell-slash fs-1 text-muted"></i>
                </div>
                <h4 class="fw-bold font-heading">Aún no tienes búsquedas guardadas</h4>
                <p class="text-muted small max-w-lg mx-auto mb-4">
                    Cuando explores nuestro catálogo y apliques tus filtros favoritos, presiona el botón <strong>"💾 Guardar esta Búsqueda"</strong> para recibir alertas automáticas cuando un agente publique lo que estás buscando.
                </p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary-gradient rounded-pill px-4 fw-bold">
                    Ir al Catálogo de Inmuebles
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4" id="savedSearchesGrid">
            @foreach (var item in Model)
            {
                var queryParams = new List<string>();
                if (item.PropertyTypeId.HasValue) queryParams.Add($"PropertyTypeId={item.PropertyTypeId}");
                if (item.SaleTypeId.HasValue) queryParams.Add($"SaleTypeId={item.SaleTypeId}");
                if (item.ProvinceId.HasValue) queryParams.Add($"ProvinceId={item.ProvinceId}");
                if (item.MunicipalityId.HasValue) queryParams.Add($"MunicipalityId={item.MunicipalityId}");
                if (!string.IsNullOrEmpty(item.Sector)) queryParams.Add($"Sector={System.Net.WebUtility.UrlEncode(item.Sector)}");
                if (item.MinPrice.HasValue) queryParams.Add($"MinPrice={item.MinPrice}");
                if (item.MaxPrice.HasValue) queryParams.Add($"MaxPrice={item.MaxPrice}");
                if (item.MinRooms.HasValue) queryParams.Add($"MinRooms={item.MinRooms}");
                if (item.MinBathrooms.HasValue) queryParams.Add($"MinBathrooms={item.MinBathrooms}");
                if (item.MinSizeInMeters.HasValue) queryParams.Add($"MinSizeInMeters={item.MinSizeInMeters}");
                if (item.MaxSizeInMeters.HasValue) queryParams.Add($"MaxSizeInMeters={item.MaxSizeInMeters}");
                if (item.OnlyFinanciable == true) queryParams.Add("OnlyFinanciable=true");
                if (item.OnlyWithVirtualTour == true) queryParams.Add("OnlyWithVirtualTour=true");

                var searchUrl = "/Home/Index" + (queryParams.Count > 0 ? "?" + string.Join("&", queryParams) : "");

                <div class="col-lg-6" id="searchCard_@item.Id">
                    <div class="card h-100 border-0 shadow-sm rounded-4 p-4 d-flex flex-column justify-content-between transition-hover">
                        <div>
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                                <div>
                                    <h5 class="fw-bold font-heading text-dark mb-1">
                                        <i class="bi bi-bookmark-star-fill text-warning me-1"></i> @item.Name
                                    </h5>
                                    <span class="text-muted small" style="font-size: 0.78rem;">
                                        <i class="bi bi-clock-history me-1"></i> Guardada el @item.Created.ToString("dd/MM/yyyy hh:mm tt")
                                    </span>
                                </div>
                                <button type="button" class="btn btn-outline-danger btn-sm rounded-circle p-2" title="Eliminar búsqueda" onclick="deleteSearch(@item.Id)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>

                            <!-- Resumen de Criterios -->
                            <div class="p-3 bg-light rounded-3 mb-3 border">
                                <span class="text-muted small fw-bold font-heading d-block mb-1">Criterios de Coincidencia:</span>
                                <p class="fw-semibold text-dark mb-0 small">
                                    <i class="bi bi-funnel-fill text-primary me-1"></i> @item.SummaryCriteria
                                </p>
                            </div>

                            <!-- Switch de Alertas por Email -->
                            <div class="form-check form-switch d-flex align-items-center justify-content-between p-0 mb-3 bg-primary bg-opacity-10 rounded-pill px-3 py-2">
                                <label class="form-check-label small fw-bold text-dark cursor-pointer mb-0" for="switchAlert_@item.Id">
                                    <i class="bi bi-envelope-paper-heart-fill text-primary me-1"></i> Alertas por Correo Electrónico
                                </label>
                                <input class="form-check-input ms-0 mt-0 cursor-pointer" type="checkbox" role="switch" id="switchAlert_@item.Id" @(item.EmailAlertsEnabled ? "checked" : "") onchange="toggleAlerts(@item.Id)">
                            </div>
                        </div>

                        <div class="d-flex align-items-center justify-content-between pt-3 border-top gap-2">
                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2 rounded-pill font-heading">
                                <i class="bi bi-houses-fill me-1"></i> @item.CurrentMatchingCount coincidencia(s)
                            </span>
                            <a href="@searchUrl" class="btn btn-primary btn-sm rounded-pill px-3 py-2 fw-bold font-heading">
                                <i class="bi bi-box-arrow-up-right me-1"></i> Ver Resultados
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        function getAntiForgeryToken() {
            return $('input[name="__RequestVerificationToken"]').val();
        }

        function toggleAlerts(id) {
            $.ajax({
                url: '/SavedSearches/ToggleAlerts',
                type: 'POST',
                data: { id: id },
                headers: {
                    'RequestVerificationToken': getAntiForgeryToken()
                },
                success: function (res) {
                    if (res.success) {
                        // Alerta visual discreta
                    } else {
                        alert('No se pudo actualizar el estado de las alertas.');
                    }
                },
                error: function () {
                    alert('Error al comunicar con el servidor.');
                }
            });
        }

        function deleteSearch(id) {
            if (!confirm('¿Estás seguro de que deseas eliminar esta búsqueda guardada?')) return;

            $.ajax({
                url: '/SavedSearches/Delete',
                type: 'POST',
                data: { id: id },
                headers: {
                    'RequestVerificationToken': getAntiForgeryToken()
                },
                success: function (res) {
                    if (res.success) {
                        $(`#searchCard_${id}`).fadeOut(300, function () {
                            $(this).remove();
                            if ($('#savedSearchesGrid .col-lg-6').length === 0) {
                                location.reload();
                            }
                        });
                    } else {
                        alert('No se pudo eliminar la búsqueda.');
                    }
                },
                error: function () {
                    alert('Error al comunicar con el servidor.');
                }
            });
        }
    </script>
}
