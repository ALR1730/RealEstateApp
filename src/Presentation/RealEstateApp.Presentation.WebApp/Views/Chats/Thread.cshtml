@model RealEstateApp.Core.Application.ViewModels.Chat.SaveChatViewModel
@{
    ViewData["Title"] = "Chat - Propiedad " + (ViewBag.Property?.Code);
    var property = ViewBag.Property as RealEstateApp.Core.Application.ViewModels.Property.PropertyViewModel;
    var messages = ViewBag.Messages as List<RealEstateApp.Core.Application.ViewModels.Chat.ChatViewModel> ?? new List<RealEstateApp.Core.Application.ViewModels.Chat.ChatViewModel>();
    string agentPhone = "+18095550199";
    string waText = Uri.EscapeDataString($"Hola, estoy interesado en el inmueble código {property?.Code} ({property?.PropertyTypeName}) publicado en RealEstateApp.");
    string waLink = $"https://wa.me/{agentPhone.Replace("+", "").Replace(" ", "").Replace("-", "")}?text={waText}";
}

@{
    bool isAdminSupport = Model.PropertyId == -1;
    bool isDevSupport = Model.PropertyId == 0;
    bool isSupport = isAdminSupport || isDevSupport;
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Mis Chats</a></li>
            @if (isAdminSupport)
            {
                <li class="breadcrumb-item active" aria-current="page">Soporte Administración</li>
            }
            else if (isDevSupport)
            {
                <li class="breadcrumb-item active" aria-current="page">Soporte Desarrolladores</li>
            }
            else
            {
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Details" asp-route-id="@Model.PropertyId">Propiedad @(property?.Code)</a></li>
                <li class="breadcrumb-item active" aria-current="page">Chat de Propiedad</li>
            }
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="chat-container bg-white border rounded-4 shadow-sm">
                <!-- Header Nativo de la App -->
                <div class="chat-header bg-dark text-white rounded-top-4 p-3 p-md-4 d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-white bg-opacity-10 rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; flex-shrink: 0;">
                            @if (isAdminSupport)
                            {
                                <i class="bi bi-shield-lock text-warning fs-3"></i>
                            }
                            else if (isDevSupport)
                            {
                                <i class="bi bi-code-slash text-info fs-3"></i>
                            }
                            else
                            {
                                <i class="bi bi-chat-left-dots-fill text-primary fs-3"></i>
                            }
                        </div>
                        <div>
                            <h6 class="font-heading text-white fw-bold mb-0 d-flex align-items-center gap-2">
                                @if (isAdminSupport)
                                {
                                    <span>Chat de Soporte - Administración del Sistema</span>
                                    <span class="badge bg-warning text-dark font-monospace" style="font-size: 0.7rem;">Soporte Admin</span>
                                }
                                else if (isDevSupport)
                                {
                                    <span>Chat de Soporte - Equipo Desarrollador</span>
                                    <span class="badge bg-info text-dark font-monospace" style="font-size: 0.7rem;">Soporte Dev</span>
                                }
                                else
                                {
                                    <span>Chat Inmueble @(property?.Code)</span>
                                    <span class="badge bg-primary text-white font-monospace" style="font-size: 0.7rem;">Chat Directo</span>
                                }
                            </h6>
                            <span class="small text-white-50">
                                @if (isAdminSupport)
                                {
                                    <span>Canal directo de comunicación con la Administración del sistema</span>
                                }
                                else if (isDevSupport)
                                {
                                    <span>Reporte de Errores, Solicitud de Tipos de Inmuebles o Mejoras</span>
                                }
                                else
                                {
                                    <span>Precio: @property?.Price.ToString("C0") | @property?.PropertyTypeName</span>
                                }
                            </span>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        @if (!isSupport)
                        {
                            <a href="@waLink" target="_blank" class="btn btn-sm btn-success rounded-pill px-3 font-heading fw-bold d-flex align-items-center gap-1 shadow-sm">
                                <i class="bi bi-whatsapp"></i> Abrir WhatsApp
                            </a>
                            <a asp-controller="Home" asp-action="Details" asp-route-id="@Model.PropertyId" class="btn btn-sm btn-outline-light rounded-circle" title="Ver detalle del inmueble">
                                <i class="bi bi-eye"></i>
                            </a>
                        }
                    </div>
                </div>

                <!-- Chat Messages Body Estilo Nativo -->
                <div class="chat-messages bg-light" id="chatThread" style="max-height: 480px; min-height: 380px;">
                    @if (messages.Count == 0)
                    {
                        <div class="text-center my-auto py-5" id="noMessagesPlaceholder">
                            <i class="bi bi-chat-dots fs-1 text-primary d-block mb-2 opacity-75"></i>
                            <p class="text-muted small mb-1">No hay mensajes previos. Envía un mensaje para iniciar la conversación.</p>
                            <span class="badge bg-light text-dark border">Chat Interno de la Plataforma</span>
                        </div>
                    }
                    else
                    {
                        foreach (var msg in messages)
                        {
                            <div class="chat-bubble @(msg.IsMine ? "chat-bubble-mine" : "chat-bubble-other")" data-msg-id="@msg.Id">
                                <div class="message-text">@msg.MessageContent</div>
                                <div class="chat-time text-end mt-1 d-flex align-items-center justify-content-end gap-1" style="font-size: 0.72rem; opacity: 0.75;">
                                    <span>@msg.SentAt.ToString("hh:mm tt | dd/MM")</span>
                                    @if (msg.IsMine)
                                    {
                                        <i class="bi bi-check2-all text-white-50" title="Enviado"></i>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>

                <!-- Typing Indicator & Input Form Nativo -->
                <div id="typingIndicator" class="small text-muted fst-italic px-3 pt-2 d-none">
                    <i class="bi bi-three-dots me-1 text-primary"></i> La otra persona está escribiendo...
                </div>
                <div class="chat-input-area p-3 bg-white border-top">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="text-danger small px-3 mb-2">
                            @Html.ValidationSummary(false, "", new { @class = "mb-0" })
                        </div>
                    }
                    <form asp-action="Send" method="post" class="d-flex gap-2 align-items-center" id="sendChatForm">
                        <input type="hidden" asp-for="PropertyId" />
                        <input type="hidden" asp-for="RecipientId" />

                        <div class="input-group flex-grow-1">
                            <input asp-for="MessageContent" id="messageInput" class="form-control rounded-pill py-2 px-3 shadow-none border" placeholder="Escribe un mensaje..." autocomplete="off" required />
                        </div>

                        <!-- Botón Enviar en App (Azul Nativo) -->
                        <button type="submit" class="btn btn-primary rounded-circle d-flex align-items-center justify-content-center p-0 shadow-sm" style="width: 44px; height: 44px; flex-shrink: 0;" title="Enviar en la aplicación">
                            <i class="bi bi-send-fill text-white"></i>
                        </button>

                        <!-- Botón WhatsApp solo a demanda -->
                        @if (!isSupport)
                        {
                            <button type="button" id="btnSendWhatsApp" class="btn btn-success rounded-pill px-3 py-2 d-flex align-items-center gap-1 shadow-sm font-heading fw-bold" title="Enviar vía WhatsApp">
                                <i class="bi bi-whatsapp fs-6"></i>
                                <span class="d-none d-sm-inline">WhatsApp</span>
                            </button>
                        }
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="~/js/chat-realtime.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function () {
            var chatThread = document.getElementById("chatThread");
            if (chatThread) {
                chatThread.scrollTop = chatThread.scrollHeight;
            }

            var propertyId = @Model.PropertyId;
            var isSupport = @(isSupport ? "true" : "false");
            var agentPhone = "@agentPhone".replace(/[^0-9]/g, '');
            var recipientId = "@Model.RecipientId";
            var currentUserId = "@(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)";

            // Inicializar comunicación SignalR en tiempo real
            if (typeof RealEstateChat !== "undefined") {
                RealEstateChat.init({
                    propertyId: propertyId,
                    recipientId: recipientId,
                    currentUserId: currentUserId
                });

                window.onNewChatMessageReceived = function (msg) {
                    $('#noMessagesPlaceholder').remove();
                    var isMine = msg.senderId === currentUserId;
                    var bubbleClass = isMine ? 'chat-bubble-mine' : 'chat-bubble-other';
                    var checkHtml = isMine ? '<i class="bi bi-check2-all text-white-50" title="Enviado"></i>' : '';

                    var html = `
                        <div class="chat-bubble ${bubbleClass}">
                            <div class="message-text">${escapeHtml(msg.messageContent)}</div>
                            <div class="chat-time text-end mt-1 d-flex align-items-center justify-content-end gap-1" style="font-size: 0.72rem; opacity: 0.75;">
                                <span>${msg.sentAtFormatted}</span>
                                ${checkHtml}
                            </div>
                        </div>
                    `;
                    $('#chatThread').append(html);
                    if (chatThread) {
                        chatThread.scrollTop = chatThread.scrollHeight;
                    }
                };

                window.onUserTypingStatus = function (data) {
                    if (data.isTyping) {
                        $('#typingIndicator').removeClass('d-none');
                    } else {
                        $('#typingIndicator').addClass('d-none');
                    }
                };

                // Envío exclusivo al chat interno de la app
                $('#sendChatForm').on('submit', function (e) {
                    e.preventDefault();
                    var text = $('#messageInput').val().trim();
                    if (!text) return;

                    $('#messageInput').val('');

                    // Enviar vía SignalR / AJAX (Solo en la App)
                    RealEstateChat.sendMessage(text).catch(function () {
                        $.ajax({
                            url: '/Chats/Send',
                            type: 'POST',
                            data: $('#sendChatForm').serialize(),
                            success: function () {
                                location.reload();
                            }
                        });
                    });
                });

                // Botón a demanda para abrir WhatsApp
                $('#btnSendWhatsApp').on('click', function () {
                    var text = $('#messageInput').val().trim();
                    if (!text) {
                        text = "Hola, estoy interesado en este inmueble publicado en RealEstateApp.";
                    } else {
                        // Opcionalmente guardar el mensaje en la app al presionar el botón de WhatsApp
                        RealEstateChat.sendMessage(text);
                        $('#messageInput').val('');
                    }

                    var waUrl = 'https://wa.me/' + agentPhone + '?text=' + encodeURIComponent(text);
                    window.open(waUrl, '_blank');
                });

                var typingTimeout;
                $('#messageInput').on('input', function () {
                    RealEstateChat.sendTyping(true);
                    clearTimeout(typingTimeout);
                    typingTimeout = setTimeout(function () {
                        RealEstateChat.sendTyping(false);
                    }, 2000);
                });
            }

            function escapeHtml(text) {
                return $('<div>').text(text).html();
            }
        });
    </script>
}
