@model List<RealEstateApp.Core.Application.ViewModels.Chat.ChatViewModel>
@{
    ViewData["Title"] = "Mis Mensajes y Chats WhatsApp";
}

<div class="container py-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="font-heading fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                <i class="bi bi-chat-dots-fill text-primary me-1"></i> Hilos de Conversación y Soporte
            </h2>
            <p class="text-muted small mb-0">Comunicación entre clientes, agentes y equipo de desarrolladores (solicitudes y soporte API).</p>
        </div>
        <div class="d-flex gap-2">
            @if (User.IsInRole("Developer"))
            {
                <a asp-action="AdminSupport" class="btn btn-outline-warning text-dark rounded-pill px-3 font-heading fw-bold">
                    <i class="bi bi-shield-lock me-1"></i> Contactar a Administración
                </a>
            }
            else
            {
                <a asp-action="DeveloperSupport" class="btn btn-outline-info rounded-pill px-3 font-heading fw-bold">
                    <i class="bi bi-code-slash me-1"></i> Contactar a Desarrolladores
                </a>
            }
            <span class="badge bg-success px-3 py-2 rounded-pill font-monospace d-none d-md-inline-flex align-items-center" style="font-size: 0.82rem;">
                <i class="bi bi-patch-check-fill me-1"></i> WhatsApp Synced
            </span>
        </div>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="text-center py-5 bg-white rounded-4 shadow-sm border">
            <i class="bi bi-chat-left-text fs-1 text-primary d-block mb-3 opacity-75"></i>
            <h5 class="font-heading text-dark">No tienes conversaciones activas</h5>
            <p class="text-muted small">Haz clic en el botón de soporte para iniciar una conversación.</p>
            <div class="d-flex justify-content-center gap-2 mt-3">
                @if (User.IsInRole("Developer"))
                {
                    <a asp-action="AdminSupport" class="btn btn-warning text-dark rounded-pill px-4 fw-bold">
                        <i class="bi bi-shield-lock me-1"></i> Escribir a Administración
                    </a>
                }
                else
                {
                    <a asp-action="DeveloperSupport" class="btn btn-info text-white rounded-pill px-4">
                        <i class="bi bi-code-slash me-1"></i> Escribir a Soporte Dev
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary rounded-pill px-4">
                        <i class="bi bi-search me-1"></i> Explorar Inmuebles
                    </a>
                }
            </div>
        </div>
    }
    else
    {
        var groupedChats = Model.GroupBy(c => c.PropertyId).ToList();

        <div class="row g-3">
            @foreach (var group in groupedChats)
            {
                var latestMsg = group.First();
                var isDevSupportThread = latestMsg.PropertyId == 0;
                var isAdminSupportThread = latestMsg.PropertyId == -1;

                <div class="col-md-6 col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100 p-4 d-flex flex-column justify-content-between card-chat" 
                         data-href="@Url.Action("Thread", "Chats", new { propertyId = latestMsg.PropertyId, agentId = latestMsg.AgenteId, clienteId = latestMsg.ClienteId })">
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                @if (isAdminSupportThread)
                                {
                                    <span class="badge bg-warning text-dark px-3 py-1 rounded-pill d-inline-flex align-items-center gap-1">
                                        <i class="bi bi-shield-lock"></i> Soporte Admin
                                    </span>
                                }
                                else if (isDevSupportThread)
                                {
                                    <span class="badge bg-info text-dark px-3 py-1 rounded-pill d-inline-flex align-items-center gap-1">
                                        <i class="bi bi-code-slash"></i> Soporte API / Dev
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success px-3 py-1 rounded-pill d-inline-flex align-items-center gap-1">
                                        <i class="bi bi-building"></i> Propiedad #@latestMsg.PropertyCode
                                    </span>
                                }
                                <span class="small text-muted">@latestMsg.SentAt.ToString("dd/MM/yyyy")</span>
                            </div>

                            <div class="d-flex align-items-center gap-1 my-2">
                                @if (isAdminSupportThread || isDevSupportThread)
                                {
                                    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill">
                                        <i class="bi bi-chat-left-dots"></i> Solicitud / Soporte
                                    </span>
                                }
                                else
                                {
                                    <span class="wa-badge">
                                        <i class="bi bi-whatsapp"></i> WhatsApp
                                    </span>
                                }
                            </div>

                            <p class="text-secondary small mb-3 text-truncate-2">
                                <i class="bi bi-quote me-1"></i>@latestMsg.MessageContent
                            </p>
                        </div>

                        <div>
                            <hr class="my-3 opacity-25">
                            @if (isAdminSupportThread)
                            {
                                <a asp-action="Thread" asp-route-propertyId="-1" asp-route-agentId="@latestMsg.AgenteId" asp-route-clienteId="@latestMsg.ClienteId" class="btn btn-outline-warning text-dark w-100 py-2 rounded-pill fw-bold">
                                    Abrir Chat de Soporte Admin <i class="bi bi-arrow-right-short ms-1"></i>
                                </a>
                            }
                            else if (isDevSupportThread)
                            {
                                <a asp-action="Thread" asp-route-propertyId="0" asp-route-agentId="@latestMsg.AgenteId" asp-route-clienteId="@latestMsg.ClienteId" class="btn btn-outline-info w-100 py-2 rounded-pill fw-bold">
                                    Abrir Chat de Soporte Dev <i class="bi bi-arrow-right-short ms-1"></i>
                                </a>
                            }
                            else
                            {
                                <a asp-action="Thread" asp-route-propertyId="@latestMsg.PropertyId" asp-route-agentId="@latestMsg.AgenteId" asp-route-clienteId="@latestMsg.ClienteId" class="btn btn-outline-success w-100 py-2 rounded-pill fw-bold">
                                    Abrir WhatsApp Chat <i class="bi bi-whatsapp ms-1"></i>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
