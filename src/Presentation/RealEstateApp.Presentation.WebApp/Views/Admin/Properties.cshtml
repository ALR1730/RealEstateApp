@model List<RealEstateApp.Core.Application.ViewModels.Property.PropertyViewModel>
@{
    ViewData["Title"] = "Gestión Global de Inmuebles";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="font-heading fw-bold text-dark mb-1"><i class="bi bi-building text-primary me-2"></i> Gestión Global de Propiedades</h2>
            <p class="text-muted small mb-0">Visualiza todas las propiedades del sistema, reasígnalas a otros agentes o elimínalas.</p>
        </div>
        <span class="badge bg-primary rounded-pill fs-6 px-3 py-2">@Model.Count Propiedades</span>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-2">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div>@TempData["SuccessMessage"]</div>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-2">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <div>@TempData["ErrorMessage"]</div>
        </div>
    }

    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small text-uppercase font-heading">
                    <tr>
                        <th class="py-3 px-4">Código / Tipo</th>
                        <th class="py-3">Precio</th>
                        <th class="py-3">Agente Asignado</th>
                        <th class="py-3">Estado</th>
                        <th class="py-3 px-4 text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var property in Model)
                    {
                        <tr>
                            <td class="py-3 px-4">
                                <span class="fw-bold font-heading text-dark d-block">#@property.Code</span>
                                <span class="small text-muted">@property.PropertyTypeName (@property.SaleTypeName)</span>
                            </td>
                            <td class="fw-bold text-success">@property.Price.ToString("C0")</td>
                            <td>
                                <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">
                                    <i class="bi bi-person-badge me-1"></i> @property.AgentName
                                </span>
                            </td>
                            <td>
                                @if (property.Status == "Disponible")
                                {
                                    <span class="badge bg-success px-3 py-2 rounded-pill"><i class="bi bi-check-circle-fill me-1"></i> Disponible</span>
                                }
                                else if (property.Status == "Reservada")
                                {
                                    <span class="badge bg-warning text-dark px-3 py-2 rounded-pill"><i class="bi bi-clock-history me-1"></i> Reservada</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger px-3 py-2 rounded-pill"><i class="bi bi-tag-fill me-1"></i> Vendida</span>
                                }
                            </td>
                            <td class="py-3 px-4 text-end">
                                <div class="d-inline-flex gap-2 align-items-center">
                                    <a asp-action="ReassignProperty" asp-route-id="@property.Id" class="btn btn-sm btn-outline-info font-heading" title="Reasignar agente">
                                        <i class="bi bi-person-lines-fill me-1"></i> Reasignar
                                    </a>

                                    <form asp-action="DeleteProperty" method="post" onsubmit="return confirm('¿Está seguro de eliminar esta propiedad? Esta acción no se puede deshacer.');">
                                        <input type="hidden" name="id" value="@property.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger font-heading" title="Eliminar propiedad">
                                            <i class="bi bi-trash-fill me-1"></i> Eliminar
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
