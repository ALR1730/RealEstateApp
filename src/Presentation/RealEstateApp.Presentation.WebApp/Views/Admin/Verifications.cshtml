@model List<RealEstateApp.Core.Application.ViewModels.Agent.AgentVerificationViewModel>
@{
    ViewData["Title"] = "Gestión de Verificación de Agentes";
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="font-heading fw-bold text-dark mb-1">
                <i class="bi bi-shield-lock-fill text-primary me-2"></i>Verificación de Identidad de Agentes
            </h3>
            <p class="text-muted small mb-0">
                Auditoría y validación de Cédulas de Identidad dominicanas enviadas por agentes para otorgar insignias oficiales de confianza.
            </p>
        </div>
        <a asp-action="Dashboard" class="btn btn-outline-secondary rounded-pill btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Volver al Dashboard
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm p-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm p-3 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Tabla de Solicitudes -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small text-uppercase">
                    <tr>
                        <th class="ps-4">Agente</th>
                        <th>Cédula</th>
                        <th>Documentos</th>
                        <th>Fecha de Solicitud</th>
                        <th>Estado</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || Model.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                No hay solicitudes de verificación registradas en el sistema.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-dark font-heading">@item.AgentName</div>
                                    <div class="small text-muted">@item.AgentEmail</div>
                                    @if (!string.IsNullOrEmpty(item.AgentPhone))
                                    {
                                        <div class="small text-muted"><i class="bi bi-telephone me-1"></i>@item.AgentPhone</div>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-dark font-monospace px-3 py-2 fs-6">@item.Cedula</span>
                                </td>
                                <td>
                                    <div class="d-flex gap-2">
                                        @if (!string.IsNullOrEmpty(item.FrontImageUrl))
                                        {
                                            <a href="@item.FrontImageUrl" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill" title="Ver Frente de Cédula">
                                                <i class="bi bi-eye me-1"></i> Frente
                                            </a>
                                        }
                                        @if (!string.IsNullOrEmpty(item.BackImageUrl))
                                        {
                                            <a href="@item.BackImageUrl" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill" title="Ver Reverso de Cédula">
                                                <i class="bi bi-eye me-1"></i> Reverso
                                            </a>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="small text-muted">@item.Created?.ToString("dd/MM/yyyy HH:mm")</span>
                                </td>
                                <td>
                                    @if (item.IsVerified)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2 rounded-pill">
                                            <i class="bi bi-patch-check-fill me-1"></i> Aprobado
                                        </span>
                                    }
                                    else if (item.IsPending)
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-3 py-2 rounded-pill">
                                            <i class="bi bi-hourglass-split me-1"></i> Pendiente
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-3 py-2 rounded-pill" title="@item.RejectionReason">
                                            <i class="bi bi-x-circle-fill me-1"></i> Rechazado
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    @if (item.IsPending)
                                    {
                                        <div class="d-flex justify-content-end gap-2">
                                            <form asp-action="ApproveVerification" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="btn btn-sm btn-success rounded-pill px-3 fw-bold" onclick="return confirm('¿Aprobar la verificación de identidad para este agente?')">
                                                    <i class="bi bi-check-lg me-1"></i> Aprobar
                                                </button>
                                            </form>

                                            <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-bold" data-bs-toggle="modal" data-bs-target="#rejectModal_@item.Id">
                                                <i class="bi bi-x-lg me-1"></i> Rechazar
                                            </button>
                                        </div>

                                        <!-- Modal de Rechazo -->
                                        <div class="modal fade text-start" id="rejectModal_@item.Id" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content rounded-4 shadow border-0">
                                                    <div class="modal-header bg-danger text-white rounded-top-4">
                                                        <h5 class="modal-title font-heading fw-bold">
                                                            <i class="bi bi-exclamation-triangle-fill me-2"></i> Rechazar Verificación
                                                        </h5>
                                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <form asp-action="RejectVerification" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@item.Id" />
                                                        <div class="modal-body p-4">
                                                            <div class="mb-3">
                                                                <label class="form-label fw-bold small text-dark">Motivo del Rechazo</label>
                                                                <textarea name="rejectionReason" class="form-control form-control-custom" rows="3" placeholder="Ej: La imagen de la cédula está borrosa / El número de cédula no coincide con el documento." required></textarea>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer bg-light rounded-bottom-4">
                                                            <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancelar</button>
                                                            <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">Confirmar Rechazo</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else if (item.IsVerified)
                                    {
                                        <span class="small text-muted">Revisado por @item.ReviewedByAdminName</span>
                                    }
                                    else
                                    {
                                        <span class="small text-muted text-truncate d-inline-block" style="max-width: 150px;" title="@item.RejectionReason">Motivo: @item.RejectionReason</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
