@model RealEstateApp.Core.Application.ViewModels.Account.RegisterViewModel
@{
    ViewData["Title"] = "Registrar Desarrollador";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-dark text-white p-4 text-center border-0" style="background: var(--bg-gradient-hero) !important;">
                    <h3 class="font-heading text-white fw-bold mb-1">Nuevo Desarrollador</h3>
                    <p class="small text-white-50 mb-0">Crea una cuenta con acceso a endpoints de la API</p>
                </div>

                <div class="card-body p-4 p-md-5">
                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                    {
                        <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4">
                            @Html.ValidationSummary(true, "", new { @class = "mb-0" })
                        </div>
                    }

                    <form asp-action="CreateDeveloper" method="post">
                        <input type="hidden" asp-for="UserType" value="Developer" />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="FirstName" class="form-label fw-medium text-dark small"></label>
                                <input asp-for="FirstName" class="form-control form-control-custom" />
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="LastName" class="form-label fw-medium text-dark small"></label>
                                <input asp-for="LastName" class="form-control form-control-custom" />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-medium text-dark small"></label>
                                <input asp-for="Email" class="form-control form-control-custom" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="UserName" class="form-label fw-medium text-dark small"></label>
                                <input asp-for="UserName" class="form-control form-control-custom" />
                                <span asp-validation-for="UserName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label fw-medium text-dark small"></label>
                                <input asp-for="Phone" class="form-control form-control-custom" />
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6"></div>

                            <div class="col-md-6">
                                <label asp-for="Password" class="form-label fw-medium text-dark small"></label>
                                <input asp-for="Password" class="form-control form-control-custom" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ConfirmPassword" class="form-label fw-medium text-dark small"></label>
                                <input asp-for="ConfirmPassword" class="form-control form-control-custom" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-primary-gradient flex-grow-1 py-3 font-heading fw-bold">
                                <i class="bi bi-check-circle-fill me-2"></i> Registrar Desarrollador
                            </button>
                            <a asp-action="Developers" class="btn btn-outline-custom py-3 px-4">
                                Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
