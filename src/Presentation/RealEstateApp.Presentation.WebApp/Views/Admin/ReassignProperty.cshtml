@model RealEstateApp.Core.Application.ViewModels.Property.ReassignPropertyViewModel
@{
    ViewData["Title"] = "Reasignar Agente de Propiedad";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-dark text-white p-4 text-center border-0" style="background: var(--bg-gradient-hero) !important;">
                    <h3 class="font-heading text-white fw-bold mb-1">Reasignar Propiedad #@Model.PropertyCode</h3>
                    <p class="small text-white-50 mb-0">Selecciona el nuevo agente responsable de este inmueble</p>
                </div>

                <div class="card-body p-4 p-md-5">
                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                    {
                        <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4">
                            @Html.ValidationSummary(true, "", new { @class = "mb-0" })
                        </div>
                    }

                    <div class="bg-light p-3 rounded-3 mb-4 border">
                        <div class="row g-2 small">
                            <div class="col-6">
                                <span class="text-muted d-block">Tipo de Inmueble:</span>
                                <strong class="text-dark">@Model.PropertyTypeName</strong>
                            </div>
                            <div class="col-6">
                                <span class="text-muted d-block">Precio:</span>
                                <strong class="text-success">@Model.Price.ToString("C0")</strong>
                            </div>
                            <div class="col-12 mt-2">
                                <span class="text-muted d-block">Agente Actual:</span>
                                <strong class="text-primary"><i class="bi bi-person-badge me-1"></i> @Model.CurrentAgentName</strong>
                            </div>
                        </div>
                    </div>

                    <form asp-action="ReassignProperty" method="post">
                        <input type="hidden" asp-for="PropertyId" />
                        <input type="hidden" asp-for="PropertyCode" />

                        <div class="mb-4">
                            <label asp-for="NewAgentId" class="form-label fw-medium text-dark small"></label>
                            <select asp-for="NewAgentId" class="form-select form-select-custom">
                                <option value="">-- Seleccione un nuevo agente --</option>
                                @foreach (var agent in Model.Agents)
                                {
                                    <option value="@agent.Id">@agent.FullName (@agent.Email)</option>
                                }
                            </select>
                            <span asp-validation-for="NewAgentId" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary-gradient flex-grow-1 py-3 font-heading fw-bold">
                                <i class="bi bi-check-circle-fill me-2"></i> Confirmar Reasignación
                            </button>
                            <a asp-action="Properties" class="btn btn-outline-custom py-3 px-4">
                                Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
