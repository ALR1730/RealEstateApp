@{
    ViewData["Title"] = "Dashboard Administrador";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="font-heading fw-bold text-dark mb-1"><i class="bi bi-speedometer2 text-primary me-2"></i> Dashboard de Indicadores</h2>
            <p class="text-muted small mb-0">Resumen en tiempo real del estado general del sistema, propiedades y usuarios.</p>
        </div>
    </div>

    <!-- Grilla de KPI Cards principales -->
    <div class="row g-4 mb-5">
        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border-start border-4 border-success h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small font-heading">Propiedades Disponibles</span>
                    <i class="bi bi-house-check-fill text-success fs-3"></i>
                </div>
                <h2 class="font-heading fw-bold text-dark mb-0">@ViewBag.TotalAvailableProperties</h2>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border-start border-4 border-warning h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small font-heading">Propiedades Reservadas</span>
                    <i class="bi bi-house-dash-fill text-warning fs-3"></i>
                </div>
                <h2 class="font-heading fw-bold text-dark mb-0">@ViewBag.TotalReservedProperties</h2>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border-start border-4 border-danger h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small font-heading">Propiedades Vendidas</span>
                    <i class="bi bi-house-heart-fill text-danger fs-3"></i>
                </div>
                <h2 class="font-heading fw-bold text-dark mb-0">@ViewBag.TotalSoldProperties</h2>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border-start border-4 border-info h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small font-heading">Agentes Activos</span>
                    <i class="bi bi-person-check-fill text-info fs-3"></i>
                </div>
                <h2 class="font-heading fw-bold text-dark mb-0">@ViewBag.TotalActiveAgents</h2>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border-start border-4 border-secondary h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small font-heading">Agentes Inactivos</span>
                    <i class="bi bi-person-x-fill text-secondary fs-3"></i>
                </div>
                <h2 class="font-heading fw-bold text-dark mb-0">@ViewBag.TotalInactiveAgents</h2>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border-start border-4 border-primary h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small font-heading">Clientes Registrados</span>
                    <i class="bi bi-people-fill text-primary fs-3"></i>
                </div>
                <h2 class="font-heading fw-bold text-dark mb-0">@ViewBag.TotalClients</h2>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border-start border-4 border-dark h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small font-heading">Desarrolladores API</span>
                    <i class="bi bi-code-slash text-dark fs-3"></i>
                </div>
                <h2 class="font-heading fw-bold text-dark mb-0">@ViewBag.TotalDevelopers</h2>
            </div>
        </div>
    </div>

    <!-- Gráficas Interactivas con Chart.js -->
    <h4 class="font-heading fw-bold mb-3"><i class="bi bi-pie-chart-fill me-2 text-info"></i>Análisis Gráfico y Métricas</h4>
    <div class="row g-4 mb-5">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <h6 class="fw-bold text-dark mb-3"><i class="bi bi-pie-chart me-2 text-primary"></i>Distribución de Propiedades por Estado</h6>
                <div style="height: 260px;">
                    <canvas id="statusChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <h6 class="fw-bold text-dark mb-3"><i class="bi bi-bar-chart-line me-2 text-success"></i>Propiedades por Tipo de Inmueble</h6>
                <div style="height: 260px;">
                    <canvas id="typeChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Enlaces Rápidos de Gestión Administrador -->
    <h4 class="font-heading fw-bold mb-3"><i class="bi bi-grid-fill me-2 text-primary"></i>Accesos Directos de Administración</h4>
    <div class="row g-3">
        <div class="col-md-6 col-lg-4">
            <a asp-action="Properties" class="btn btn-outline-custom w-100 p-4 text-start rounded-4 d-flex align-items-center gap-3 h-100 shadow-sm">
                <i class="bi bi-building fs-1 text-primary"></i>
                <div>
                    <h6 class="font-heading fw-bold mb-0 text-dark">Gestión de Propiedades</h6>
                    <span class="small text-muted">Reasignar agentes o eliminar publicaciones</span>
                </div>
            </a>
        </div>
        <div class="col-md-6 col-lg-4">
            <a asp-action="Agents" class="btn btn-outline-custom w-100 p-4 text-start rounded-4 d-flex align-items-center gap-3 h-100 shadow-sm">
                <i class="bi bi-person-gear fs-1 text-info"></i>
                <div>
                    <h6 class="font-heading fw-bold mb-0 text-dark">Gestión de Agentes</h6>
                    <span class="small text-muted">Activar, inactivar o eliminar agentes</span>
                </div>
            </a>
        </div>
        <div class="col-md-6 col-lg-4">
            <a asp-action="Developers" class="btn btn-outline-custom w-100 p-4 text-start rounded-4 d-flex align-items-center gap-3 h-100 shadow-sm">
                <i class="bi bi-code-slash fs-1 text-dark"></i>
                <div>
                    <h6 class="font-heading fw-bold mb-0 text-dark">Desarrolladores</h6>
                    <span class="small text-muted">Gestión y edición de usuarios de API</span>
                </div>
            </a>
        </div>
        <div class="col-md-6 col-lg-4">
            <a asp-controller="AdminPropertyTypes" asp-action="Index" class="btn btn-outline-custom w-100 p-4 text-start rounded-4 d-flex align-items-center gap-3 h-100 shadow-sm">
                <i class="bi bi-house-door fs-1 text-success"></i>
                <div>
                    <h6 class="font-heading fw-bold mb-0 text-dark">Tipos de Propiedades</h6>
                    <span class="small text-muted">Mantenimiento de categorías de inmuebles</span>
                </div>
            </a>
        </div>
        <div class="col-md-6 col-lg-4">
            <a asp-controller="AdminSaleTypes" asp-action="Index" class="btn btn-outline-custom w-100 p-4 text-start rounded-4 d-flex align-items-center gap-3 h-100 shadow-sm">
                <i class="bi bi-tags fs-1 text-warning"></i>
                <div>
                    <h6 class="font-heading fw-bold mb-0 text-dark">Tipos de Ventas</h6>
                    <span class="small text-muted">Mantenimiento de modalidades de negocio</span>
                </div>
            </a>
        </div>
        <div class="col-md-6 col-lg-4">
            <a asp-controller="AdminImprovements" asp-action="Index" class="btn btn-outline-custom w-100 p-4 text-start rounded-4 d-flex align-items-center gap-3 h-100 shadow-sm">
                <i class="bi bi-stars fs-1 text-danger"></i>
                <div>
                    <h6 class="font-heading fw-bold mb-0 text-dark">Mejoras de Propiedades</h6>
                    <span class="small text-muted">Mantenimiento de amenidades y mejoras</span>
                </div>
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        $(document).ready(function () {
            $.ajax({
                url: '/Admin/GetDashboardChartsData',
                type: 'GET',
                success: function (res) {
                    if (!res) return;

                    // Chart 1: Status Doughnut
                    new Chart(document.getElementById('statusChart'), {
                        type: 'doughnut',
                        data: {
                            labels: res.statusData.labels,
                            datasets: [{
                                data: res.statusData.data,
                                backgroundColor: ['#10b981', '#f59e0b', '#ef4444']
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false
                        }
                    });

                    // Chart 2: Types Bar Chart
                    new Chart(document.getElementById('typeChart'), {
                        type: 'bar',
                        data: {
                            labels: res.typeData.labels,
                            datasets: [{
                                label: 'Propiedades',
                                data: res.typeData.data,
                                backgroundColor: '#0284c7'
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: { legend: { display: false } }
                        }
                    });
                }
            });
        });
    </script>
}
