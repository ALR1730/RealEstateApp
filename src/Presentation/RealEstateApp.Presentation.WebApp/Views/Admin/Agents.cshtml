@model List<RealEstateApp.Core.Application.ViewModels.Agent.AgentViewModel>
@{
    ViewData["Title"] = "Gestión de Agentes";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="font-heading fw-bold text-dark mb-1"><i class="bi bi-person-gear text-primary me-2"></i> Gestión de Agentes Inmobiliarios</h2>
            <p class="text-muted small mb-0">Activa o inactiva cuentas de agentes y realiza la eliminación física en cascada.</p>
        </div>
        <span class="badge bg-primary rounded-pill fs-6 px-3 py-2">@Model.Count Agentes</span>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-2">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div>@TempData["SuccessMessage"]</div>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-2">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <div>@TempData["ErrorMessage"]</div>
        </div>
    }

    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small text-uppercase font-heading">
                    <tr>
                        <th class="py-3 px-4">Agente</th>
                        <th class="py-3">Correo</th>
                        <th class="py-3">Propiedades</th>
                        <th class="py-3">Estado Actual</th>
                        <th class="py-3 px-4 text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var agent in Model)
                    {
                        <tr>
                            <td class="py-3 px-4">
                                <span class="fw-bold font-heading text-dark d-block">@agent.FullName</span>
                                <span class="small text-muted">ID: @agent.Id</span>
                            </td>
                            <td>@agent.Email</td>
                            <td><span class="badge bg-info text-dark rounded-pill fs-6 px-3">@agent.PropertiesCount</span></td>
                            <td>
                                @if (agent.IsActive)
                                {
                                    <span class="badge bg-success px-3 py-2 rounded-pill"><i class="bi bi-check-circle-fill me-1"></i> Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger px-3 py-2 rounded-pill"><i class="bi bi-x-circle-fill me-1"></i> Inactivo / Pendiente</span>
                                }
                            </td>
                            <td class="py-3 px-4 text-end">
                                <div class="d-inline-flex gap-2 align-items-center">
                                    <!-- Toggle Status Button -->
                                    <form asp-action="ToggleAgentStatus" method="post">
                                        <input type="hidden" name="agentId" value="@agent.Id" />
                                        <input type="hidden" name="isActive" value="@(agent.IsActive ? "false" : "true")" />
                                        @if (agent.IsActive)
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-warning font-heading" title="Inactivar agente">
                                                <i class="bi bi-person-x-fill me-1"></i> Inactivar
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-sm btn-success font-heading" title="Activar agente">
                                                <i class="bi bi-person-check-fill me-1"></i> Activar
                                            </button>
                                        }
                                    </form>

                                    <!-- Delete Cascade Button -->
                                    <a asp-action="DeleteAgent" asp-route-id="@agent.Id" class="btn btn-sm btn-outline-danger font-heading" title="Eliminar agente en cascada">
                                        <i class="bi bi-trash-fill"></i> Eliminar
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
