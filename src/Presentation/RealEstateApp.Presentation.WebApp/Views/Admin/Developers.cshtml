@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityUser>
@{
    ViewData["Title"] = "Gestión de Desarrolladores";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="font-heading fw-bold text-dark mb-1"><i class="bi bi-code-slash text-dark me-2"></i> Desarrolladores Registrados</h2>
            <p class="text-muted small mb-0">Gestión de usuarios con rol de desarrollador para la Web API.</p>
        </div>
        <a asp-action="CreateDeveloper" class="btn btn-primary-gradient px-4 py-2 font-heading fw-bold rounded-pill">
            <i class="bi bi-person-plus-fill me-1"></i> Registrar Desarrollador
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-2">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div>@TempData["SuccessMessage"]</div>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-2">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <div>@TempData["ErrorMessage"]</div>
        </div>
    }

    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small text-uppercase font-heading">
                    <tr>
                        <th class="py-3 px-4">Usuario</th>
                        <th class="py-3">Correo Electrónico</th>
                        <th class="py-3">Teléfono</th>
                        <th class="py-3">Estado Actual</th>
                        <th class="py-3 px-4 text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        var isActive = !user.LockoutEnabled || !user.LockoutEnd.HasValue || user.LockoutEnd.Value <= DateTimeOffset.UtcNow;
                        <tr>
                            <td class="py-3 px-4 fw-bold font-heading text-dark">@user.UserName</td>
                            <td>@user.Email</td>
                            <td class="small text-muted">@(string.IsNullOrEmpty(user.PhoneNumber) ? "N/A" : user.PhoneNumber)</td>
                            <td>
                                @if (isActive)
                                {
                                    <span class="badge bg-success px-3 py-2 rounded-pill"><i class="bi bi-check-circle-fill me-1"></i> Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger px-3 py-2 rounded-pill"><i class="bi bi-x-circle-fill me-1"></i> Inactivo</span>
                                }
                            </td>
                            <td class="py-3 px-4 text-end">
                                <div class="d-inline-flex gap-2 align-items-center">
                                    <a asp-action="EditDeveloper" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary font-heading" title="Editar desarrollador">
                                        <i class="bi bi-pencil-square me-1"></i> Editar
                                    </a>

                                    <form asp-action="ToggleDeveloperStatus" method="post">
                                        <input type="hidden" name="developerId" value="@user.Id" />
                                        <input type="hidden" name="isActive" value="@(isActive ? "false" : "true")" />
                                        @if (isActive)
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-warning font-heading" title="Inactivar desarrollador">
                                                <i class="bi bi-person-x-fill me-1"></i> Inactivar
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-sm btn-success font-heading" title="Activar desarrollador">
                                                <i class="bi bi-person-check-fill me-1"></i> Activar
                                            </button>
                                        }
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
