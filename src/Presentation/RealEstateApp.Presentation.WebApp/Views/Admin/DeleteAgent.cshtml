@model RealEstateApp.Core.Application.ViewModels.Agent.AgentViewModel
@{
    ViewData["Title"] = "Confirmar Eliminación de Agente";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 text-center">
            <div class="card border-0 shadow-lg rounded-4 p-5 border-top border-4 border-danger">
                <div class="d-inline-flex p-4 rounded-circle bg-danger bg-opacity-10 text-danger mb-4 mx-auto" style="width: 90px; height: 90px; align-items: center; justify-content: center;">
                    <i class="bi bi-exclamation-triangle-fill fs-1"></i>
                </div>
                
                <h3 class="font-heading fw-bold text-danger mb-2">Eliminación Física en Cascada</h3>
                <h5 class="font-heading text-dark mb-4">¿Está completamente seguro de eliminar al agente <strong>@Model.FullName</strong>?</h5>

                <div class="alert alert-warning text-start border-0 rounded-3 p-4 mb-4 small">
                    <h6 class="font-heading fw-bold text-dark mb-2"><i class="bi bi-info-circle me-1"></i> Esta acción es irreversible y eliminará:</h6>
                    <ul class="mb-0 ps-3">
                        <li class="mb-1"><strong>@Model.PropertiesCount propiedades</strong> asociadas al agente.</li>
                        <li class="mb-1">Todas las <strong>imágenes de los inmuebles</strong> guardadas en disco.</li>
                        <li class="mb-1">Todos los <strong>favoritos y ofertas</strong> enviadas a esas propiedades.</li>
                        <li class="mb-1">Todos los <strong>mensajes e hilos de chat</strong> vinculados al agente.</li>
                        <li>La cuenta de usuario en ASP.NET Core Identity.</li>
                    </ul>
                </div>

                <form asp-action="ConfirmDeleteAgent" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="d-flex justify-content-center gap-3">
                        <button type="submit" class="btn btn-danger px-4 py-2 font-heading fw-bold rounded-pill">
                            <i class="bi bi-trash-fill me-2"></i> Sí, Eliminar Todo en Cascada
                        </button>
                        <a asp-action="Agents" class="btn btn-outline-custom px-4 py-2 rounded-pill font-heading fw-bold">
                            Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
