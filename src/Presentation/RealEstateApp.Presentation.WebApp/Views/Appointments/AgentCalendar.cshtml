@model List<RealEstateApp.Core.Application.ViewModels.Appointment.PropertyAppointmentViewModel>
@{
    ViewData["Title"] = "Agenda de Citas del Agente";
}

<!-- FullCalendar CSS CDN -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.css" />

<div class="container py-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="font-heading fw-bold text-dark mb-1"><i class="bi bi-calendar3 text-primary me-2"></i> Agenda Ejecutiva de Citas</h2>
            <p class="text-muted small mb-0">Gestiona tus visitas presenciales programadas en un calendario interactivo en tiempo real.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill"><i class="bi bi-circle-fill me-1" style="font-size: 8px;"></i> Pendiente</span>
            <span class="badge bg-primary px-3 py-2 rounded-pill"><i class="bi bi-circle-fill me-1" style="font-size: 8px;"></i> Confirmada</span>
            <span class="badge bg-success px-3 py-2 rounded-pill"><i class="bi bi-circle-fill me-1" style="font-size: 8px;"></i> Completada</span>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-2">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div>@TempData["SuccessMessage"]</div>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-2">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <div>@TempData["ErrorMessage"]</div>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg rounded-4 p-4 bg-white">
                <div id="agentCalendar"></div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                <h5 class="font-heading fw-bold text-dark mb-3"><i class="bi bi-clock-history text-info me-2"></i> Próximas Citas</h5>
                @if (Model == null || Model.Count == 0)
                {
                    <div class="text-center py-4 text-muted small">
                        <i class="bi bi-calendar-check d-block fs-3 mb-2"></i>
                        No tienes citas agendadas actualmente.
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-3" style="max-height: 480px; overflow-y: auto;">
                        @foreach (var appt in Model.Take(5))
                        {
                            <div class="p-3 bg-light rounded-3 border">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-bold font-heading text-dark small">Código @appt.PropertyCode</span>
                                    <span class="badge @appt.StatusBadgeClass extra-small px-2 py-1 rounded-pill">@appt.StatusFormatted</span>
                                </div>
                                <div class="small text-primary fw-bold mb-1">
                                    <i class="bi bi-calendar-event me-1"></i> @appt.AppointmentDate.ToString("dd/MM/yyyy - hh:mm tt")
                                </div>
                                <div class="extra-small text-muted mb-2"><i class="bi bi-person me-1"></i> Cliente: @appt.ClienteName</div>
                                
                                @if (appt.Status == "Pending")
                                {
                                    <form asp-action="ConfirmAppointment" asp-route-id="@appt.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-success w-100 py-1 font-heading small">
                                            <i class="bi bi-check-lg me-1"></i> Confirmar Cita
                                        </button>
                                    </form>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Modal Detalle de Cita del Calendario -->
<div class="modal fade" id="appointmentDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 shadow border-0">
            <div class="modal-header bg-dark text-white rounded-top-4">
                <h5 class="modal-title font-heading fw-bold">
                    <i class="bi bi-calendar-event text-info me-2"></i> Detalle de Cita de Visita
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <span id="modalBadge" class="badge px-3 py-2 rounded-pill fs-6"></span>
                </div>
                <div class="p-3 bg-light rounded-3 border mb-3">
                    <div class="small text-muted">Inmueble Solicitado</div>
                    <div id="modalProperty" class="fw-bold fs-6 text-dark mb-1"></div>
                    <div class="small text-muted">Cliente Ofertante</div>
                    <div id="modalClient" class="fw-bold text-primary mb-1"></div>
                    <div class="small text-muted">Comentarios del Cliente</div>
                    <div id="modalComments" class="small text-secondary fst-italic"></div>
                </div>

                <form id="confirmForm" asp-action="ConfirmAppointment" method="post" class="d-none">
                    <input type="hidden" name="id" id="modalApptId" />
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Notas o Instrucciones del Agente</label>
                        <input type="text" name="notes" class="form-control form-control-custom" placeholder="Ej: Nos vemos en la puerta principal de la torre." />
                    </div>
                    <button type="submit" class="btn btn-success w-100 py-2 rounded-pill font-heading fw-bold mb-2">
                        <i class="bi bi-check-circle-fill me-1"></i> Confirmar esta Cita
                    </button>
                </form>

                <div class="d-flex gap-2">
                    <form id="completeForm" asp-action="CompleteAppointment" method="post" class="flex-grow-1 d-none">
                        <input type="hidden" name="id" id="modalApptIdComplete" />
                        <button type="submit" class="btn btn-outline-success w-100 py-2 rounded-pill font-heading small">
                            <i class="bi bi-check-all me-1"></i> Marcar como Realizada
                        </button>
                    </form>
                    <form id="cancelForm" asp-action="CancelAppointment" method="post" class="flex-grow-1 d-none" onsubmit="return confirm('¿Cancelar esta cita?');">
                        <input type="hidden" name="id" id="modalApptIdCancel" />
                        <button type="submit" class="btn btn-outline-danger w-100 py-2 rounded-pill font-heading small">
                            <i class="bi bi-x-circle me-1"></i> Cancelar Cita
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var calendarEl = document.getElementById('agentCalendar');
            var calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth',
                locale: 'es',
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,listWeek'
                },
                buttonText: {
                    today: 'Hoy',
                    month: 'Mes',
                    week: 'Semana',
                    list: 'Agenda'
                },
                events: '/Appointments/GetAgentCalendarEvents',
                eventClick: function (info) {
                    var eventObj = info.event;
                    var props = eventObj.extendedProps;

                    $('#modalProperty').text(props.propertyCode + ' - ' + props.propertyName);
                    $('#modalClient').text(props.clientName);
                    $('#modalComments').text('"' + props.comments + '"');
                    $('#modalBadge').text(props.status).attr('class', 'badge px-3 py-2 rounded-pill fs-6 ' + props.badgeClass);

                    $('#modalApptId').val(eventObj.id);
                    $('#modalApptIdComplete').val(eventObj.id);
                    $('#modalApptIdCancel').val(eventObj.id);

                    if (props.status.includes('Pendiente')) {
                        $('#confirmForm').removeClass('d-none');
                        $('#completeForm').addClass('d-none');
                    } else if (props.status.includes('Confirmada')) {
                        $('#confirmForm').addClass('d-none');
                        $('#completeForm').removeClass('d-none');
                    } else {
                        $('#confirmForm').addClass('d-none');
                        $('#completeForm').addClass('d-none');
                    }

                    if (!props.status.includes('Cancelada') && !props.status.includes('Realizada')) {
                        $('#cancelForm').removeClass('d-none');
                    } else {
                        $('#cancelForm').addClass('d-none');
                    }

                    var modal = new bootstrap.Modal(document.getElementById('appointmentDetailModal'));
                    modal.show();
                }
            });
            calendar.render();
        });
    </script>
}
