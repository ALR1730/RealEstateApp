@model RealEstateApp.Core.Application.ViewModels.Property.SavePropertyViewModel
@{
    ViewData["Title"] = "Editar Mi Inmueble (Propietario)";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h3 class="font-heading fw-bold text-dark mb-1">
                        <i class="bi bi-pencil-square text-primary me-2"></i>Editar Inmueble
                    </h3>
                    <p class="text-muted small mb-0">
                        Actualiza la información de tu propiedad publicada.
                    </p>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Volver al Panel
                </a>
            </div>

            <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5">
                <form asp-action="EditProperty" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Name" class="form-label fw-bold text-dark small">Título Descriptivo</label>
                            <input asp-for="Name" class="form-control form-control-custom" required />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Price" class="form-label fw-bold text-dark small">Precio (RD$)</label>
                            <input asp-for="Price" type="number" step="0.01" class="form-control form-control-custom" required />
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="PropertyTypeId" class="form-label fw-bold text-dark small">Tipo de Inmueble</label>
                            <select asp-for="PropertyTypeId" class="form-select form-select-custom" required>
                                <option value="">-- Seleccionar Tipo --</option>
                                @if (Model.PropertyTypes != null)
                                {
                                    foreach (var type in Model.PropertyTypes)
                                    {
                                        <option value="@type.Id">@type.Name</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="PropertyTypeId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="SaleTypeId" class="form-label fw-bold text-dark small">Modalidad</label>
                            <select asp-for="SaleTypeId" class="form-select form-select-custom" required>
                                <option value="">-- Seleccionar Modalidad --</option>
                                @if (Model.SaleTypes != null)
                                {
                                    foreach (var sale in Model.SaleTypes)
                                    {
                                        <option value="@sale.Id">@sale.Name</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="SaleTypeId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Rooms" class="form-label fw-bold text-dark small">Habitaciones</label>
                            <input asp-for="Rooms" type="number" class="form-control form-control-custom" min="0" required />
                            <span asp-validation-for="Rooms" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Bathrooms" class="form-label fw-bold text-dark small">Baños</label>
                            <input asp-for="Bathrooms" type="number" class="form-control form-control-custom" min="0" required />
                            <span asp-validation-for="Bathrooms" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="SizeInMeters" class="form-label fw-bold text-dark small">Metros Cuadrados (m²)</label>
                            <input asp-for="SizeInMeters" type="number" step="0.01" class="form-control form-control-custom" min="1" required />
                            <span asp-validation-for="SizeInMeters" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ProvinceId" class="form-label fw-bold text-dark small">
                                <i class="bi bi-geo-alt-fill text-danger me-1"></i>Provincia (RD)
                            </label>
                            <select asp-for="ProvinceId" id="provinceSelect" class="form-select form-select-custom" required>
                                <option value="">-- Seleccione Provincia --</option>
                                @if (Model.Provinces != null)
                                {
                                    foreach (var prov in Model.Provinces)
                                    {
                                        <option value="@prov.Id">@prov.Name</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="ProvinceId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="MunicipalityId" class="form-label fw-bold text-dark small">
                                <i class="bi bi-pin-map text-primary me-1"></i>Municipio
                            </label>
                            <select asp-for="MunicipalityId" id="municipalitySelect" class="form-select form-select-custom" required>
                                <option value="">-- Seleccione Municipio --</option>
                                @if (Model.Municipalities != null)
                                {
                                    foreach (var mun in Model.Municipalities)
                                    {
                                        <option value="@mun.Id">@mun.Name</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="MunicipalityId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Sector" class="form-label fw-bold text-dark small">Sector / Barrio</label>
                            <input asp-for="Sector" class="form-control form-control-custom" />
                            <span asp-validation-for="Sector" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FullAddress" class="form-label fw-bold text-dark small">Dirección Completa</label>
                            <input asp-for="FullAddress" class="form-control form-control-custom" />
                            <span asp-validation-for="FullAddress" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-bold text-dark small">Descripción Detallada</label>
                            <textarea asp-for="Description" class="form-control form-control-custom" rows="4" required></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Files" class="form-label fw-bold text-dark small">
                                <i class="bi bi-images text-primary me-1"></i>Agregar más fotos (Opcional)
                            </label>
                            <input asp-for="Files" type="file" class="form-control form-control-custom" multiple accept="image/*" />
                            <span asp-validation-for="Files" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-grid gap-2 mt-4 pt-3 border-top">
                        <button type="submit" class="btn btn-primary-gradient py-3 font-heading fw-bold rounded-pill">
                            <i class="bi bi-check-lg me-1"></i> Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            $('#provinceSelect').on('change', async function () {
                const provinceId = $(this).val();
                const $municipalitySelect = $('#municipalitySelect');

                $municipalitySelect.html('<option value="">-- Seleccione Municipio --</option>');
                if (!provinceId) return;

                $municipalitySelect.html('<option value="">Cargando municipios...</option>');
                try {
                    const response = await fetch(`/Home/GetMunicipalities?provinceId=${provinceId}`);
                    const data = await response.json();
                    $municipalitySelect.html('<option value="">-- Seleccione Municipio --</option>');
                    data.forEach(function (m) {
                        $municipalitySelect.append(`<option value="${m.id}">${m.name}</option>`);
                    });
                } catch (err) {
                    console.error('Error al cargar municipios:', err);
                    $municipalitySelect.html('<option value="">Error al cargar</option>');
                }
            });
        });
    </script>
}
