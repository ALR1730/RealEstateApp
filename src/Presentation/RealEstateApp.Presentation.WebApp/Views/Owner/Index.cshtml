@model List<RealEstateApp.Core.Application.ViewModels.Property.PropertyViewModel>
@{
    ViewData["Title"] = "Panel de Propietario Directo";
    var maxAllowed = (int)(ViewBag.MaxOwnerProperties ?? 2);
    var canCreate = (bool)(ViewBag.CanCreate ?? true);
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h3 class="font-heading fw-bold text-dark mb-0">
                    <i class="bi bi-house-door-fill text-primary me-2"></i>Mis Inmuebles como Propietario Directo
                </h3>
                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-3 py-2 rounded-pill">
                    Venta Directa sin Comisión
                </span>
            </div>
            <p class="text-muted small mb-0">
                Gestiona tus publicaciones directas. Tienes habilitado un cupo de hasta <strong>@maxAllowed inmuebles simultáneos</strong> como propietario.
            </p>
        </div>

        @if (canCreate)
        {
            <a asp-action="CreateProperty" class="btn btn-primary-gradient rounded-pill px-4 py-2 fw-bold shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Publicar Mi Propiedad (@(Model.Count)/@maxAllowed)
            </a>
        }
        else
        {
            <button class="btn btn-secondary rounded-pill px-4 py-2 fw-bold shadow-sm" disabled title="Has alcanzado el límite de 2 propiedades">
                <i class="bi bi-slash-circle me-1"></i> Cupo Completo (@(Model.Count)/@maxAllowed)
            </button>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm p-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm p-3 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model == null || Model.Count == 0)
    {
        <div class="card border-0 shadow-sm rounded-4 text-center py-5 p-4">
            <i class="bi bi-house-add text-muted display-3 mb-3"></i>
            <h4 class="font-heading fw-bold text-dark mb-1">Aún no has publicado ningún inmueble</h4>
            <p class="text-muted small mb-4">
                Publica tu casa, apartamento o terreno directamente para que miles de compradores e inquilinos interesados te contacten.
            </p>
            <div>
                <a asp-action="CreateProperty" class="btn btn-primary-gradient rounded-pill px-4 py-3 fw-bold">
                    <i class="bi bi-plus-circle me-1"></i> Publicar Mi Primera Propiedad Ahora
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card border-0 shadow-lg rounded-4 overflow-hidden h-100">
                        <div class="position-relative" style="height: 220px; background-color: #f8f9fa;">
                            @if (item.Images != null && item.Images.Count > 0)
                            {
                                <img src="@item.Images[0]" class="w-100 h-100" style="object-fit: cover;" alt="@item.Name" />
                            }
                            else
                            {
                                <div class="w-100 h-100 d-flex align-items-center justify-content-center text-muted">
                                    <i class="bi bi-image fs-1"></i>
                                </div>
                            }

                            <span class="badge bg-dark bg-opacity-75 position-absolute top-0 start-0 m-3 px-3 py-2 rounded-pill font-monospace">
                                Cód: @item.Code
                            </span>

                            <span class="badge bg-primary position-absolute top-0 end-0 m-3 px-3 py-2 rounded-pill">
                                @item.Status
                            </span>

                            <div class="position-absolute bottom-0 start-0 end-0 p-3 bg-dark bg-opacity-50 text-white d-flex justify-content-between align-items-center">
                                <span class="fs-5 fw-bold font-heading">@item.Price.ToString("C0")</span>
                                <span class="small badge bg-light text-dark">@item.PropertyTypeName (@item.SaleTypeName)</span>
                            </div>
                        </div>

                        <div class="card-body p-4 d-flex flex-column justify-content-between">
                            <div>
                                <h5 class="font-heading fw-bold text-dark mb-2">@item.Name</h5>
                                @if (!string.IsNullOrEmpty(item.ProvinceName) || !string.IsNullOrEmpty(item.Sector))
                                {
                                    <p class="text-secondary small mb-3">
                                        <i class="bi bi-geo-alt-fill text-danger me-1"></i>
                                        @(string.Join(", ", new[] { item.Sector, item.MunicipalityName, item.ProvinceName }.Where(s => !string.IsNullOrWhiteSpace(s))))
                                    </p>
                                }
                                <div class="d-flex gap-3 small text-muted mb-3">
                                    <span><i class="bi bi-door-closed text-primary me-1"></i>@item.Rooms Habs.</span>
                                    <span><i class="bi bi-droplet text-info me-1"></i>@item.Bathrooms Baños</span>
                                    <span><i class="bi bi-arrows-fullscreen text-secondary me-1"></i>@item.SizeInMeters m²</span>
                                </div>
                            </div>

                            <div class="d-flex gap-2 pt-3 border-top">
                                <a asp-controller="Home" asp-action="Details" asp-route-id="@item.Id" target="_blank" class="btn btn-outline-secondary btn-sm rounded-pill flex-fill">
                                    <i class="bi bi-eye me-1"></i> Ver Pública
                                </a>
                                <a asp-action="EditProperty" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm rounded-pill flex-fill fw-bold">
                                    <i class="bi bi-pencil-square me-1"></i> Editar
                                </a>
                                <form asp-action="DeleteProperty" method="post" onsubmit="return confirm('¿Estás seguro de que deseas eliminar este inmueble?');" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3" title="Eliminar propiedad">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
