@model List<RealEstateApp.Core.Application.ViewModels.Offer.OfferViewModel>
@{
    ViewData["Title"] = "Ofertas Recibidas";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="font-heading fw-bold text-dark mb-1"><i class="bi bi-cash-stack text-success me-2"></i> Ofertas Recibidas</h2>
            <p class="text-muted small mb-0">Gestiona las propuestas económicas y realiza contra-ofertas a tus clientes.</p>
        </div>
        <span class="badge bg-primary rounded-pill fs-6 px-3 py-2">@Model.Count Ofertas</span>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-2">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div>@TempData["SuccessMessage"]</div>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-2">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <div>@TempData["ErrorMessage"]</div>
        </div>
    }

    @if (Model == null || Model.Count == 0)
    {
        <div class="text-center py-5 bg-white rounded-4 shadow-sm border">
            <i class="bi bi-inbox fs-1 text-muted d-block mb-3"></i>
            <h5 class="font-heading text-dark">No has recibido ofertas en tus inmuebles</h5>
            <p class="text-muted small">Las propuestas enviadas por compradores aparecerán reflejadas en este panel.</p>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-muted small text-uppercase font-heading">
                        <tr>
                            <th class="py-3 px-4">Inmueble</th>
                            <th class="py-3">Precio Lista</th>
                            <th class="py-3">Oferta Cliente</th>
                            <th class="py-3">Carta Bancaria</th>
                            <th class="py-3">Fecha</th>
                            <th class="py-3">Estado</th>
                            <th class="py-3 px-4 text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var offer in Model)
                        {
                            <tr>
                                <td class="py-3 px-4">
                                    <span class="fw-bold font-heading text-dark d-block">Código @offer.PropertyCode</span>
                                    <span class="small text-muted">Propiedad #@offer.PropertyId</span>
                                </td>
                                <td>@offer.PropertyPrice.ToString("C0")</td>
                                <td>
                                    <span class="fw-bold text-success fs-6 font-heading">@offer.MontoOfertado.ToString("C0")</span>
                                    @if (offer.CounterOfferAmount.HasValue)
                                    {
                                        <div class="small text-info mt-1">
                                            <i class="bi bi-arrow-return-right me-1"></i>Contra-oferta: <strong>@offer.CounterOfferAmount.Value.ToString("C0")</strong>
                                        </div>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(offer.PreApprovalLetterUrl))
                                    {
                                        <a href="@offer.PreApprovalLetterUrl" target="_blank" class="btn btn-sm btn-outline-info rounded-pill px-2 py-1 small">
                                            <i class="bi bi-file-earmark-pdf me-1"></i> Ver Carta
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Sin adjunto</span>
                                    }
                                </td>
                                <td class="small text-muted">@offer.FechaOferta.ToString("dd/MM/yyyy hh:mm tt")</td>
                                <td>
                                    @if (offer.Status == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill"><i class="bi bi-hourglass-split me-1"></i> Pendiente</span>
                                    }
                                    else if (offer.Status == "CounterOffered")
                                    {
                                        <span class="badge bg-info text-dark px-3 py-2 rounded-pill"><i class="bi bi-arrow-left-right me-1"></i> Contra-Ofertada</span>
                                    }
                                    else if (offer.Status == "Accepted")
                                    {
                                        <span class="badge bg-success px-3 py-2 rounded-pill"><i class="bi bi-check-circle-fill me-1"></i> Aceptada</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger px-3 py-2 rounded-pill"><i class="bi bi-x-circle-fill me-1"></i> Rechazada</span>
                                    }
                                </td>
                                <td class="py-3 px-4 text-end">
                                    @if (offer.Status == "Pending")
                                    {
                                        <div class="d-inline-flex gap-2">
                                            <form asp-action="AcceptOffer" asp-route-offerId="@offer.Id" method="post" onsubmit="return confirm('¿Aceptar esta oferta? La propiedad pasará automáticamente a VENDIDA y se rechazarán las demás ofertas pendientes.');">
                                                <button type="submit" class="btn btn-sm btn-success font-heading px-3" title="Aceptar oferta original">
                                                    <i class="bi bi-check-lg me-1"></i> Aceptar
                                                </button>
                                            </form>

                                            <!-- Botón Modal Contra-oferta -->
                                            <button type="button" class="btn btn-sm btn-info text-dark font-heading px-3" data-bs-toggle="modal" data-bs-target="#counterOfferModal_@offer.Id" title="Hacer contra-oferta">
                                                <i class="bi bi-arrow-left-right me-1"></i> Contra-Ofertar
                                            </button>

                                            <form asp-action="RejectOffer" asp-route-offerId="@offer.Id" method="post" onsubmit="return confirm('¿Rechazar esta oferta?');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger font-heading px-3" title="Rechazar propuesta">
                                                    <i class="bi bi-x-lg me-1"></i> Rechazar
                                                </button>
                                            </form>
                                        </div>

                                        <!-- Modal de Contra-Oferta -->
                                        <div class="modal fade text-start" id="counterOfferModal_@offer.Id" tabindex="-1" aria-labelledby="counterOfferLabel_@offer.Id" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content rounded-4 shadow border-0">
                                                    <div class="modal-header bg-dark text-white rounded-top-4">
                                                        <h5 class="modal-title font-heading fw-bold" id="counterOfferLabel_@offer.Id">
                                                            <i class="bi bi-arrow-left-right text-info me-2"></i> Realizar Contra-Oferta (Cód: @offer.PropertyCode)
                                                        </h5>
                                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <form asp-action="CounterOffer" method="post">
                                                        <div class="modal-body p-4">
                                                            <input type="hidden" name="OfferId" value="@offer.Id" />
                                                            
                                                            <div class="mb-3 p-3 bg-light rounded-3 border">
                                                                <div class="small text-muted">Oferta Actual del Cliente</div>
                                                                <div class="fs-5 fw-bold text-success">@offer.MontoOfertado.ToString("C0")</div>
                                                                <div class="small text-muted mt-1">Precio de Lista de la Propiedad: @offer.PropertyPrice.ToString("C0")</div>
                                                            </div>

                                                            <div class="mb-3">
                                                                <label class="form-label fw-bold small text-muted">Monto de la Contra-Oferta (RD$)</label>
                                                                <input type="number" step="0.01" min="1" name="CounterOfferAmount" class="form-control form-control-custom" required value="@offer.PropertyPrice" placeholder="Monto sugerido por el agente" />
                                                            </div>

                                                            <div class="mb-3">
                                                                <label class="form-label fw-bold small text-muted">Mensaje o Nota para el Cliente (Opcional)</label>
                                                                <textarea name="CounterOfferMessage" class="form-control form-control-custom" rows="3" placeholder="Ej: Mi último precio de negociación es de RD$ ... por incluir las mejoras."></textarea>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer bg-light rounded-bottom-4">
                                                            <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancelar</button>
                                                            <button type="submit" class="btn btn-info rounded-pill px-4 fw-bold">
                                                                <i class="bi bi-send-fill me-1"></i> Enviar Contra-Oferta
                                                            </button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else if (offer.Status == "CounterOffered")
                                    {
                                        <div class="small text-muted text-center">
                                            <i class="bi bi-clock-history text-info me-1"></i> Esperando respuesta del cliente
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Procesada</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
