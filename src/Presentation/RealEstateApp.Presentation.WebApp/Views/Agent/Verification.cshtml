@model RealEstateApp.Core.Application.ViewModels.Agent.AgentVerificationViewModel
@{
    ViewData["Title"] = "Verificación de Identidad de Agente";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Encabezado -->
            <div class="d-flex align-items-center justify-content-between mb-4">
                <div>
                    <h3 class="font-heading fw-bold text-dark mb-1">
                        <i class="bi bi-patch-check-fill text-primary me-2"></i>Verificación de Identidad
                    </h3>
                    <p class="text-muted small mb-0">
                        Obtén la insignia de <strong>Agente Verificado</strong> en tus propiedades publicadas para generar máxima confianza con los compradores.
                    </p>
                </div>
                <a asp-action="Properties" class="btn btn-outline-secondary rounded-pill btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Volver a Mis Propiedades
                </a>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm p-3 mb-4" role="alert">
                    <i class="bi bi-check-circle-fill me-2 fs-5"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm p-3 mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- Estado Actual de la Verificación -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small d-block">Estado de la cuenta:</span>
                        <h5 class="font-heading fw-bold mb-0">
                            @if (Model.IsVerified)
                            {
                                <span class="text-success"><i class="bi bi-patch-check-fill me-1"></i> Identidad Verificada</span>
                            }
                            else if (Model.IsPending && !string.IsNullOrEmpty(Model.Cedula))
                            {
                                <span class="text-warning"><i class="bi bi-hourglass-split me-1"></i> Solicitud en Revisión por el Administrador</span>
                            }
                            else if (Model.IsRejected)
                            {
                                <span class="text-danger"><i class="bi bi-x-circle-fill me-1"></i> Solicitud Rechazada</span>
                            }
                            else
                            {
                                <span class="text-secondary"><i class="bi bi-shield-x me-1"></i> No Verificado</span>
                            }
                        </h5>
                    </div>

                    @if (Model.IsVerified)
                    {
                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2 rounded-pill fs-6">
                            <i class="bi bi-check-all me-1"></i> Agente Oficial
                        </span>
                    }
                </div>

                @if (Model.IsRejected && !string.IsNullOrEmpty(Model.RejectionReason))
                {
                    <div class="alert alert-danger bg-danger bg-opacity-10 border-danger border-opacity-25 rounded-3 p-3 mt-3 mb-0">
                        <strong><i class="bi bi-info-circle me-1"></i> Motivo del rechazo:</strong>
                        <p class="small mb-0 mt-1">@Model.RejectionReason</p>
                        <span class="small text-muted d-block mt-2">Por favor vuelva a cargar fotos legibles y verifique su número de cédula.</span>
                    </div>
                }
            </div>

            <!-- Formulario de Envío / Actualización de Documentos -->
            @if (!Model.IsVerified)
            {
                <div class="card border-0 shadow-sm rounded-4 p-4">
                    <h5 class="font-heading fw-bold text-dark mb-3">
                        <i class="bi bi-card-heading text-primary me-2"></i>Formulario de Verificación de Cédula
                    </h5>
                    <p class="text-muted small mb-4">
                        Ingrese el número de su Cédula de Identidad y Electoral dominicana y adjunte fotografías nítidas del anverso (frente) y reverso (dorso).
                    </p>

                    <form asp-action="Verification" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Cedula" class="form-label fw-bold text-dark small"></label>
                            <input asp-for="Cedula" class="form-control form-control-custom" placeholder="Ej: 001-1234567-8 o 40212345678" required />
                            <span asp-validation-for="Cedula" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="FrontImageFile" class="form-label fw-bold text-dark small"></label>
                                <input asp-for="FrontImageFile" type="file" class="form-control form-control-custom" accept="image/*" />
                                <span asp-validation-for="FrontImageFile" class="text-danger small"></span>
                                @if (!string.IsNullOrEmpty(Model.FrontImageUrl))
                                {
                                    <div class="mt-2 position-relative rounded-3 overflow-hidden border" style="height: 140px;">
                                        <img src="@Model.FrontImageUrl" class="w-100 h-100" style="object-fit: cover;" alt="Frente de Cédula Actual" />
                                    </div>
                                    <span class="text-muted small d-block mt-1">Foto frontal actual cargada</span>
                                }
                            </div>

                            <div class="col-md-6">
                                <label asp-for="BackImageFile" class="form-label fw-bold text-dark small"></label>
                                <input asp-for="BackImageFile" type="file" class="form-control form-control-custom" accept="image/*" />
                                <span asp-validation-for="BackImageFile" class="text-danger small"></span>
                                @if (!string.IsNullOrEmpty(Model.BackImageUrl))
                                {
                                    <div class="mt-2 position-relative rounded-3 overflow-hidden border" style="height: 140px;">
                                        <img src="@Model.BackImageUrl" class="w-100 h-100" style="object-fit: cover;" alt="Reverso de Cédula Actual" />
                                    </div>
                                    <span class="text-muted small d-block mt-1">Foto posterior actual cargada</span>
                                }
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary-gradient py-3 font-heading fw-bold rounded-pill">
                                <i class="bi bi-cloud-arrow-up-fill me-2"></i> Enviar Solicitud de Verificación
                            </button>
                        </div>
                    </form>
                </div>
            }
            else
            {
                <div class="card bg-success bg-opacity-10 border border-success border-opacity-25 rounded-4 p-4 text-center">
                    <i class="bi bi-shield-check text-success fs-1 mb-2"></i>
                    <h5 class="font-heading fw-bold text-success">¡Tu cuenta se encuentra totalmente verificada!</h5>
                    <p class="text-muted small mb-0">
                        Cédula registrada: <strong>@Model.Cedula</strong> | Revisada el @Model.ReviewedAt?.ToString("dd/MM/yyyy") por el equipo administrativo.
                    </p>
                </div>
            }
        </div>
    </div>
</div>
