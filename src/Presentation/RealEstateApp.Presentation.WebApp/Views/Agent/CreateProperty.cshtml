@model RealEstateApp.Core.Application.ViewModels.Property.SavePropertyViewModel
@{
    ViewData["Title"] = "Publicar Propiedad";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-dark text-white p-4 text-center border-0" style="background: var(--bg-gradient-hero) !important;">
                    <div class="d-inline-flex p-3 rounded-circle bg-white bg-opacity-10 mb-3">
                        <i class="bi bi-house-add-fill fs-1 text-info"></i>
                    </div>
                    <h3 class="font-heading text-white fw-bold mb-1">Publicar Nuevo Inmueble</h3>
                    <p class="small text-white-50 mb-0">El código de 6 dígitos se generará automáticamente</p>
                </div>

                <div class="card-body p-4 p-md-5">
                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                    {
                        <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4">
                            @Html.ValidationSummary(true, "", new { @class = "mb-0" })
                        </div>
                    }

                    <form asp-action="CreateProperty" method="post" enctype="multipart/form-data">
                        <div class="row g-3 mb-4">
                            <div class="col-12">
                                <label asp-for="Name" class="form-label fw-bold text-dark small"></label>
                                <input asp-for="Name" class="form-control form-control-custom" placeholder="Nombre o título del inmueble (ej. Apartamento Moderno con Balcón)" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="PropertyTypeId" class="form-label fw-bold text-dark small"></label>
                                <select asp-for="PropertyTypeId" class="form-select form-select-custom">
                                    <option value="">-- Seleccione Tipo de Propiedad --</option>
                                    @if (Model.PropertyTypes != null)
                                    {
                                        foreach (var type in Model.PropertyTypes)
                                        {
                                            <option value="@type.Id">@type.Name</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="PropertyTypeId" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="SaleTypeId" class="form-label fw-bold text-dark small"></label>
                                <select asp-for="SaleTypeId" class="form-select form-select-custom">
                                    <option value="">-- Seleccione Tipo de Venta --</option>
                                    @if (Model.SaleTypes != null)
                                    {
                                        foreach (var type in Model.SaleTypes)
                                        {
                                            <option value="@type.Id">@type.Name</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="SaleTypeId" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Price" class="form-label fw-bold text-dark small"></label>
                                <input asp-for="Price" class="form-control form-control-custom" placeholder="Precio" step="1000" />
                                <span asp-validation-for="Price" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="MontoSeparacion" class="form-label fw-bold text-dark small"></label>
                                <input asp-for="MontoSeparacion" class="form-control form-control-custom" placeholder="Monto de separación" step="500" />
                                <span asp-validation-for="MontoSeparacion" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="PorcentajeInicialRequerido" class="form-label fw-bold text-dark small"></label>
                                <input asp-for="PorcentajeInicialRequerido" class="form-control form-control-custom" placeholder="Porcentaje inicial" min="1" max="100" />
                                <span asp-validation-for="PorcentajeInicialRequerido" class="text-danger small"></span>
                            </div>

                            <!-- Interruptor de Pre-Investigación de Financiamiento -->
                            <div class="col-12 my-2">
                                <div class="card bg-info bg-opacity-10 border border-info border-opacity-25 rounded-4 p-3">
                                    <div class="form-check form-switch m-0">
                                        <input asp-for="IsFinanciable" class="form-check-input" type="checkbox" id="isFinanciableSwitch">
                                        <label class="form-check-label fw-bold text-dark font-heading ms-2" for="isFinanciableSwitch">
                                            <i class="bi bi-patch-check-fill text-info me-1"></i> Pre-investigación para Financiamiento Aprobada
                                        </label>
                                    </div>
                                    <span class="text-muted small d-block ms-4 ps-2 mt-1">
                                        Al activar esta opción, el inmueble exhibirá la insignia de <strong>"Financiable"</strong> en lugar de "Disponible".
                                    </span>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Rooms" class="form-label fw-bold text-dark small"></label>
                                <input asp-for="Rooms" class="form-control form-control-custom" placeholder="Habitaciones" min="0" />
                                <span asp-validation-for="Rooms" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Bathrooms" class="form-label fw-bold text-dark small"></label>
                                <input asp-for="Bathrooms" class="form-control form-control-custom" placeholder="Baños" min="0" />
                                <span asp-validation-for="Bathrooms" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="SizeInMeters" class="form-label fw-bold text-dark small"></label>
                                <input asp-for="SizeInMeters" class="form-control form-control-custom" placeholder="Metros cuadrados" min="1" />
                                <span asp-validation-for="SizeInMeters" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Description" class="form-label fw-bold text-dark small"></label>
                                <textarea asp-for="Description" class="form-control form-control-custom" rows="4" placeholder="Descripción de la propiedad"></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>

                            <!-- Selección de Ubicación por Mapa Interactivo -->
                            <div class="col-12 my-3">
                                <div class="card bg-light border-0 shadow-sm rounded-4 p-3">
                                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
                                        <div>
                                            <h6 class="font-heading fw-bold text-dark mb-0">
                                                <i class="bi bi-geo-alt-fill text-danger me-2"></i>Ubicación Geográfica en el Mapa
                                            </h6>
                                            <span class="text-muted small">Busque una dirección o arrastre el marcador sobre la posición exacta del inmueble.</span>
                                        </div>
                                        <button type="button" id="useCurrentLocationBtn" class="btn btn-sm btn-outline-primary rounded-pill font-heading">
                                            <i class="bi bi-crosshair me-1"></i> Usar mi ubicación actual
                                        </button>
                                    </div>

                                    <!-- Buscador de Lugares/Direcciones -->
                                    <div class="input-group mb-3">
                                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                                        <input type="text" id="mapSearchInput" class="form-control border-start-0 ps-0" placeholder="Buscar dirección o ciudad..." />
                                        <button type="button" id="mapSearchBtn" class="btn btn-primary font-heading px-4">
                                            Buscar Dirección
                                        </button>
                                    </div>

                                    <!-- Contenedor del Mapa -->
                                    <div id="propertyMap" class="rounded-3 border shadow-inner mb-3 position-relative overflow-hidden" style="height: 360px; z-index: 1;"></div>

                                    <!-- Campos de Coordenadas Sincronizados -->
                                    <div class="row g-2">
                                        <div class="col-md-6">
                                            <label asp-for="Latitude" class="form-label fw-bold text-dark small"></label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-white border-end-0"><i class="bi bi-compass text-secondary"></i></span>
                                                <input asp-for="Latitude" id="Latitude" class="form-control border-start-0 ps-0" placeholder="Latitud" step="any" readonly />
                                            </div>
                                            <span asp-validation-for="Latitude" class="text-danger small"></span>
                                        </div>

                                        <div class="col-md-6">
                                            <label asp-for="Longitude" class="form-label fw-bold text-dark small"></label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-white border-end-0"><i class="bi bi-compass-fill text-secondary"></i></span>
                                                <input asp-for="Longitude" id="Longitude" class="form-control border-start-0 ps-0" placeholder="Longitud" step="any" readonly />
                                            </div>
                                            <span asp-validation-for="Longitude" class="text-danger small"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="VideoUrl" class="form-label fw-bold text-dark small"></label>
                                <input asp-for="VideoUrl" class="form-control form-control-custom" placeholder="URL de Video" />
                                <span asp-validation-for="VideoUrl" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Tour360Url" class="form-label fw-bold text-dark small"></label>
                                <input asp-for="Tour360Url" class="form-control form-control-custom" placeholder="URL de Tour 360" />
                                <span asp-validation-for="Tour360Url" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Files" class="form-label fw-bold text-dark small"></label>
                                <input asp-for="Files" type="file" multiple class="form-control form-control-custom" accept="image/*" />
                                <div class="form-text small">Puede seleccionar hasta 15 imágenes en formato JPG, PNG, WEBP.</div>
                            </div>
                        </div>

                        <!-- Checkboxes de Mejoras -->
                        @if (Model.Improvements != null && Model.Improvements.Count > 0)
                        {
                            <div class="mb-4">
                                <label class="form-label fw-bold text-dark small d-block mb-2">Mejoras e Instalaciones:</label>
                                <div class="row g-2">
                                    @foreach (var imp in Model.Improvements)
                                    {
                                        <div class="col-md-4 col-6">
                                            <div class="form-check p-2 border rounded-3 bg-light">
                                                <input class="form-check-input ms-1 me-2" type="checkbox" name="ImprovementIds" value="@imp.Id" id="imp_@imp.Id">
                                                <label class="form-check-label small fw-medium text-dark" for="imp_@imp.Id">@imp.Name</label>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary-gradient flex-grow-1 py-3 font-heading fw-bold">
                                <i class="bi bi-check-circle-fill me-2"></i> Guardar y Publicar
                            </button>
                            <a asp-action="Properties" class="btn btn-outline-custom py-3 px-4">
                                Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var initialLat = parseFloat($("#Latitude").val()) || 18.4861;
            var initialLng = parseFloat($("#Longitude").val()) || -69.9312;

            var map = L.map('propertyMap').setView([initialLat, initialLng], 13);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);

            var customIcon = L.icon({
                iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-red.png',
                shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png',
                iconSize: [25, 41],
                iconAnchor: [12, 41],
                popupAnchor: [1, -34],
                shadowSize: [41, 41]
            });

            var marker = L.marker([initialLat, initialLng], {
                draggable: true,
                icon: customIcon
            }).addTo(map);

            marker.bindPopup("<b>Ubicación del Inmueble</b><br>Arrastre este marcador o haga clic en el mapa").openPopup();

            function updatePosition(lat, lng) {
                var cleanLat = parseFloat(lat).toFixed(6);
                var cleanLng = parseFloat(lng).toFixed(6);
                $("#Latitude").val(cleanLat);
                $("#Longitude").val(cleanLng);
            }

            marker.on('dragend', function (e) {
                var position = marker.getLatLng();
                updatePosition(position.lat, position.lng);
            });

            map.on('click', function (e) {
                marker.setLatLng(e.latlng);
                updatePosition(e.latlng.lat, e.latlng.lng);
            });

            updatePosition(initialLat, initialLng);

            $("#useCurrentLocationBtn").click(function () {
                if (navigator.geolocation) {
                    var btn = $(this);
                    btn.html('<span class="spinner-border spinner-border-sm me-1"></span> Buscando GPS...');
                    btn.prop("disabled", true);

                    navigator.geolocation.getCurrentPosition(function (position) {
                        var userLat = position.coords.latitude;
                        var userLng = position.coords.longitude;
                        map.setView([userLat, userLng], 16);
                        marker.setLatLng([userLat, userLng]);
                        updatePosition(userLat, userLng);
                        btn.html('<i class="bi bi-crosshair me-1"></i> Ubicación detectada');
                        btn.prop("disabled", false);
                    }, function (error) {
                        alert("No se pudo obtener la ubicación GPS del navegador. Seleccione la posición en el mapa.");
                        btn.html('<i class="bi bi-crosshair me-1"></i> Usar mi ubicación actual');
                        btn.prop("disabled", false);
                    });
                } else {
                    alert("Su navegador no soporta geolocalización GPS.");
                }
            });

            function performSearch() {
                var query = $("#mapSearchInput").val().trim();
                if (!query) return;

                var btn = $("#mapSearchBtn");
                btn.html('<span class="spinner-border spinner-border-sm me-1"></span> Buscando...');
                btn.prop("disabled", true);

                $.getJSON('https://nominatim.openstreetmap.org/search?format=json&q=' + encodeURIComponent(query), function (data) {
                    btn.html('Buscar Dirección');
                    btn.prop("disabled", false);

                    if (data && data.length > 0) {
                        var firstResult = data[0];
                        var searchLat = parseFloat(firstResult.lat);
                        var searchLng = parseFloat(firstResult.lon);
                        map.setView([searchLat, searchLng], 15);
                        marker.setLatLng([searchLat, searchLng]);
                        updatePosition(searchLat, searchLng);
                    } else {
                        alert("No se encontraron resultados para: '" + query + "'. Intente con una referencia de dirección más amplia.");
                    }
                }).fail(function () {
                    btn.html('Buscar Dirección');
                    btn.prop("disabled", false);
                    alert("Error al buscar la dirección.");
                });
            }

            $("#mapSearchBtn").click(performSearch);

            $("#mapSearchInput").keypress(function (e) {
                if (e.which == 13) {
                    e.preventDefault();
                    performSearch();
                }
            });
        });
    </script>
}
