@model List<RealEstateApp.Core.Application.ViewModels.Property.PropertyViewModel>
@{
    ViewData["Title"] = "Mis Propiedades Asignadas";
}

<div class="container py-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="font-heading fw-bold text-dark mb-1"><i class="bi bi-building-fill text-primary me-2"></i> Mis Inmuebles Publicados</h2>
            <p class="text-muted small mb-0">Gestiona tus propiedades, actualiza precios, añade fotos y revisa su estado.</p>
        </div>
        <a asp-action="CreateProperty" class="btn btn-primary-gradient px-4 py-2 font-heading fw-bold rounded-pill">
            <i class="bi bi-plus-lg me-1"></i> Publicar Nueva Propiedad
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-2">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div>@TempData["SuccessMessage"]</div>
        </div>
    }

    @if (Model == null || Model.Count == 0)
    {
        <div class="text-center py-5 bg-white rounded-4 shadow-sm border">
            <i class="bi bi-house-add fs-1 text-muted d-block mb-3"></i>
            <h5 class="font-heading text-dark">No tienes propiedades asignadas</h5>
            <p class="text-muted small">Comienza publicando tu primera propiedad inmobiliaria en la plataforma.</p>
            <a asp-action="CreateProperty" class="btn btn-primary-gradient rounded-pill px-4 mt-2">
                Publicar Inmueble
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card-property">
                        <div class="img-container">
                            <span class="code-badge">@item.Code</span>
                            
                            @{
                                var statusClass = item.Status == "Disponible" ? "badge-disponible" :
                                                  item.Status == "Reservada" ? "badge-reservada" : "badge-vendida";
                            }
                            <span class="status-badge @statusClass">@item.Status</span>

                            @if (item.Images != null && item.Images.Count > 0)
                            {
                                <img src="@item.Images[0]" alt="@item.Code" />
                            }
                            else
                            {
                                <img src="https://images.unsplash.com/photo-1560518883-ce09059eeffa?auto=format&fit=crop&w=800&q=80" alt="Placeholder" />
                            }

                            <div class="price-tag">
                                @item.Price.ToString("C0")
                            </div>
                        </div>

                        <div class="card-body p-4 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="badge bg-light text-primary border">@item.PropertyTypeName</span>
                                    <span class="badge bg-light text-dark border">@item.SaleTypeName</span>
                                </div>
                                <p class="text-muted small mb-3 text-truncate-2">@item.Description</p>
                            </div>

                            <div>
                                <hr class="my-3 opacity-25">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="metric-pill"><i class="bi bi-door-open-fill"></i> @item.Rooms Habs</span>
                                    <span class="metric-pill"><i class="bi bi-droplet-fill"></i> @item.Bathrooms Baños</span>
                                    <span class="metric-pill"><i class="bi bi-aspect-ratio-fill"></i> @item.SizeInMeters m²</span>
                                </div>

                                <div class="d-flex gap-2">
                                    <a asp-action="EditProperty" asp-route-id="@item.Id" class="btn btn-outline-primary flex-grow-1 py-2 font-heading">
                                        <i class="bi bi-pencil-square me-1"></i> Editar
                                    </a>
                                    <form asp-action="DeleteProperty" asp-route-id="@item.Id" method="post" onsubmit="return confirm('¿Está seguro de eliminar esta propiedad?');">
                                        <button type="submit" class="btn btn-outline-danger py-2">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
