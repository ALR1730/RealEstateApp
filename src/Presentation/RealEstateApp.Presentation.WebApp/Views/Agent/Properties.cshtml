@model RealEstateApp.Core.Application.ViewModels.Agent.AgentPropertyFilterViewModel
@{
    ViewData["Title"] = "Mis Propiedades Asignadas";
}

<div class="container py-4">
    <!-- Header Principal -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="font-heading fw-bold text-dark mb-1">
                <i class="bi bi-building-fill text-primary me-2"></i>Mis Inmuebles Publicados
            </h2>
            <p class="text-muted small mb-0">
                Gestiona tu inventario, filtra rápidamente por estado, tipo o código y edita tus publicaciones.
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Subscriptions" class="btn btn-outline-secondary px-3 py-2 font-heading fw-bold rounded-pill btn-sm d-flex align-items-center">
                <i class="bi bi-gem text-warning me-1"></i> Mi Plan de Agente
            </a>
            <a asp-action="CreateProperty" class="btn btn-primary-gradient px-4 py-2 font-heading fw-bold rounded-pill shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Publicar Inmueble
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-4 mb-4 p-3" role="alert">
            <i class="bi bi-check-circle-fill fs-5 me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-4 mb-4 p-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Barra de Métricas y KPIs de Inventario -->
    <div class="row row-cols-2 row-cols-md-5 g-3 mb-4">
        <div class="col">
            <a asp-action="Properties" class="card border-0 shadow-sm rounded-4 p-3 text-decoration-none text-dark h-100 bg-white hover-shadow transition">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small d-block">Total Inmuebles</span>
                        <h4 class="font-heading fw-bold mb-0">@Model.TotalPropertiesCount</h4>
                    </div>
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-2 fs-5">
                        <i class="bi bi-buildings"></i>
                    </div>
                </div>
            </a>
        </div>
        <div class="col">
            <a asp-action="Properties" asp-route-Status="Disponible" class="card border-0 shadow-sm rounded-4 p-3 text-decoration-none text-dark h-100 bg-white hover-shadow transition">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small d-block">Disponibles</span>
                        <h4 class="font-heading fw-bold text-success mb-0">@Model.AvailableCount</h4>
                    </div>
                    <div class="rounded-circle bg-success bg-opacity-10 text-success p-2 fs-5">
                        <i class="bi bi-check2-circle"></i>
                    </div>
                </div>
            </a>
        </div>
        <div class="col">
            <a asp-action="Properties" asp-route-Status="Reservada" class="card border-0 shadow-sm rounded-4 p-3 text-decoration-none text-dark h-100 bg-white hover-shadow transition">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small d-block">Reservadas</span>
                        <h4 class="font-heading fw-bold text-warning mb-0">@Model.ReservedCount</h4>
                    </div>
                    <div class="rounded-circle bg-warning bg-opacity-10 text-warning p-2 fs-5">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                </div>
            </a>
        </div>
        <div class="col">
            <a asp-action="Properties" asp-route-Status="Vendida" class="card border-0 shadow-sm rounded-4 p-3 text-decoration-none text-dark h-100 bg-white hover-shadow transition">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small d-block">Vendidas</span>
                        <h4 class="font-heading fw-bold text-danger mb-0">@Model.SoldCount</h4>
                    </div>
                    <div class="rounded-circle bg-danger bg-opacity-10 text-danger p-2 fs-5">
                        <i class="bi bi-bag-check"></i>
                    </div>
                </div>
            </a>
        </div>
        <div class="col">
            <a asp-action="Properties" asp-route-OnlyFeatured="true" class="card border-0 shadow-sm rounded-4 p-3 text-decoration-none text-dark h-100 bg-white hover-shadow transition">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small d-block">Destacadas</span>
                        <h4 class="font-heading fw-bold text-primary mb-0">
                            @Model.FeaturedCount <span class="fs-6 text-muted fw-normal">/ @Model.MaxFeaturedAllowed</span> ⭐
                        </h4>
                    </div>
                    <div class="rounded-circle bg-warning bg-opacity-25 text-warning p-2 fs-5">
                        <i class="bi bi-star-fill text-warning"></i>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- Panel de Filtros y Búsqueda -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-light">
        <form asp-action="Properties" method="get">
            <div class="row g-3 align-items-end">
                <!-- Buscador de texto -->
                <div class="col-md-4">
                    <label class="form-label fw-bold text-dark small">
                        <i class="bi bi-search me-1 text-primary"></i> Buscar por Título, Código o Sector
                    </label>
                    <input type="text" name="SearchTerm" value="@Model.SearchTerm" class="form-control form-control-custom" placeholder="Ej: Bella Vista, COD-1234, Casa..." />
                </div>

                <!-- Filtro de Estado -->
                <div class="col-md-2">
                    <label class="form-label fw-bold text-dark small">Estado</label>
                    <select name="Status" class="form-select form-select-custom">
                        <option value="" selected="@(string.IsNullOrEmpty(Model.Status))">-- Todos --</option>
                        <option value="Disponible" selected="@(Model.Status == "Disponible")">Disponible</option>
                        <option value="Reservada" selected="@(Model.Status == "Reservada")">Reservada</option>
                        <option value="Vendida" selected="@(Model.Status == "Vendida")">Vendida</option>
                    </select>
                </div>

                <!-- Filtro de Tipo de Propiedad -->
                <div class="col-md-2">
                    <label class="form-label fw-bold text-dark small">Tipo de Inmueble</label>
                    <select name="PropertyTypeId" class="form-select form-select-custom">
                        <option value="" selected="@(!Model.PropertyTypeId.HasValue)">-- Todos --</option>
                        @foreach (var type in Model.PropertyTypes)
                        {
                            <option value="@type.Id" selected="@(Model.PropertyTypeId == type.Id)">@type.Name</option>
                        }
                    </select>
                </div>

                <!-- Filtro de Modalidad -->
                <div class="col-md-2">
                    <label class="form-label fw-bold text-dark small">Operación</label>
                    <select name="SaleTypeId" class="form-select form-select-custom">
                        <option value="" selected="@(!Model.SaleTypeId.HasValue)">-- Todas --</option>
                        @foreach (var sale in Model.SaleTypes)
                        {
                            <option value="@sale.Id" selected="@(Model.SaleTypeId == sale.Id)">@sale.Name</option>
                        }
                    </select>
                </div>

                <!-- Botones de Acción -->
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary-gradient w-100 py-2 rounded-pill fw-bold">
                        <i class="bi bi-filter me-1"></i> Filtrar
                    </button>
                    <a asp-action="Properties" class="btn btn-outline-secondary rounded-pill px-3 py-2" title="Limpiar Filtros">
                        <i class="bi bi-x-lg"></i>
                    </a>
                </div>

                <!-- Checkbox Solo Destacadas -->
                <div class="col-12 pt-2">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="OnlyFeatured" value="true" id="onlyFeaturedAgent" @(Model.OnlyFeatured ? "checked" : "")>
                        <label class="form-check-label small fw-bold text-dark" for="onlyFeaturedAgent">
                            ⭐ Ver solo mis propiedades destacadas
                        </label>
                    </div>
                </div>
            </div>
        </form>
    </div>

    <!-- Resultados -->
    @if (Model.Properties == null || Model.Properties.Count == 0)
    {
        <div class="text-center py-5 bg-white rounded-4 shadow-sm border p-4">
            <i class="bi bi-search fs-1 text-muted d-block mb-3"></i>
            <h5 class="font-heading text-dark fw-bold">No se encontraron propiedades</h5>
            <p class="text-muted small mb-3">
                No hay resultados que coincidan con los criterios de búsqueda seleccionados.
            </p>
            <a asp-action="Properties" class="btn btn-outline-primary rounded-pill px-4">
                <i class="bi bi-arrow-counterclockwise me-1"></i> Limpiar Filtros
            </a>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="text-muted small">Mostrando <strong>@Model.Properties.Count</strong> inmueble(s)</span>
        </div>

        <div class="row g-4">
            @foreach (var item in Model.Properties)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card-property position-relative" data-href="@Url.Action("Details", "Home", new { id = item.Id })">
                        <div class="img-container">
                            @if (item.IsCurrentlyFeatured)
                            {
                                <span class="badge bg-warning text-dark position-absolute top-0 start-0 m-3 fw-bold shadow-sm" style="z-index: 5; font-size: 0.78rem; border-radius: 8px;">
                                    <i class="bi bi-star-fill me-1 text-dark"></i> DESTACADA
                                </span>
                            }
                            else
                            {
                                <span class="code-badge">Código: @item.Code</span>
                            }
                            
                            @{
                                var displayStatus = (item.Status == "Disponible" && item.IsFinanciable) ? "Financiable" : item.Status;
                                var statusClass = displayStatus == "Financiable" ? "badge-financiable" :
                                                  item.Status == "Disponible" ? "badge-disponible" :
                                                  item.Status == "Reservada" ? "badge-reservada" : "badge-vendida";
                            }
                            <span class="status-badge @statusClass">@displayStatus</span>

                            @if (item.Images != null && item.Images.Count > 0)
                            {
                                <img src="@item.Images[0]" alt="@item.Name" />
                            }
                            else
                            {
                                <img src="https://images.unsplash.com/photo-1560518883-ce09059eeffa?auto=format&fit=crop&w=800&q=80" alt="Placeholder" />
                            }

                            <div class="price-tag">
                                @item.Price.ToString("C0")
                            </div>
                        </div>

                        <div class="card-body p-4 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex flex-wrap align-items-center gap-1 mb-2">
                                    <span class="badge bg-light text-primary border">@item.PropertyTypeName</span>
                                    <span class="badge bg-light text-dark border">@item.SaleTypeName</span>
                                    @if (item.IsCurrentlyFeatured)
                                    {
                                        <span class="badge bg-light text-muted border">Cód: @item.Code</span>
                                    }
                                </div>
                                <h5 class="font-heading fw-bold text-dark mb-1 text-truncate" title="@item.Name">@item.Name</h5>
                                @if (!string.IsNullOrEmpty(item.ProvinceName) || !string.IsNullOrEmpty(item.Sector))
                                {
                                    <p class="text-secondary small mb-2 text-truncate">
                                        <i class="bi bi-geo-alt-fill text-danger me-1"></i>
                                        @(string.Join(", ", new[] { item.Sector, item.MunicipalityName, item.ProvinceName }.Where(s => !string.IsNullOrWhiteSpace(s))))
                                    </p>
                                }
                                <p class="text-muted small mb-3 text-truncate-2">@item.Description</p>
                            </div>

                            <div>
                                <hr class="my-3 opacity-25">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="metric-pill"><i class="bi bi-door-open-fill"></i> @item.Rooms Habs</span>
                                    <span class="metric-pill"><i class="bi bi-droplet-fill"></i> @item.Bathrooms Baños</span>
                                    <span class="metric-pill"><i class="bi bi-aspect-ratio-fill"></i> @item.SizeInMeters m²</span>
                                </div>

                                <div class="d-flex flex-wrap gap-2">
                                    <form asp-action="ToggleFeatured" asp-route-id="@item.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        @if (item.IsCurrentlyFeatured)
                                        {
                                            <button type="submit" class="btn btn-warning text-dark py-2 font-heading rounded-pill px-3 fw-bold small" title="Quitar de la lista de destacados">
                                                <i class="bi bi-star-fill text-dark me-1"></i> Destacada
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-outline-warning text-dark py-2 font-heading rounded-pill px-3 small" title="Destacar este inmueble en el catálogo principal">
                                                <i class="bi bi-star me-1 text-warning"></i> Destacar
                                            </button>
                                        }
                                    </form>
                                    <a asp-action="EditProperty" asp-route-id="@item.Id" class="btn btn-outline-primary flex-grow-1 py-2 font-heading rounded-pill small">
                                        <i class="bi bi-pencil-square me-1"></i> Editar
                                    </a>
                                    <form asp-action="DeleteProperty" asp-route-id="@item.Id" method="post" onsubmit="return confirm('¿Está seguro de eliminar esta propiedad?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger py-2 rounded-pill px-3 small" title="Eliminar inmueble">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
