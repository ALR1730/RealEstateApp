@model RealEstateApp.Core.Application.ViewModels.Subscription.AgentSubscriptionDashboardViewModel
@{
    ViewData["Title"] = "Planes de Suscripción para Agentes";
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="font-heading fw-bold text-dark mb-1">
                <i class="bi bi-gem text-primary me-2"></i>Planes y Membresías de Agente
            </h3>
            <p class="text-muted small mb-0">
                Selecciona el plan que mejor se adapte al volumen de tu inventario inmobiliario y potencia tu alcance con propiedades destacadas y recorridos virtuales 3D.
            </p>
        </div>
        <a asp-action="Properties" class="btn btn-outline-secondary rounded-pill btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Volver a Mis Inmuebles
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm p-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm p-3 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Banner de Uso Actual -->
    <div class="card bg-light border-0 shadow-sm rounded-4 p-4 mb-5">
        <div class="row align-items-center">
            <div class="col-md-7 mb-3 mb-md-0">
                <span class="badge bg-primary px-3 py-2 rounded-pill small mb-2">Plan Actual: @(Model.CurrentSubscription?.PlanName ?? "Gratuito / Starter")</span>
                <h4 class="font-heading fw-bold text-dark mb-1">
                    Inventario Activo: @Model.CurrentActivePropertiesCount de @Model.MaxAllowedProperties propiedades
                </h4>
                <div class="progress mt-3 rounded-pill" style="height: 12px;">
                    @{
                        var percentage = Model.MaxAllowedProperties > 0 ? (int)((double)Model.CurrentActivePropertiesCount / Model.MaxAllowedProperties * 100) : 0;
                        var progClass = percentage >= 100 ? "bg-danger" : percentage >= 75 ? "bg-warning" : "bg-success";
                    }
                    <div class="progress-bar @progClass" role="progressbar" style="width: @Math.Min(percentage, 100)%;" aria-valuenow="@Model.CurrentActivePropertiesCount" aria-valuemin="0" aria-valuemax="@Model.MaxAllowedProperties"></div>
                </div>
            </div>
            <div class="col-md-5 text-md-end">
                @if (Model.CanCreateMoreProperties)
                {
                    <a asp-action="CreateProperty" class="btn btn-primary-gradient rounded-pill px-4 py-2 fw-bold">
                        <i class="bi bi-plus-circle me-1"></i> Publicar Nueva Propiedad
                    </a>
                }
                else
                {
                    <button class="btn btn-secondary rounded-pill px-4 py-2 fw-bold" disabled>
                        <i class="bi bi-slash-circle me-1"></i> Límite de Propiedades Alcanzado
                    </button>
                    <span class="text-danger small d-block mt-1">Mejora tu plan abajo para publicar más</span>
                }
            </div>
        </div>
    </div>

    <!-- Comparativa de Planes -->
    <div class="row row-cols-1 row-cols-md-3 g-4 justify-content-center">
        @foreach (var plan in Model.AvailablePlans)
        {
            var isCurrent = Model.CurrentSubscription?.SubscriptionPlanId == plan.Id;
            var isPopular = plan.Name.Contains("Pro") || plan.Name.Contains("Profesional");

            <div class="col">
                <div class="card h-100 border-0 shadow-lg rounded-4 position-relative overflow-hidden @(isPopular ? "border border-2 border-primary" : "")">
                    @if (isPopular)
                    {
                        <div class="bg-primary text-white text-center py-1 small fw-bold text-uppercase tracking-wider">
                            <i class="bi bi-stars me-1"></i> Más Popular
                        </div>
                    }

                    <div class="card-body p-4 d-flex flex-column justify-content-between">
                        <div>
                            <h4 class="font-heading fw-bold text-dark mb-1">@plan.Name</h4>
                            <p class="text-muted small mb-3">@plan.Description</p>

                            <div class="d-flex align-items-baseline mb-4">
                                <span class="display-5 fw-bold text-dark font-heading">
                                    @(plan.MonthlyPrice == 0 ? "Gratis" : $"${plan.MonthlyPrice:N2}")
                                </span>
                                @if (plan.MonthlyPrice > 0)
                                {
                                    <span class="text-muted small ms-1">/ mes</span>
                                }
                            </div>

                            <hr class="opacity-25 mb-4" />

                            <ul class="list-unstyled d-grid gap-3 small mb-4">
                                <li class="d-flex align-items-center">
                                    <i class="bi bi-check-circle-fill text-success fs-5 me-2"></i>
                                    <span>Hasta <strong>@plan.MaxActiveProperties propiedades</strong> activas</span>
                                </li>
                                <li class="d-flex align-items-center">
                                    @if (plan.MaxFeaturedProperties > 0)
                                    {
                                        <i class="bi bi-check-circle-fill text-success fs-5 me-2"></i>
                                        <span><strong>@plan.MaxFeaturedProperties listados destacados ⭐</strong> incluidos</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-dash-circle text-muted fs-5 me-2"></i>
                                        <span class="text-muted">Sin listados destacados</span>
                                    }
                                </li>
                                <li class="d-flex align-items-center">
                                    <i class="bi bi-check-circle-fill text-success fs-5 me-2"></i>
                                    <span>Tours 3D Matterport y Recorridos 360°</span>
                                </li>
                                <li class="d-flex align-items-center">
                                    <i class="bi bi-check-circle-fill text-success fs-5 me-2"></i>
                                    <span>Videos de YouTube embebidos</span>
                                </li>
                                <li class="d-flex align-items-center">
                                    <i class="bi bi-check-circle-fill text-success fs-5 me-2"></i>
                                    <span>Mensajería en vivo y negociación</span>
                                </li>
                            </ul>
                        </div>

                        <div class="mt-4">
                            @if (isCurrent)
                            {
                                <button class="btn btn-outline-success w-100 py-3 rounded-pill fw-bold" disabled>
                                    <i class="bi bi-check2-circle me-1"></i> Plan Activo Actual
                                </button>
                            }
                            else
                            {
                                <form asp-action="ChangeSubscription" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="planId" value="@plan.Id" />
                                    <button type="submit" class="btn @(isPopular ? "btn-primary-gradient" : "btn-outline-primary") w-100 py-3 rounded-pill fw-bold" onclick="return confirm('¿Confirmas que deseas cambiar al plan @plan.Name?')">
                                        <i class="bi bi-arrow-repeat me-1"></i> Seleccionar @plan.Name
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
