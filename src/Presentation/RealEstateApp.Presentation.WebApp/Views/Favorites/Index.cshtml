@model List<RealEstateApp.Core.Application.ViewModels.Favorite.FavoriteViewModel>
@{
    ViewData["Title"] = "Mis Favoritos";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="font-heading fw-bold text-dark mb-1"><i class="bi bi-heart-fill text-danger me-2"></i> Mis Inmuebles Favoritos</h2>
            <p class="text-muted small mb-0">Listado de propiedades guardadas para consulta rápida (las propiedades vendidas son depuradas automáticamente).</p>
        </div>
        <span class="badge bg-danger rounded-pill fs-6 px-3 py-2">@Model.Count Favoritos</span>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="text-center py-5 bg-white rounded-4 shadow-sm border">
            <i class="bi bi-heartbreak fs-1 text-muted d-block mb-3"></i>
            <h5 class="font-heading text-dark">No tienes propiedades favoritas guardadas</h5>
            <p class="text-muted small">Explora nuestro catálogo y haz clic en el ícono de corazón para guardar tus inmuebles preferidos.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary-gradient rounded-pill px-4 mt-2">
                <i class="bi bi-search me-1"></i> Explorar Catálogo
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card-property" data-href="@Url.Action("Details", "Home", new { id = item.PropertyId })">
                        <div class="img-container">
                            <span class="code-badge">@item.PropertyCode</span>
                            @{
                                var favStatus = (item.PropertyStatus == "Disponible" && item.IsFinanciable) ? "Financiable" : item.PropertyStatus;
                                var favStatusClass = favStatus == "Financiable" ? "badge-financiable" : "badge-disponible";
                            }
                            <span class="status-badge @favStatusClass">@favStatus</span>

                            @if (!string.IsNullOrEmpty(item.PropertyMainImage))
                            {
                                <img src="@item.PropertyMainImage" alt="@item.PropertyCode" />
                            }
                            else
                            {
                                <img src="https://images.unsplash.com/photo-1560518883-ce09059eeffa?auto=format&fit=crop&w=800&q=80" alt="Placeholder" />
                            }

                            <div class="price-tag">
                                @item.PropertyPrice.ToString("C0")
                            </div>

                            <form asp-controller="Favorites" asp-action="Toggle" method="post" class="d-inline">
                                <input type="hidden" name="propertyId" value="@item.PropertyId" />
                                <button type="submit" class="fav-btn-overlay active" title="Eliminar de favoritos">
                                    <i class="bi bi-heart-fill"></i>
                                </button>
                            </form>
                        </div>

                        <div class="card-body p-4 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="badge bg-light text-primary border">@item.PropertyTypeName</span>
                                </div>
                            </div>

                            <div>
                                <hr class="my-3 opacity-25">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="metric-pill"><i class="bi bi-door-open-fill"></i> @item.PropertyRooms Habs</span>
                                    <span class="metric-pill"><i class="bi bi-droplet-fill"></i> @item.PropertyBathrooms Baños</span>
                                    <span class="metric-pill"><i class="bi bi-aspect-ratio-fill"></i> @item.PropertySizeInMeters m²</span>
                                </div>

                                <a asp-controller="Home" asp-action="Details" asp-route-id="@item.PropertyId" class="btn btn-outline-custom w-100 py-2">
                                    Ver Detalle <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
