@model List<RealEstateApp.Core.Application.ViewModels.PropertyType.PropertyTypeViewModel>
@{
    ViewData["Title"] = "Mantenimiento de Tipos de Propiedades";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="font-heading fw-bold text-dark mb-1"><i class="bi bi-building text-primary me-2"></i> Tipos de Propiedades</h2>
            <p class="text-muted small mb-0">Mantenimiento de categorías de inmuebles del sistema.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary-gradient px-4 py-2 font-heading fw-bold rounded-pill">
            <i class="bi bi-plus-lg me-1"></i> Crear Tipo de Propiedad
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-2">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div>@TempData["SuccessMessage"]</div>
        </div>
    }

    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small text-uppercase font-heading">
                    <tr>
                        <th class="py-3 px-4">Nombre</th>
                        <th class="py-3">Descripción</th>
                        <th class="py-3">Propiedades</th>
                        <th class="py-3 px-4 text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="py-3 px-4 fw-bold font-heading text-dark">@item.Name</td>
                            <td class="text-muted small">@item.Description</td>
                            <td><span class="badge bg-info text-dark rounded-pill fs-6 px-3">@item.PropertiesCount</span></td>
                            <td class="py-3 px-4 text-end">
                                <div class="d-inline-flex gap-2">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil-square"></i> Editar
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('¿Desea eliminar este tipo de propiedad?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
