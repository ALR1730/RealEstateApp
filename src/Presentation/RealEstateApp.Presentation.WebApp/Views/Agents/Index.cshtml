@model List<RealEstateApp.Core.Application.ViewModels.Agent.AgentViewModel>
@{
    ViewData["Title"] = "Directorio de Agentes";
}

<div class="container py-5">
    <div class="text-center max-w-2xl mx-auto mb-5">
        <h2 class="font-heading fw-bold text-dark mb-2">Directorio de Agentes Autorizados</h2>
        <p class="text-muted lead fs-6">Conoce a nuestros asesores inmobiliarios expertos listos para brindarte acompañamiento profesional en la compra o alquiler de inmuebles.</p>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="text-center py-5 bg-white rounded-4 shadow-sm border">
            <i class="bi bi-person-x fs-1 text-muted d-block mb-3"></i>
            <h5 class="font-heading text-dark">No hay agentes disponibles en este momento</h5>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var agent in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="agent-card h-100 d-flex flex-column justify-content-between">
                        <div>
                            <div class="bg-primary text-white agent-avatar d-flex align-items-center justify-content-center fw-bold fs-2 shadow-sm">
                                @(string.IsNullOrEmpty(agent.FullName?.Trim()) ? agent.Email.Substring(0, 1).ToUpper() : agent.FullName.Substring(0, 1).ToUpper())
                            </div>

                            <h5 class="font-heading text-dark fw-bold mb-1">@agent.FullName</h5>
                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-1 rounded-pill mb-3">
                                <i class="bi bi-shield-check me-1"></i> Agente Activo
                            </span>

                            <div class="text-start bg-light p-3 rounded-3 border mb-3">
                                <p class="small text-muted mb-1"><i class="bi bi-envelope-fill me-2 text-primary"></i> @agent.Email</p>
                                <p class="small text-muted mb-0"><i class="bi bi-telephone-fill me-2 text-primary"></i> @(string.IsNullOrEmpty(agent.Phone) ? "No especificado" : agent.Phone)</p>
                            </div>
                        </div>

                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-3 px-1">
                                <span class="small text-muted">Propiedades Asignadas</span>
                                <span class="badge bg-primary rounded-pill fs-6 px-3">@agent.PropertiesCount</span>
                            </div>

                            <a asp-action="Details" asp-route-id="@agent.Id" class="btn btn-outline-custom w-100 py-2">
                                Ver Portafolio de Inmuebles <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
