@model RealEstateApp.Core.Application.ViewModels.Property.PropertyViewModel
@{
    ViewData["Title"] = Model.Name;
}

<style>
    @@media print {
        header, footer, nav, .navbar, .breadcrumb, .carousel-control-prev, .carousel-control-next,
        .no-print, .btn, form, iframe, .modal, #yearsPillGroup, #btnCalculate, .sticky-top,
        .avatar-lg, .alert {
            display: none !important;
        }

        body {
            background-color: #ffffff !important;
            color: #000000 !important;
            font-size: 11pt !important;
        }

        .container {
            width: 100% !important;
            max-width: 100% !important;
            padding: 0 !important;
            margin: 0 !important;
        }

        .row {
            display: block !important;
        }

        .col-lg-8, .col-lg-4, .col-md-6, .col-md-3, .col-4 {
            width: 100% !important;
            max-width: 100% !important;
            flex: 0 0 100% !important;
        }

        #mortgageResults {
            display: block !important;
        }

        #amortizationTableCollapse {
            display: block !important;
            height: auto !important;
            visibility: visible !important;
            overflow: visible !important;
        }

        .table-responsive {
            max-height: none !important;
            overflow: visible !important;
        }

        table {
            width: 100% !important;
            border-collapse: collapse !important;
            margin-top: 15px !important;
        }

        th, td {
            border: 1px solid #ccc !important;
            padding: 6px 8px !important;
            font-size: 9.5pt !important;
        }

        thead {
            display: table-header-group !important;
            background-color: #f2f2f2 !important;
        }

        tr {
            page-break-inside: avoid !important;
        }

        .card {
            border: 1px solid #e0e0e0 !important;
            box-shadow: none !important;
            margin-bottom: 20px !important;
            page-break-inside: avoid !important;
        }

        .print-report-header {
            display: block !important;
            border-bottom: 2px solid #0d6efd;
            padding-bottom: 12px;
            margin-bottom: 20px;
        }
    }

    .print-report-header {
        display: none;
    }
</style>

<div class="container py-4">
    <!-- Encabezado exclusivo para impresión PDF -->
    <div class="print-report-header text-center">
        <h3 class="fw-bold text-primary mb-1">RealEstateApp - Reporte Inmobiliario e Hipotecario</h3>
        <p class="text-muted small mb-0">Ficha Técnica de Inmueble y Tabla de Amortización Francesa | Generado el @DateTime.Now.ToString("dd/MM/yyyy")</p>
    </div>

    <!-- Breadcrumb & Header Header -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Catálogo</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center flex-wrap gap-2 mb-2">
                <span class="badge bg-dark px-3 py-2 fs-6"><i class="bi bi-qr-code me-1"></i>Código: @Model.Code</span>
                <span class="badge bg-primary px-3 py-2 fs-6">@Model.PropertyTypeName</span>
                <span class="badge bg-secondary px-3 py-2 fs-6">@Model.SaleTypeName</span>
                @{
                    var displayStatus = (Model.Status == "Disponible" && Model.IsFinanciable) ? "Financiable" : Model.Status;
                    var statusClass = displayStatus == "Financiable" ? "badge-financiable" :
                                      Model.Status == "Disponible" ? "badge-disponible" :
                                      Model.Status == "Reservada" ? "badge-reservada" : "badge-vendida";
                }
                <span class="badge @statusClass px-3 py-2 fs-6">@displayStatus</span>
            </div>
            <h2 class="font-heading fw-bold text-dark mb-0">@Model.Name</h2>
        </div>

        <div class="text-md-end">
            <span class="text-muted small d-block">Precio de Venta</span>
            <h2 class="font-heading text-primary fw-bold mb-0">@Model.Price.ToString("C0")</h2>
        </div>
    </div>

    <!-- Galería de Imágenes Carousel -->
    <div class="row g-4 mb-5">
        <div class="col-lg-8 order-1">
            @if (Model.Images != null && Model.Images.Count > 0)
            {
                <div id="propertyGallery" class="carousel slide rounded-4 overflow-hidden shadow-lg" data-bs-ride="carousel">
                    <div class="carousel-inner">
                        @for (int i = 0; i < Model.Images.Count; i++)
                        {
                            <div class="carousel-item @(i == 0 ? "active" : "")">
                                <img src="@Model.Images[i]" class="d-block w-100" style="height: 480px; object-fit: cover;" alt="Imagen @(i+1)">
                            </div>
                        }
                    </div>
                    @if (Model.Images.Count > 1)
                    {
                        <button class="carousel-control-prev" type="button" data-bs-target="#propertyGallery" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Anterior</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#propertyGallery" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Siguiente</span>
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="rounded-4 overflow-hidden shadow-sm border bg-light d-flex align-items-center justify-content-center" style="height: 400px;">
                    <span class="text-muted"><i class="bi bi-image fs-1 d-block text-center mb-2"></i> Sin imágenes disponibles</span>
                </div>
            }

            <!-- Descripción y Características -->
            <div class="card border-0 shadow-sm rounded-4 mt-4 p-4">
                <h4 class="font-heading fw-bold mb-3">Descripción del Inmueble</h4>
                <p class="text-secondary lead fs-6 mb-4">@Model.Description</p>

                <h5 class="font-heading fw-bold mb-3">Detalles Principales</h5>
                <div class="row g-3 text-center mb-4">
                    <div class="col-4 col-md-3">
                        <div class="p-3 bg-light rounded-3 border">
                            <i class="bi bi-door-open-fill text-primary fs-3 d-block mb-1"></i>
                            <span class="fw-bold d-block">@Model.Rooms</span>
                            <span class="text-muted small">Habitaciones</span>
                        </div>
                    </div>
                    <div class="col-4 col-md-3">
                        <div class="p-3 bg-light rounded-3 border">
                            <i class="bi bi-droplet-fill text-info fs-3 d-block mb-1"></i>
                            <span class="fw-bold d-block">@Model.Bathrooms</span>
                            <span class="text-muted small">Baños</span>
                        </div>
                    </div>
                    <div class="col-4 col-md-3">
                        <div class="p-3 bg-light rounded-3 border">
                            <i class="bi bi-aspect-ratio-fill text-success fs-3 d-block mb-1"></i>
                            <span class="fw-bold d-block">@Model.SizeInMeters</span>
                            <span class="text-muted small">Metros²</span>
                        </div>
                    </div>
                    <div class="col-12 col-md-3">
                        <div class="p-3 bg-light rounded-3 border">
                            <i class="bi bi-cash-coin text-warning fs-3 d-block mb-1"></i>
                            <span class="fw-bold d-block">@Model.MontoSeparacion.ToString("C0")</span>
                            <span class="text-muted small">Separación</span>
                        </div>
                    </div>
                </div>

                <!-- Lista de Mejoras -->
                @if (Model.Improvements != null && Model.Improvements.Count > 0)
                {
                    <h5 class="font-heading fw-bold mb-3">Mejoras e Instalaciones</h5>
                    <div class="d-flex flex-wrap gap-2 mb-4">
                        @foreach (var imp in Model.Improvements)
                        {
                            <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-3 py-2 rounded-pill">
                                <i class="bi bi-check-circle-fill me-1"></i> @imp
                            </span>
                        }
                    </div>
                }

                <!-- Video y Tour 360 -->
                @if (!string.IsNullOrEmpty(Model.VideoUrl) || !string.IsNullOrEmpty(Model.Tour360Url))
                {
                    <h5 class="font-heading fw-bold mb-3">Recorrido Multimedia</h5>
                    <div class="d-flex flex-wrap gap-3">
                        @if (!string.IsNullOrEmpty(Model.VideoUrl))
                        {
                            <a href="@Model.VideoUrl" target="_blank" class="btn btn-outline-danger rounded-pill px-4">
                                <i class="bi bi-youtube me-2"></i> Ver Video de la Propiedad
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(Model.Tour360Url))
                        {
                            <a href="@Model.Tour360Url" target="_blank" class="btn btn-outline-info rounded-pill px-4">
                                <i class="bi bi-badge-3d me-2"></i> Realizar Tour Virtual 360°
                            </a>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Sidebar de Agente y Acciones de Cliente -->
        <div class="col-lg-4 order-2">
            <div class="card border-0 shadow-lg rounded-4 p-4 sticky-top" style="top: 90px;">
                <h5 class="font-heading fw-bold mb-3">Agente Inmobiliario</h5>
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="avatar-lg bg-primary-soft text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold fs-4" style="width: 54px; height: 54px;">
                        @(string.IsNullOrEmpty(Model.AgentName) ? "A" : Model.AgentName.Substring(0, 1).ToUpper())
                    </div>
                    <div>
                        <h6 class="font-heading mb-0 text-dark">@Model.AgentName</h6>
                        <span class="text-muted small">Agente Certificado</span>
                    </div>
                </div>

                <div class="d-grid gap-2 mb-4">
                    @if (ViewBag.IsBuyerWithAcceptedOffer == true)
                    {
                        <div class="alert alert-success border-0 shadow-sm rounded-3 p-3 mb-2 text-center">
                            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                            <strong>¡Tu oferta por esta propiedad fue aceptada!</strong>
                            <p class="small mb-0 mt-1">Puedes continuar comunicándote con el agente a través del botón de mensaje directo.</p>
                        </div>
                    }

                    @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Client"))
                    {
                        @if (Model.Status == "Disponible")
                        {
                            <a asp-controller="Offers" asp-action="Create" asp-route-propertyId="@Model.Id" class="btn btn-primary-gradient py-3 font-heading fw-bold">
                                <i class="bi bi-cash-coin me-2"></i> Enviar Oferta
                            </a>
                        }

                        <a asp-controller="Chats" asp-action="Thread" asp-route-propertyId="@Model.Id" asp-route-agentId="@Model.AgentId" class="btn btn-success py-2 font-heading fw-bold d-flex align-items-center justify-content-center gap-2">
                            <i class="bi bi-whatsapp fs-5"></i> Chat Directo vía WhatsApp
                        </a>

                        <form asp-controller="Favorites" asp-action="Toggle" method="post" class="d-grid mt-1">
                            <input type="hidden" name="propertyId" value="@Model.Id" />
                            <button type="submit" class="btn @(Model.IsFavorite ? "btn-danger" : "btn-outline-danger") py-2 font-heading">
                                <i class="bi @(Model.IsFavorite ? "bi-heart-fill" : "bi-heart") me-2"></i>
                                @(Model.IsFavorite ? "Eliminar de Favoritos" : "Guardar en Favoritos")
                            </button>
                        </form>
                    }
                    else if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <div class="alert alert-light border small text-muted text-center mb-0">
                            <i class="bi bi-info-circle me-1"></i> Conectado con perfil de gestión.
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="btn btn-primary-gradient py-3 font-heading fw-bold">
                            <i class="bi bi-box-arrow-in-right me-2"></i> Iniciar Sesión para Ofertar
                        </a>
                    }
                </div>

                <div class="bg-light p-3 rounded-3 border">
                    <h6 class="font-heading fw-bold text-dark mb-2">Geolocalización</h6>
                    <p class="small text-muted mb-2">
                        <i class="bi bi-geo-alt-fill text-danger me-1"></i> Lat: @Model.Latitude, Long: @Model.Longitude
                    </p>
                    <a href="https://www.google.com/maps/search/?api=1&query=@Model.Latitude,@Model.Longitude" target="_blank" class="btn btn-sm btn-outline-secondary w-100">
                        <i class="bi bi-map me-1"></i> Abrir en Google Maps
                    </a>
                </div>
            </div>
        </div>

        <!-- Simulador de Hipoteca Profesional Interactivo -->
        <div class="col-lg-8 order-3 mt-4">
            <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 bg-white">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h4 class="font-heading fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                    <i class="bi bi-calculator-fill text-primary"></i> Simulador Hipotecario
                </h4>
                <p class="text-muted small mb-0">Calcula tus cuotas, costo total del crédito y tabla de amortización por el sistema francés.</p>
            </div>
            <span class="badge bg-light text-primary border rounded-pill px-3 py-2 font-heading">
                <i class="bi bi-shield-check me-1"></i> Tasa Fija
            </span>
        </div>

        <form id="mortgageForm" class="row g-4 mb-4">
            <!-- Precio del Inmueble -->
            <div class="col-md-6">
                <label class="form-label small fw-bold text-dark">Precio del Inmueble (RD$)</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-0 fw-bold text-primary">RD$</span>
                    <input type="number" id="calcPrice" class="form-control form-control-custom fw-bold" value="@Model.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)" step="1000" />
                </div>
            </div>

            <!-- Inicial / Enganche -->
            <div class="col-md-6">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label class="form-label small fw-bold text-dark mb-0">Enganche / Inicial (RD$)</label>
                    <span id="downPaymentPercentBadge" class="badge bg-primary-soft text-primary small">@Model.PorcentajeInicialRequerido.ToString("N0")%</span>
                </div>
                <div class="input-group">
                    <span class="input-group-text bg-light border-0 fw-bold text-success">RD$</span>
                    <input type="number" id="calcDownPayment" class="form-control form-control-custom fw-bold" value="@((Model.Price * (Model.PorcentajeInicialRequerido / 100m)).ToString(System.Globalization.CultureInfo.InvariantCulture))" min="0" step="1000" />
                </div>
            </div>

            <!-- Tasa Anual Estimada -->
            <div class="col-md-6">
                <label class="form-label small fw-bold text-dark">Tasa de Interés Anual (%)</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-0"><i class="bi bi-percent text-warning"></i></span>
                    <input type="number" id="calcRate" class="form-control form-control-custom fw-bold" value="8.5" step="0.1" min="0.1" max="30" />
                </div>
            </div>

            <!-- Plazo del Crédito -->
            <div class="col-md-6">
                <label class="form-label small fw-bold text-dark">Plazo del Crédito (Años)</label>
                <div class="d-flex gap-1 flex-wrap" id="yearsPillGroup">
                    <input type="hidden" id="calcYears" value="15" />
                    <button type="button" class="btn btn-sm btn-outline-custom pill-year-btn" data-years="5">5 Años</button>
                    <button type="button" class="btn btn-sm btn-outline-custom pill-year-btn" data-years="10">10 Años</button>
                    <button type="button" class="btn btn-sm btn-primary-gradient pill-year-btn active" data-years="15">15 Años</button>
                    <button type="button" class="btn btn-sm btn-outline-custom pill-year-btn" data-years="20">20 Años</button>
                    <button type="button" class="btn btn-sm btn-outline-custom pill-year-btn" data-years="25">25 Años</button>
                    <button type="button" class="btn btn-sm btn-outline-custom pill-year-btn" data-years="30">30 Años</button>
                </div>
            </div>

            <div class="col-12 mt-4">
                <button type="button" id="btnCalculate" class="btn btn-primary-gradient w-100 py-3 font-heading fw-bold shadow-sm">
                    <i class="bi bi-calculator me-2"></i> Calcular Amortización y Resultados
                </button>
            </div>
        </form>

        <!-- Resultados del Cálculo -->
        <div id="mortgageResults" class="d-none">
            <!-- Resumen de Tarjetas KPI -->
            <div class="card border-0 bg-light rounded-4 p-4 mb-4">
                <div class="row text-center g-3">
                    <div class="col-md-3 border-end border-sm-0">
                        <span class="text-muted small font-heading d-block mb-1">Cuota Mensual Estimada</span>
                        <h3 id="resInstallment" class="font-heading text-primary fw-bold mb-0">$0</h3>
                        <span class="badge bg-primary text-white mt-1 px-2 py-1 small">Fija Mensual</span>
                    </div>
                    <div class="col-md-3 border-end border-sm-0">
                        <span class="text-muted small font-heading d-block mb-1">Monto del Préstamo</span>
                        <h4 id="resLoan" class="font-heading text-dark fw-bold mb-0">$0</h4>
                        <span class="small text-muted">Financiado por banco</span>
                    </div>
                    <div class="col-md-3 border-end border-sm-0">
                        <span class="text-muted small font-heading d-block mb-1">Total Intereses</span>
                        <h4 id="resInterest" class="font-heading text-danger fw-bold mb-0">$0</h4>
                        <span class="small text-muted">Acumulado en plazo</span>
                    </div>
                    <div class="col-md-3">
                        <span class="text-muted small font-heading d-block mb-1">Costo Total del Crédito</span>
                        <h4 id="resTotalCost" class="font-heading text-success fw-bold mb-0">$0</h4>
                        <span class="small text-muted">Préstamo + Intereses</span>
                    </div>
                </div>

                <!-- Barra Proporcional de Distribución -->
                <div class="mt-4 pt-3 border-top">
                    <div class="d-flex justify-content-between small text-muted font-heading mb-1">
                        <span>Distribución Financiera del Inmueble</span>
                        <span id="distSummaryText">Inicial vs Préstamo vs Interés</span>
                    </div>
                    <div class="progress rounded-pill" style="height: 14px;">
                        <div id="barDownPayment" class="progress-bar bg-success" role="progressbar" style="width: 20%" title="Enganche / Inicial"></div>
                        <div id="barPrincipal" class="progress-bar bg-primary" role="progressbar" style="width: 50%" title="Capital Prestado"></div>
                        <div id="barInterest" class="progress-bar bg-danger" role="progressbar" style="width: 30%" title="Intereses Totales"></div>
                    </div>
                    <div class="d-flex justify-content-center gap-4 mt-2 small font-heading">
                        <span><i class="bi bi-circle-fill text-success me-1"></i> Enganche (<span id="pctDown">0%</span>)</span>
                        <span><i class="bi bi-circle-fill text-primary me-1"></i> Capital (<span id="pctPrincipal">0%</span>)</span>
                        <span><i class="bi bi-circle-fill text-danger me-1"></i> Intereses (<span id="pctInterest">0%</span>)</span>
                    </div>
                </div>
            </div>

            <!-- Botones de Acción de Tabla -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="font-heading fw-bold text-dark mb-0"><i class="bi bi-table text-primary me-1"></i> Tabla de Amortización Francesa</h6>
                <div class="d-flex gap-2">
                    <button id="btnPrintPdf" class="btn btn-sm btn-outline-secondary font-heading no-print" type="button">
                        <i class="bi bi-printer me-1"></i> Imprimir / Guardar
                    </button>
                    <button class="btn btn-sm btn-outline-primary font-heading rounded-pill no-print" type="button" data-bs-toggle="collapse" data-bs-target="#amortizationTableCollapse">
                        <i class="bi bi-eye me-1"></i> Mostrar / Ocultar Tabla
                    </button>
                </div>
            </div>

            <div class="collapse" id="amortizationTableCollapse">
                <div class="table-responsive bg-white rounded-4 border shadow-sm" style="max-height: 350px; overflow-y: auto;">
                    <table class="table table-sm table-hover text-center align-middle small mb-0">
                        <thead class="bg-light sticky-top font-heading text-uppercase text-muted">
                            <tr>
                                <th class="py-2">Mes</th>
                                <th class="py-2">Cuota Fija</th>
                                <th class="py-2">Interés (Rojo)</th>
                                <th class="py-2">Abono Capital (Verde)</th>
                                <th class="py-2">Saldo Pendiente</th>
                            </tr>
                        </thead>
                        <tbody id="amortizationTableBody">
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Manejador del selector de años en botones pill
            $(".pill-year-btn").click(function () {
                $(".pill-year-btn").removeClass("btn-primary-gradient active").addClass("btn-outline-custom");
                $(this).removeClass("btn-outline-custom").addClass("btn-primary-gradient active");
                $("#calcYears").val($(this).data("years"));
                calculateMortgage();
            });

            // Actualizar porcentaje de inicial cuando cambia el monto de inicial o precio
            function updateDownPaymentPercentage() {
                var price = parseFloat($("#calcPrice").val()) || 0;
                var down = parseFloat($("#calcDownPayment").val()) || 0;
                if (price > 0) {
                    var pct = Math.min(100, Math.max(0, (down / price) * 100));
                    $("#downPaymentPercentBadge").text(pct.toFixed(1) + "%");
                }
            }

            $("#calcPrice, #calcDownPayment").on("input change", function () {
                updateDownPaymentPercentage();
            });

            function calculateMortgage() {
                var price = parseFloat($("#calcPrice").val());
                var downPayment = parseFloat($("#calcDownPayment").val()) || 0;
                var rate = parseFloat($("#calcRate").val()) || 8.5;
                var years = parseInt($("#calcYears").val()) || 15;

                if (isNaN(price) || price <= 0) {
                    alert("Por favor ingrese un precio de inmueble válido.");
                    return;
                }

                $.post("/Home/CalculateMortgage", { price: price, downPayment: downPayment, rate: rate, years: years }, function (res) {
                    if (res && res.schedule && res.schedule.length > 0) {
                        var tbody = $("#amortizationTableBody");
                        tbody.empty();

                        res.schedule.forEach(function (item) {
                            var row = "<tr>" +
                                "<td class='fw-bold text-dark'>Mes " + item.period + "</td>" +
                                "<td class='fw-bold text-primary'>RD$ " + item.installment.toLocaleString('es-DO', {minimumFractionDigits: 2, maximumFractionDigits: 2}) + "</td>" +
                                "<td class='text-danger'>RD$ " + item.interest.toLocaleString('es-DO', {minimumFractionDigits: 2, maximumFractionDigits: 2}) + "</td>" +
                                "<td class='text-success fw-bold'>RD$ " + item.principal.toLocaleString('es-DO', {minimumFractionDigits: 2, maximumFractionDigits: 2}) + "</td>" +
                                "<td class='text-muted'>RD$ " + item.remainingBalance.toLocaleString('es-DO', {minimumFractionDigits: 2, maximumFractionDigits: 2}) + "</td>" +
                                "</tr>";
                            tbody.append(row);
                        });

                        $("#resInstallment").text("RD$ " + res.monthlyInstallment.toLocaleString('es-DO', {minimumFractionDigits: 2, maximumFractionDigits: 2}));
                        $("#resLoan").text("RD$ " + res.loanAmount.toLocaleString('es-DO', {minimumFractionDigits: 2, maximumFractionDigits: 2}));
                        $("#resInterest").text("RD$ " + res.totalInterest.toLocaleString('es-DO', {minimumFractionDigits: 2, maximumFractionDigits: 2}));
                        $("#resTotalCost").text("RD$ " + res.totalCost.toLocaleString('es-DO', {minimumFractionDigits: 2, maximumFractionDigits: 2}));

                        // Calcular porcentajes de la barra proporcional
                        var totalCapitalPlusInterestPlusDown = res.propertyPrice + res.totalInterest;
                        var pctDown = totalCapitalPlusInterestPlusDown > 0 ? (res.downPayment / totalCapitalPlusInterestPlusDown) * 100 : 0;
                        var pctPrincipal = totalCapitalPlusInterestPlusDown > 0 ? (res.loanAmount / totalCapitalPlusInterestPlusDown) * 100 : 0;
                        var pctInterest = totalCapitalPlusInterestPlusDown > 0 ? (res.totalInterest / totalCapitalPlusInterestPlusDown) * 100 : 0;

                        $("#barDownPayment").css("width", pctDown.toFixed(1) + "%");
                        $("#barPrincipal").css("width", pctPrincipal.toFixed(1) + "%");
                        $("#barInterest").css("width", pctInterest.toFixed(1) + "%");

                        $("#pctDown").text(res.downPaymentPercentage.toFixed(1) + "%");
                        $("#pctPrincipal").text((100 - res.downPaymentPercentage).toFixed(1) + "%");
                        var interestPctOfLoan = res.loanAmount > 0 ? ((res.totalInterest / res.loanAmount) * 100).toFixed(1) : "0";
                        $("#pctInterest").text(interestPctOfLoan + "% del préstamo");

                        $("#mortgageResults").removeClass("d-none");
                    }
                }).fail(function () {
                    alert("Ocurrió un error al calcular la amortización hipotecaria. Verifique los datos.");
                });
            }

            $("#btnCalculate").click(function () {
                calculateMortgage();
            });

            // Evento para guardar / imprimir PDF profesional completo
            $("#btnPrintPdf").click(function () {
                if ($("#mortgageResults").hasClass("d-none")) {
                    calculateMortgage();
                }
                $("#amortizationTableCollapse").addClass("show");
                setTimeout(function () {
                    window.print();
                }, 250);
            });

            // Auto-calcular en carga inicial para mostrar datos predeterminados
            updateDownPaymentPercentage();
            calculateMortgage();
        });
    </script>
}
