@{
    ViewData["Title"] = "Mapa Interactivo de Propiedades";
}

<!-- Leaflet CSS & MarkerCluster CSS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css" />
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css" />

<div class="container-fluid p-0">
    <div class="bg-dark text-white py-3 px-4 d-flex align-items-center justify-content-between shadow-sm">
        <div>
            <h4 class="font-heading fw-bold mb-0 d-flex align-items-center gap-2">
                <i class="bi bi-geo-alt-fill text-info"></i> Mapa Global de Inmuebles
            </h4>
            <span class="small text-white-50">Explora todas las propiedades geolocalizadas con marcadores interactivos.</span>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light btn-sm rounded-pill px-3">
                <i class="bi bi-grid me-1"></i> Vista de Galería
            </a>
        </div>
    </div>

    <div id="mapContainer" style="height: calc(100vh - 140px); width: 100%;"></div>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"></script>

    <script>
        $(document).ready(function () {
            // Inicializar mapa centrado en Santo Domingo, República Dominicana
            var map = L.map('mapContainer').setView([18.4861, -69.9312], 12);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; OpenStreetMap contributors | RealEstateApp'
            }).addTo(map);

            var markers = L.markerClusterGroup();

            // Cargar datos de propiedades en formato JSON
            $.ajax({
                url: '/Home/GetMapData',
                type: 'GET',
                success: function (data) {
                    if (!data || data.length === 0) return;

                    data.forEach(function (item) {
                        if (item.latitude && item.longitude) {
                            var customIcon = L.divIcon({
                                className: 'custom-map-pin',
                                html: `<div class="bg-info text-dark font-monospace fw-bold px-2 py-1 rounded-pill shadow-sm border border-white" style="font-size: 11px;">RD$ ${item.priceFormatted}</div>`,
                                iconSize: [90, 30],
                                iconAnchor: [45, 15]
                            });

                            var marker = L.marker([item.latitude, item.longitude], { icon: customIcon });

                            var popupContent = `
                                <div style="max-width: 220px;">
                                    <img src="${item.imageUrl || '/images/default-property.jpg'}" style="width: 100%; height: 110px; object-fit: cover; border-radius: 8px; margin-bottom: 8px;" />
                                    <h6 class="fw-bold mb-1" style="font-size: 0.9rem;">${item.name}</h6>
                                    <span class="badge bg-secondary mb-1">${item.propertyType}</span>
                                    <div class="fw-bold text-success mb-2">RD$ ${item.priceFormatted}</div>
                                    <div class="small text-muted mb-2"><i class="bi bi-door-open"></i> ${item.rooms} hab. | <i class="bi bi-droplet"></i> ${item.bathrooms} baños | ${item.size} m²</div>
                                    <a href="/Home/Details/${item.id}" class="btn btn-primary btn-sm rounded-pill w-100 fw-bold">Ver Detalle</a>
                                </div>
                            `;

                            marker.bindPopup(popupContent);
                            markers.addLayer(marker);
                        }
                    });

                    map.addLayer(markers);
                }
            });
        });
    </script>
}
