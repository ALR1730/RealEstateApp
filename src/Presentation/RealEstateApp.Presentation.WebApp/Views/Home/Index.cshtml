@model List<RealEstateApp.Core.Application.ViewModels.Property.PropertyViewModel>
@{
    ViewData["Title"] = "Portal Inmobiliario";
    var filters = ViewBag.Filters as RealEstateApp.Core.Application.ViewModels.Property.PropertyFilterViewModel ?? new RealEstateApp.Core.Application.ViewModels.Property.PropertyFilterViewModel();
    var hasActiveFilters = filters.PropertyTypeId.HasValue || filters.SaleTypeId.HasValue || 
                           filters.MinPrice.HasValue || filters.MaxPrice.HasValue || 
                           filters.MinRooms.HasValue || filters.MinBathrooms.HasValue || 
                           filters.MinSizeInMeters.HasValue || filters.MaxSizeInMeters.HasValue ||
                           !string.IsNullOrEmpty(filters.Code) || filters.ProvinceId.HasValue || 
                           filters.MunicipalityId.HasValue || !string.IsNullOrEmpty(filters.Sector) || 
                           filters.OnlyFeatured == true || filters.OnlyVerifiedAgents == true ||
                           filters.OnlyFinanciable == true || filters.OnlyWithVirtualTour == true ||
                           (filters.ImprovementIds != null && filters.ImprovementIds.Count > 0);
}

<!-- Hero Section -->
<section class="hero-section text-center">
    <div class="container position-relative">
        <h1 class="hero-title mb-3">Encuentra el Inmueble de tus Sueños</h1>
        <p class="hero-subtitle mb-4 max-w-2xl mx-auto">
            Explora las mejores casas, apartamentos y villas disponibles. Simula tu hipoteca en tiempo real y oferta directamente.
        </p>

        <!-- Buscador Rápido por Código de 6 dígitos -->
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <form asp-action="Index" method="get" class="d-flex gap-2 bg-white p-2 rounded-pill shadow-lg">
                    <input type="text" name="Code" value="@filters.Code" class="form-control border-0 bg-transparent px-4 font-heading" 
                           placeholder="Buscar por Código" maxlength="6" style="text-transform: uppercase;" />
                    <button type="submit" class="btn btn-primary-gradient rounded-pill px-4">
                        <i class="bi bi-search me-1"></i> Buscar
                    </button>
                </form>
            </div>
        </div>
    </div>
</section>

<div class="container pb-5">
    <!-- Card de Filtros Combinados Avanzados -->
    <div class="search-filter-card mb-4 shadow-sm border-0 rounded-4">
        <form asp-action="Index" method="get" id="filterForm">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="d-flex align-items-center gap-2">
                    <h5 class="font-heading mb-0 text-dark fw-bold">
                        <i class="bi bi-sliders text-primary me-1"></i> Filtros Combinados de Búsqueda
                    </h5>
                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill px-3 py-1 small">
                        Búsqueda Inteligente
                    </span>
                </div>
                @if (hasActiveFilters)
                {
                    <a asp-action="Index" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-bold">
                        <i class="bi bi-x-circle me-1"></i> Limpiar Filtros
                    </a>
                }
            </div>

            <div class="row g-3">
                <input type="hidden" name="UserLat" id="userLatInput" value="@filters.UserLat" />
                <input type="hidden" name="UserLng" id="userLngInput" value="@filters.UserLng" />

                <!-- ================= BLOQUE 1: UBICACIÓN Y DISTANCIA (4 Columnas) ================= -->
                <!-- 1. Provincia -->
                <div class="col-lg-3 col-md-6">
                    <label class="form-label small fw-bold text-muted"><i class="bi bi-geo-alt-fill text-danger me-1"></i>Provincia (RD)</label>
                    <select name="ProvinceId" id="provinceFilterSelect" class="form-select form-select-custom">
                        <option value="">Todas las provincias</option>
                        @if (filters.Provinces != null)
                        {
                            foreach (var item in filters.Provinces)
                            {
                                <option value="@item.Id" selected="@(filters.ProvinceId == item.Id)">@item.Name</option>
                            }
                        }
                    </select>
                </div>

                <!-- 2. Municipio -->
                <div class="col-lg-3 col-md-6">
                    <label class="form-label small fw-bold text-muted"><i class="bi bi-pin-map text-primary me-1"></i>Municipio</label>
                    <select name="MunicipalityId" id="municipalityFilterSelect" class="form-select form-select-custom">
                        <option value="">Todos los municipios</option>
                        @if (filters.Municipalities != null)
                        {
                            foreach (var item in filters.Municipalities)
                            {
                                <option value="@item.Id" selected="@(filters.MunicipalityId == item.Id)">@item.Name</option>
                            }
                        }
                    </select>
                </div>

                <!-- 3. Sector / Barrio (100% Dinámico desde BD) -->
                <div class="col-lg-3 col-md-6">
                    <label class="form-label small fw-bold text-muted"><i class="bi bi-signpost-2 text-info me-1"></i>Sector / Barrio</label>
                    <div class="input-group">
                        <input type="text" name="Sector" id="sectorFilterInput" list="sectorsDatalist" value="@filters.Sector" class="form-control form-control-custom" placeholder="Escribe o elige sector..." autocomplete="off" />
                        <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Sectores registrados en BD">
                            <i class="bi bi-list-nested"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm" id="sectorsDropdownMenu" style="max-height: 250px; overflow-y: auto;">
                            <li><h6 class="dropdown-header text-primary"><i class="bi bi-database me-1"></i> Sectores Registrados</h6></li>
                            @if (filters.AvailableSectors != null && filters.AvailableSectors.Count > 0)
                            {
                                foreach (var s in filters.AvailableSectors)
                                {
                                    <li><a class="dropdown-item select-sector-item" href="javascript:void(0);" data-sector="@s">@s</a></li>
                                }
                            }
                            else
                            {
                                <li class="px-3 py-1 text-muted small no-sectors-item">Sin sectores registrados aún</li>
                            }
                        </ul>
                    </div>
                    <datalist id="sectorsDatalist">
                        @if (filters.AvailableSectors != null)
                        {
                            foreach (var s in filters.AvailableSectors)
                            {
                                <option value="@s"></option>
                            }
                        }
                    </datalist>
                </div>

                <!-- 4. Cerca de mí (Radio Km + GPS) -->
                <div class="col-lg-3 col-md-6">
                    <label class="form-label small fw-bold text-muted"><i class="bi bi-radar text-info me-1"></i>Cerca de mí (Radio Km)</label>
                    <div class="input-group">
                        <input type="number" name="MaxDistanceKm" id="maxDistanceInput" value="@filters.MaxDistanceKm" class="form-control form-control-custom" placeholder="Ej. 10 km" min="1" max="500" />
                        <button type="button" id="btnGeolocate" class="btn btn-outline-info" title="Obtener mi posición GPS">
                            <i class="bi bi-crosshair"></i>
                        </button>
                    </div>
                </div>

                <!-- ================= BLOQUE 2: CARACTERÍSTICAS Y DISTRIBUCIÓN (4 Columnas) ================= -->
                <!-- 5. Tipo de Propiedad -->
                <div class="col-lg-3 col-md-6">
                    <label class="form-label small fw-bold text-muted"><i class="bi bi-building me-1 text-primary"></i>Tipo de Propiedad</label>
                    <select name="PropertyTypeId" class="form-select form-select-custom">
                        <option value="">Todos los tipos</option>
                        @if (filters.PropertyTypes != null)
                        {
                            foreach (var item in filters.PropertyTypes)
                            {
                                <option value="@item.Id" selected="@(filters.PropertyTypeId == item.Id)">@item.Name</option>
                            }
                        }
                    </select>
                </div>

                <!-- 6. Tipo de Venta / Modalidad -->
                <div class="col-lg-3 col-md-6">
                    <label class="form-label small fw-bold text-muted"><i class="bi bi-tag-fill me-1 text-warning"></i>Operación / Venta</label>
                    <select name="SaleTypeId" class="form-select form-select-custom">
                        <option value="">Todas las modalidades</option>
                        @if (filters.SaleTypes != null)
                        {
                            foreach (var item in filters.SaleTypes)
                            {
                                <option value="@item.Id" selected="@(filters.SaleTypeId == item.Id)">@item.Name</option>
                            }
                        }
                    </select>
                </div>

                <!-- 7. Agente / Publicador -->
                <div class="col-lg-3 col-md-6">
                    <label class="form-label small fw-bold text-muted"><i class="bi bi-person-badge me-1 text-info"></i>Agente / Publicador</label>
                    <select name="AgentId" class="form-select form-select-custom">
                        <option value="">Todos los agentes</option>
                        @if (filters.AvailableAgents != null)
                        {
                            foreach (var ag in filters.AvailableAgents)
                            {
                                <option value="@ag.Id" selected="@(filters.AgentId == ag.Id)">@ag.Name</option>
                            }
                        }
                    </select>
                </div>

                <!-- 8. Habitaciones y Baños Compactos -->
                <div class="col-lg-3 col-md-6">
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted"><i class="bi bi-door-open me-1 text-primary"></i>Habs Mín.</label>
                            <input type="number" name="MinRooms" value="@filters.MinRooms" class="form-control form-control-custom text-center" placeholder="0" min="0" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted"><i class="bi bi-droplet me-1 text-info"></i>Baños Mín.</label>
                            <input type="number" name="MinBathrooms" value="@filters.MinBathrooms" class="form-control form-control-custom text-center" placeholder="0" min="0" />
                        </div>
                    </div>
                </div>

                <!-- ================= BLOQUE 3: PRECIOS Y TAMAÑO EN M² (4 Columnas) ================= -->
                <!-- 9. Precio Mínimo -->
                <div class="col-lg-3 col-md-6">
                    <label class="form-label small fw-bold text-muted"><i class="bi bi-cash me-1 text-success"></i>Precio Mínimo (RD$)</label>
                    <input type="number" name="MinPrice" value="@filters.MinPrice" class="form-control form-control-custom" placeholder="Min RD$" step="1000" />
                </div>

                <!-- 10. Precio Máximo -->
                <div class="col-lg-3 col-md-6">
                    <label class="form-label small fw-bold text-muted"><i class="bi bi-cash-stack me-1 text-success"></i>Precio Máximo (RD$)</label>
                    <input type="number" name="MaxPrice" value="@filters.MaxPrice" class="form-control form-control-custom" placeholder="Max RD$" step="1000" />
                </div>

                <!-- 11. Metros Mínimos -->
                <div class="col-lg-3 col-md-6">
                    <label class="form-label small fw-bold text-muted"><i class="bi bi-aspect-ratio me-1 text-secondary"></i>Metros Mínimos (m²)</label>
                    <input type="number" name="MinSizeInMeters" value="@filters.MinSizeInMeters" class="form-control form-control-custom" placeholder="Ej: 80 m²" min="1" />
                </div>

                <!-- 12. Metros Máximos -->
                <div class="col-lg-3 col-md-6">
                    <label class="form-label small fw-bold text-muted"><i class="bi bi-aspect-ratio-fill me-1 text-secondary"></i>Metros Máximos (m²)</label>
                    <input type="number" name="MaxSizeInMeters" value="@filters.MaxSizeInMeters" class="form-control form-control-custom" placeholder="Ej: 500 m²" min="1" />
                </div>

                <!-- ================= BLOQUE 4: SWITCHES RÁPIDOS ESPECIALES (4 Columnas Perfectas) ================= -->
                <div class="col-lg-3 col-md-6">
                    <div class="form-check form-switch p-2 bg-light rounded-3 border h-100 d-flex align-items-center">
                        <input class="form-check-input ms-1 me-2" type="checkbox" name="OnlyFeatured" id="onlyFeaturedCheck" value="true" @(filters.OnlyFeatured == true ? "checked" : "") />
                        <label class="form-check-label fw-bold text-dark small mb-0" for="onlyFeaturedCheck">
                            <i class="bi bi-star-fill text-warning me-1"></i> Solo Destacados ⭐
                        </label>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="form-check form-switch p-2 bg-light rounded-3 border h-100 d-flex align-items-center">
                        <input class="form-check-input ms-1 me-2" type="checkbox" name="OnlyVerifiedAgents" id="onlyVerifiedAgentsCheck" value="true" @(filters.OnlyVerifiedAgents == true ? "checked" : "") />
                        <label class="form-check-label fw-bold text-dark small mb-0" for="onlyVerifiedAgentsCheck">
                            <i class="bi bi-patch-check-fill text-primary me-1"></i> Agente Verificado ✅
                        </label>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="form-check form-switch p-2 bg-light rounded-3 border h-100 d-flex align-items-center">
                        <input class="form-check-input ms-1 me-2" type="checkbox" name="OnlyFinanciable" id="onlyFinanciableCheck" value="true" @(filters.OnlyFinanciable == true ? "checked" : "") />
                        <label class="form-check-label fw-bold text-dark small mb-0" for="onlyFinanciableCheck">
                            <i class="bi bi-cash-coin text-success me-1"></i> Con Financiamiento 💳
                        </label>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="form-check form-switch p-2 bg-light rounded-3 border h-100 d-flex align-items-center">
                        <input class="form-check-input ms-1 me-2" type="checkbox" name="OnlyWithVirtualTour" id="onlyWithVirtualTourCheck" value="true" @(filters.OnlyWithVirtualTour == true ? "checked" : "") />
                        <label class="form-check-label fw-bold text-dark small mb-0" for="onlyWithVirtualTourCheck">
                            <i class="bi bi-badge-3d text-info me-1"></i> Tour 3D / Virtual 🕶️
                        </label>
                    </div>
                </div>

                <!-- ================= BLOQUE 5: SECCIÓN DE FILTRO POR MEJORAS / AMENIDADES ================= -->
                @if (filters.AvailableImprovements != null && filters.AvailableImprovements.Count > 0)
                {
                    <div class="col-12 mt-2">
                        <div class="p-3 bg-light rounded-4 border">
                            <label class="form-label small fw-bold text-dark d-block mb-2">
                                <i class="bi bi-check-all text-primary me-1"></i> Filtrar por Mejoras e Instalaciones Deseadas:
                            </label>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var imp in filters.AvailableImprovements)
                                {
                                    var isChecked = filters.ImprovementIds != null && filters.ImprovementIds.Contains(imp.Id);
                                    <div class="improvement-pill-toggle">
                                        <input type="checkbox" name="ImprovementIds" value="@imp.Id" id="filter_imp_@imp.Id" @(isChecked ? "checked" : "") autocomplete="off" />
                                        <label for="filter_imp_@imp.Id">
                                            <i class="bi bi-check-circle-fill"></i> @imp.Name
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                <!-- ================= BOTÓN DE ACCIÓN ================= -->
                <div class="col-12 text-end mt-2">
                    <button type="submit" class="btn btn-primary-gradient px-5 py-2 font-heading fw-bold rounded-pill shadow-sm">
                        <i class="bi bi-funnel-fill me-2"></i> Aplicar Filtros Avanzados
                    </button>
                </div>
            </div>
        </form>
    </div>

    <!-- Barra de Filtros Activos (Tags) -->
    @if (hasActiveFilters)
    {
        <div class="d-flex flex-wrap gap-2 align-items-center mb-4 p-3 bg-white rounded-4 shadow-sm border">
            <span class="text-muted small fw-bold"><i class="bi bi-tags-fill text-primary me-1"></i> Filtros Activos:</span>
            
            @if (!string.IsNullOrEmpty(filters.Code))
            {
                <span class="badge bg-light text-dark border p-2 rounded-pill font-heading">
                    Código: @filters.Code
                </span>
            }
            @if (filters.ProvinceId.HasValue && filters.Provinces != null)
            {
                var provName = filters.Provinces.FirstOrDefault(p => p.Id == filters.ProvinceId)?.Name;
                <span class="badge bg-light text-dark border p-2 rounded-pill font-heading">
                    Provincia: @provName
                </span>
            }
            @if (filters.MunicipalityId.HasValue && filters.Municipalities != null)
            {
                var munName = filters.Municipalities.FirstOrDefault(m => m.Id == filters.MunicipalityId)?.Name;
                <span class="badge bg-light text-dark border p-2 rounded-pill font-heading">
                    Municipio: @munName
                </span>
            }
            @if (!string.IsNullOrEmpty(filters.Sector))
            {
                <span class="badge bg-light text-dark border p-2 rounded-pill font-heading">
                    Sector: @filters.Sector
                </span>
            }
            @if (filters.MinPrice.HasValue || filters.MaxPrice.HasValue)
            {
                <span class="badge bg-light text-dark border p-2 rounded-pill font-heading">
                    Precio: @(filters.MinPrice?.ToString("C0") ?? "0") - @(filters.MaxPrice?.ToString("C0") ?? "Max")
                </span>
            }
            @if (filters.MinSizeInMeters.HasValue || filters.MaxSizeInMeters.HasValue)
            {
                <span class="badge bg-light text-dark border p-2 rounded-pill font-heading">
                    Tamaño: @(filters.MinSizeInMeters?.ToString() ?? "0") - @(filters.MaxSizeInMeters?.ToString() ?? "Max") m²
                </span>
            }
            @if (filters.MinRooms.HasValue)
            {
                <span class="badge bg-light text-dark border p-2 rounded-pill font-heading">
                    Min. @filters.MinRooms Habs
                </span>
            }
            @if (filters.MinBathrooms.HasValue)
            {
                <span class="badge bg-light text-dark border p-2 rounded-pill font-heading">
                    Min. @filters.MinBathrooms Baños
                </span>
            }
            @if (filters.OnlyFeatured == true)
            {
                <span class="badge bg-warning text-dark border border-warning p-2 rounded-pill font-heading fw-bold">
                    ⭐ Solo Destacados
                </span>
            }
            @if (filters.OnlyVerifiedAgents == true)
            {
                <span class="badge bg-success bg-opacity-25 text-success border border-success p-2 rounded-pill font-heading fw-bold">
                    🛡️ Agentes Verificados
                </span>
            }
            @if (filters.OnlyFinanciable == true)
            {
                <span class="badge bg-info bg-opacity-25 text-info border border-info p-2 rounded-pill font-heading fw-bold">
                    💳 Financiables
                </span>
            }
            @if (filters.OnlyWithVirtualTour == true)
            {
                <span class="badge bg-primary bg-opacity-25 text-primary border border-primary p-2 rounded-pill font-heading fw-bold">
                    🕶️ Tour 3D / Virtual
                </span>
            }
        </div>
    }

    <!-- Grilla de Resultados de Propiedades -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="font-heading mb-0">Propiedades Encontradas (@Model.Count)</h4>
        <span class="text-muted small">Mostrando resultados coincidentes</span>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="text-center py-5 bg-white rounded-4 shadow-sm border">
            <i class="bi bi-house-x fs-1 text-muted d-block mb-3"></i>
            <h5 class="font-heading text-dark">No se encontraron propiedades</h5>
            <p class="text-muted small">Intenta ajustar los criterios de búsqueda o limpiar los filtros activos.</p>
            <a asp-action="Index" class="btn btn-outline-custom rounded-pill mt-2">Ver Todas las Propiedades</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card-property">
                        <div class="img-container">
                            @if (item.IsCurrentlyFeatured)
                            {
                                <span class="badge bg-warning text-dark position-absolute top-0 start-0 m-3 fw-bold shadow-sm" style="z-index: 5; font-size: 0.78rem; border-radius: 8px;">
                                    <i class="bi bi-star-fill me-1 text-dark"></i> DESTACADO
                                </span>
                            }
                            else
                            {
                                <span class="code-badge">Código: @item.Code</span>
                            }
                            
                            @{
                                var displayStatus = (item.Status == "Disponible" && item.IsFinanciable) ? "Financiable" : item.Status;
                                var statusClass = displayStatus == "Financiable" ? "badge-financiable" :
                                                  item.Status == "Disponible" ? "badge-disponible" :
                                                  item.Status == "Reservada" ? "badge-reservada" : "badge-vendida";
                            }
                            <span class="status-badge @statusClass">@displayStatus</span>

                            @if (item.Images != null && item.Images.Count > 0)
                            {
                                <img src="@item.Images[0]" alt="@item.Name" />
                            }
                            else
                            {
                                <img src="https://images.unsplash.com/photo-1560518883-ce09059eeffa?auto=format&fit=crop&w=800&q=80" alt="Placeholder" />
                            }

                            <div class="price-tag">
                                @item.Price.ToString("C0")
                            </div>

                            @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Client"))
                            {
                                <form asp-controller="Favorites" asp-action="Toggle" method="post" class="d-inline">
                                    <input type="hidden" name="propertyId" value="@item.Id" />
                                    <button type="submit" class="fav-btn-overlay @(item.IsFavorite ? "active" : "")" title="Guardar en favoritos">
                                        <i class="bi @(item.IsFavorite ? "bi-heart-fill" : "bi-heart")"></i>
                                    </button>
                                </form>
                            }
                        </div>

                        <div class="card-body p-4 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex flex-wrap align-items-center gap-1 mb-2">
                                    <span class="badge bg-light text-primary border">@item.PropertyTypeName</span>
                                    <span class="badge bg-light text-dark border">@item.SaleTypeName</span>
                                    @if (item.IsCurrentlyFeatured)
                                    {
                                        <span class="badge bg-light text-muted border">Cód: @item.Code</span>
                                    }
                                    @if (item.IsAgentVerified)
                                    {
                                        <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50 fw-bold ms-auto" title="Publicado por Agente Verificado">
                                            <i class="bi bi-patch-check-fill text-primary me-1"></i> Verificado
                                        </span>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(item.ProvinceName) || !string.IsNullOrEmpty(item.Sector))
                                {
                                    <div class="text-danger small mb-1 fw-semibold text-truncate">
                                        <i class="bi bi-geo-alt-fill me-1"></i>@(string.IsNullOrEmpty(item.Sector) ? item.ProvinceName : $"{item.Sector}, {item.ProvinceName}")
                                    </div>
                                }
                                <h5 class="font-heading fw-bold text-dark mb-1 text-truncate" title="@item.Name">@item.Name</h5>
                                <p class="text-muted small mb-3 text-truncate-2">@item.Description</p>
                            </div>

                            <div>
                                <hr class="my-3 opacity-25">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="metric-pill"><i class="bi bi-door-open-fill"></i> @item.Rooms Habs</span>
                                    <span class="metric-pill"><i class="bi bi-droplet-fill"></i> @item.Bathrooms Baños</span>
                                    <span class="metric-pill"><i class="bi bi-aspect-ratio-fill"></i> @item.SizeInMeters m²</span>
                                </div>

                                <div class="d-flex gap-2">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-custom flex-grow-1 py-2">
                                        Ver Detalle <i class="bi bi-arrow-right ms-1"></i>
                                    </a>
                                    <button type="button" class="btn btn-outline-info rounded-pill px-3" onclick="PropertyComparator.add(@item.Id, '@item.Name.Replace("'", "\\'")', '@item.Price.ToString("N0")', '@(item.Images?.FirstOrDefault())')" title="Agregar a Comparador">
                                        <i class="bi bi-arrow-left-right"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Función para actualizar sectores según provincia y municipio
            async function updateSectors(provinceId, municipalityId) {
                const $datalist = $('#sectorsDatalist');
                const $menu = $('#sectorsDropdownMenu');
                
                try {
                    let url = '/Home/GetSectors';
                    const params = [];
                    if (provinceId) params.push(`provinceId=${provinceId}`);
                    if (municipalityId) params.push(`municipalityId=${municipalityId}`);
                    if (params.length > 0) url += `?${params.join('&')}`;

                    const response = await fetch(url);
                    const sectors = await response.json();

                    $datalist.empty();
                    $menu.find('.select-sector-item, .no-sectors-item').parent().remove();

                    if (sectors && sectors.length > 0) {
                        sectors.forEach(function (s) {
                            $datalist.append(`<option value="${s}"></option>`);
                            $menu.append(`<li><a class="dropdown-item select-sector-item" href="javascript:void(0);" data-sector="${s}">${s}</a></li>`);
                        });
                    } else {
                        $menu.append('<li class="px-3 py-1 text-muted small no-sectors-item">Sin sectores registrados</li>');
                    }
                } catch (err) {
                    console.error('Error al actualizar sectores:', err);
                }
            }

            // Manejo de dropdown en cascada: Provincia -> Municipios y Sectores
            $('#provinceFilterSelect').on('change', async function () {
                const provinceId = $(this).val();
                const $municipalitySelect = $('#municipalityFilterSelect');
                
                $municipalitySelect.html('<option value="">Todos los municipios</option>');
                
                // Actualizar sectores
                updateSectors(provinceId, null);

                if (!provinceId) {
                    return;
                }

                $municipalitySelect.html('<option value="">Cargando municipios...</option>');

                try {
                    const response = await fetch(`/Home/GetMunicipalities?provinceId=${provinceId}`);
                    const data = await response.json();
                    
                    $municipalitySelect.html('<option value="">Todos los municipios</option>');
                    data.forEach(function (m) {
                        $municipalitySelect.append(`<option value="${m.id}">${m.name}</option>`);
                    });
                } catch (err) {
                    console.error('Error al cargar municipios:', err);
                    $municipalitySelect.html('<option value="">Error al cargar</option>');
                }
            });

            // Manejo de cambio en Municipio -> Actualizar Sectores
            $('#municipalityFilterSelect').on('change', function () {
                const provinceId = $('#provinceFilterSelect').val();
                const municipalityId = $(this).val();
                updateSectors(provinceId, municipalityId);
            });

            // Selección rápida de sector desde el dropdown
            $(document).on('click', '.select-sector-item', function () {
                const sectorName = $(this).data('sector');
                $('#sectorFilterInput').val(sectorName);
            });

            // Geolocalización
            $('#btnGeolocate').click(function () {
                if ('geolocation' in navigator) {
                    var $btn = $(this);
                    $btn.html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>');
                    navigator.geolocation.getCurrentPosition(function (position) {
                        $('#userLatInput').val(position.coords.latitude);
                        $('#userLngInput').val(position.coords.longitude);
                        if (!$('#maxDistanceInput').val()) {
                            $('#maxDistanceInput').val(15);
                        }
                        $btn.html('<i class="bi bi-check-lg text-success"></i>');
                        alert('¡Ubicación GPS obtenida! Presiona Aplicar Filtros para buscar.');
                    }, function (err) {
                        $btn.html('<i class="bi bi-crosshair"></i>');
                        alert('No se pudo acceder a la ubicación. Permite el permiso en tu navegador.');
                    });
                } else {
                    alert('Tu navegador no soporta geolocalización.');
                }
            });
        });
    </script>
}
