@model List<RealEstateApp.Core.Application.ViewModels.Property.PropertyViewModel>
@{
    ViewData["Title"] = "Comparador de Propiedades";
}

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="font-heading fw-bold mb-1 d-flex align-items-center gap-2">
                <i class="bi bi-arrow-left-right text-info"></i> Comparativa de Propiedades
            </h2>
            <p class="text-muted small mb-0">Analiza las especificaciones, características y precios lado a lado.</p>
        </div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> Volver al Catálogo
        </a>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="card border-0 shadow-sm rounded-4 text-center py-5">
            <div class="card-body">
                <i class="bi bi-building-exclamation fs-1 text-muted d-block mb-3"></i>
                <h5 class="fw-bold">No hay propiedades seleccionadas para comparar</h5>
                <p class="text-muted small">Selecciona hasta 4 propiedades en el catálogo para visualizarlas aquí.</p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary-gradient rounded-pill px-4">Explorar Inmuebles</a>
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered align-middle text-center bg-white shadow-sm rounded-4 overflow-hidden">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 20%;" class="text-start ps-4">Característica</th>
                        @foreach (var item in Model)
                        {
                            <th style="width: @(80 / Model.Count)%;">
                                <div class="position-relative p-2">
                                    <img src="@(item.Images.FirstOrDefault() ?? "/images/default-property.jpg")" class="img-fluid rounded-3 mb-2" style="height: 140px; width: 100%; object-fit: cover;" />
                                    <h6 class="fw-bold text-white mb-1 text-truncate">@item.Name</h6>
                                    <span class="badge bg-info text-dark font-monospace mb-2">Código: @item.Code</span>
                                    <div class="d-grid">
                                        <a asp-controller="Home" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-light rounded-pill">Ver Detalle</a>
                                    </div>
                                </div>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <th class="text-start ps-4 bg-light fw-bold text-dark"><i class="bi bi-tag text-success me-2"></i>Precio de Venta</th>
                        @foreach (var item in Model)
                        {
                            <td class="fs-5 fw-bold text-success">@item.Price.ToString("C0")</td>
                        }
                    </tr>
                    <tr>
                        <th class="text-start ps-4 bg-light fw-bold text-dark"><i class="bi bi-cash text-primary me-2"></i>Monto Separación</th>
                        @foreach (var item in Model)
                        {
                            <td class="fw-semibold">@item.MontoSeparacion.ToString("C0")</td>
                        }
                    </tr>
                    <tr>
                        <th class="text-start ps-4 bg-light fw-bold text-dark"><i class="bi bi-bounding-box me-2 text-warning"></i>Tamaño (m²)</th>
                        @foreach (var item in Model)
                        {
                            <td><span class="badge bg-light text-dark border font-monospace fs-6">@item.SizeInMeters.ToString("N0") m²</span></td>
                        }
                    </tr>
                    <tr>
                        <th class="text-start ps-4 bg-light fw-bold text-dark"><i class="bi bi-door-open me-2 text-info"></i>Habitaciones</th>
                        @foreach (var item in Model)
                        {
                            <td class="fw-bold">@item.Rooms hab.</td>
                        }
                    </tr>
                    <tr>
                        <th class="text-start ps-4 bg-light fw-bold text-dark"><i class="bi bi-droplet me-2 text-primary"></i>Baños</th>
                        @foreach (var item in Model)
                        {
                            <td class="fw-bold">@item.Bathrooms baños</td>
                        }
                    </tr>
                    <tr>
                        <th class="text-start ps-4 bg-light fw-bold text-dark"><i class="bi bi-building me-2 text-secondary"></i>Tipo de Inmueble</th>
                        @foreach (var item in Model)
                        {
                            <td>@item.PropertyTypeName</td>
                        }
                    </tr>
                    <tr>
                        <th class="text-start ps-4 bg-light fw-bold text-dark"><i class="bi bi-cart me-2 text-danger"></i>Tipo de Venta</th>
                        @foreach (var item in Model)
                        {
                            <td><span class="badge bg-secondary">@item.SaleTypeName</span></td>
                        }
                    </tr>
                    <tr>
                        <th class="text-start ps-4 bg-light fw-bold text-dark"><i class="bi bi-stars me-2 text-warning"></i>Mejoras Incluidas</th>
                        @foreach (var item in Model)
                        {
                            <td>
                                @if (item.Improvements != null && item.Improvements.Count > 0)
                                {
                                    <div class="d-flex flex-wrap justify-content-center gap-1">
                                        @foreach (var imp in item.Improvements)
                                        {
                                            <span class="badge bg-light text-dark border"><i class="bi bi-check-circle-fill text-success me-1"></i>@imp</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small">Sin mejoras adicionales</span>
                                }
                            </td>
                        }
                    </tr>
                </tbody>
            </table>
        </div>
    }
</div>
