@{
    ViewData["Title"] = "Confirmación de Cuenta";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card border-0 shadow-lg rounded-4 p-5">
                <div class="d-inline-flex p-4 rounded-circle bg-success bg-opacity-10 text-success mb-4 mx-auto" style="width: 90px; height: 90px; align-items: center; justify-content: center;">
                    <i class="bi bi-envelope-check-fill fs-1"></i>
                </div>
                <h3 class="font-heading fw-bold mb-3">Estado de Activación</h3>
                <p class="text-secondary lead fs-6 mb-4">
                    @(ViewBag.Message ?? "Proceso de confirmación completado.")
                </p>
                <div>
                    <a asp-action="Login" class="btn btn-primary-gradient px-4 py-2 rounded-pill font-heading fw-bold">
                        <i class="bi bi-box-arrow-in-right me-2"></i> Ir al Inicio de Sesión
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
