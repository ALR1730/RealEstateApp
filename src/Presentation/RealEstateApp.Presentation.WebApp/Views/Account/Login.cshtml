@model RealEstateApp.Core.Application.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-dark text-white p-4 text-center border-0" style="background: var(--bg-gradient-hero) !important;">
                    <div class="d-inline-flex p-3 rounded-circle bg-white bg-opacity-10 mb-3">
                        <i class="bi bi-person-fill-lock fs-1 text-info"></i>
                    </div>
                    <h3 class="font-heading text-white fw-bold mb-1">Bienvenido de Nuevo</h3>
                    <p class="small text-white-50 mb-0">Ingrese sus credenciales para acceder a la plataforma</p>
                </div>

                <div class="card-body p-4 p-md-5">
                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                    {
                        <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-2">
                            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                            <div>@Html.ValidationSummary(true, "", new { @class = "mb-0" })</div>
                        </div>
                    }

                    <form asp-action="Login" method="post">
                        <input type="hidden" asp-for="ReturnUrl" />

                        <div class="mb-4">
                            <label asp-for="Email" class="form-label fw-medium text-dark small"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope text-muted"></i></span>
                                <input asp-for="Email" class="form-control form-control-custom border-start-0" placeholder="ejemplo@correo.com" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Password" class="form-label fw-medium text-dark small"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-key text-muted"></i></span>
                                <input asp-for="Password" class="form-control form-control-custom border-start-0" placeholder="••••••••" />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check">
                                <input asp-for="RememberMe" class="form-check-input" />
                                <label asp-for="RememberMe" class="form-check-label small text-muted"></label>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary-gradient w-100 py-3 rounded-3 font-heading fw-bold">
                            <i class="bi bi-box-arrow-in-right me-2"></i> Iniciar Sesión
                        </button>
                    </form>

                    <div class="position-relative my-4 text-center">
                        <hr class="text-muted opacity-25">
                        <span class="position-absolute top-50 start-50 translate-middle bg-white px-3 small text-muted font-heading">ó</span>
                    </div>

                    <form asp-action="GoogleLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                        <button type="submit" class="btn btn-outline-dark w-100 py-3 rounded-3 font-heading fw-bold d-flex align-items-center justify-content-center gap-2 shadow-sm">
                            <i class="bi bi-google text-danger fs-5"></i> Continuar con Google
                        </button>
                    </form>
                </div>

                <div class="card-footer bg-light p-4 text-center border-0">
                    <p class="small text-muted mb-0">
                        ¿No tienes una cuenta? 
                        <a asp-action="Register" class="fw-bold text-primary text-decoration-none">Únete a la app aquí</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
