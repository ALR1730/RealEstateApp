@model RealEstateApp.Core.Application.ViewModels.Account.RegisterViewModel
@{
    ViewData["Title"] = "Únete a la App";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-dark text-white p-4 text-center border-0" style="background: var(--bg-gradient-hero) !important;">
                    <div class="d-inline-flex p-3 rounded-circle bg-white bg-opacity-10 mb-3">
                        <i class="bi bi-person-plus-fill fs-1 text-info"></i>
                    </div>
                    <h3 class="font-heading text-white fw-bold mb-1">Crea tu Cuenta</h3>
                    <p class="small text-white-50 mb-0">Selecciona el tipo de cuenta e ingresa tus datos para empezar</p>
                </div>

                <div class="card-body p-4 p-md-5">
                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                    {
                        <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4">
                            @Html.ValidationSummary(true, "", new { @class = "mb-0" })
                        </div>
                    }

                    <form asp-action="Register" method="post">
                        <!-- Selección de Tipo de Usuario -->
                        <div class="mb-4 text-center">
                            <label class="form-label fw-bold text-dark d-block mb-3">Quiero registrarme como:</label>
                            <div class="btn-group w-100 role-selector" role="group">
                                <input type="radio" class="btn-check" name="UserType" id="userTypeClient" value="Client" @(Model.UserType != "Agent" && Model.UserType != "Developer" ? "checked" : "") autocomplete="off">
                                <label class="btn btn-outline-primary py-3 rounded-start-3 fw-bold" for="userTypeClient">
                                    <i class="bi bi-person-heart fs-4 d-block mb-1"></i> Cliente (Comprador)
                                </label>

                                <input type="radio" class="btn-check" name="UserType" id="userTypeAgent" value="Agent" @(Model.UserType == "Agent" ? "checked" : "") autocomplete="off">
                                <label class="btn btn-outline-primary py-3 fw-bold" for="userTypeAgent">
                                    <i class="bi bi-building-fill-gear fs-4 d-block mb-1"></i> Agente Inmobiliario
                                </label>

                                <input type="radio" class="btn-check" name="UserType" id="userTypeDeveloper" value="Developer" @(Model.UserType == "Developer" ? "checked" : "") autocomplete="off">
                                <label class="btn btn-outline-primary py-3 rounded-end-3 fw-bold" for="userTypeDeveloper">
                                    <i class="bi bi-code-slash fs-4 d-block mb-1"></i> Desarrollador (API)
                                </label>
                            </div>
                            <span asp-validation-for="UserType" class="text-danger small"></span>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="FirstName" class="form-label fw-medium text-dark small"></label>
                                <input asp-for="FirstName" class="form-control form-control-custom" placeholder="Juan" />
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="LastName" class="form-label fw-medium text-dark small"></label>
                                <input asp-for="LastName" class="form-control form-control-custom" placeholder="Pérez" />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-medium text-dark small"></label>
                                <input asp-for="Email" class="form-control form-control-custom" placeholder="juan@correo.com" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="UserName" class="form-label fw-medium text-dark small"></label>
                                <input asp-for="UserName" class="form-control form-control-custom" placeholder="juanperez" />
                                <span asp-validation-for="UserName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label fw-medium text-dark small"></label>
                                <input asp-for="Phone" class="form-control form-control-custom" placeholder="+1 (809) 000-0000" />
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6"></div>

                            <div class="col-md-6">
                                <label asp-for="Password" class="form-label fw-medium text-dark small"></label>
                                <input asp-for="Password" class="form-control form-control-custom" placeholder="••••••••" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ConfirmPassword" class="form-label fw-medium text-dark small"></label>
                                <input asp-for="ConfirmPassword" class="form-control form-control-custom" placeholder="••••••••" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mt-4 pt-2">
                            <button type="submit" class="btn btn-primary-gradient w-100 py-3 rounded-3 font-heading fw-bold">
                                <i class="bi bi-check-circle-fill me-2"></i> Crear Cuenta
                            </button>
                        </div>
                    </form>

                    <div class="position-relative my-4 text-center">
                        <hr class="text-muted opacity-25">
                        <span class="position-absolute top-50 start-50 translate-middle bg-white px-3 small text-muted font-heading">ó</span>
                    </div>

                    <form asp-action="GoogleLogin" method="post">
                        <button type="submit" class="btn btn-outline-dark w-100 py-3 rounded-3 font-heading fw-bold d-flex align-items-center justify-content-center gap-2 shadow-sm">
                            <i class="bi bi-google text-danger fs-5"></i> Registrarse con Google
                        </button>
                    </form>
                </div>

                <div class="card-footer bg-light p-4 text-center border-0">
                    <p class="small text-muted mb-0">
                        ¿Ya tienes una cuenta? 
                        <a asp-action="Login" class="fw-bold text-primary text-decoration-none">Inicia sesión aquí</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
