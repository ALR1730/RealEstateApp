@model List<RealEstateApp.Core.Application.ViewModels.UserActivity.UserActivityViewModel>
@{
    ViewData["Title"] = "Historial de Actividades";
}

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="font-heading mb-1 text-dark">
                <i class="bi bi-clock-history text-info me-2"></i> Historial de Actividades
            </h2>
            <p class="text-muted mb-0 small">Registro cronológico de tus interacciones y navegación reciente en la plataforma</p>
        </div>
        <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-secondary rounded-pill px-3 btn-sm">
            <i class="bi bi-person me-1"></i> Mi Perfil
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="card border-0 shadow-sm p-5 text-center bg-white rounded-4">
            <div class="mb-3">
                <i class="bi bi-calendar-x text-muted" style="font-size: 3.5rem;"></i>
            </div>
            <h5 class="fw-bold text-dark mb-2">No hay actividad registrada aún</h5>
            <p class="text-muted small mx-auto" style="max-width: 400px;">
                A medida que navegues por el catálogo, guardes favoritos, simules hipotecas o envíes ofertas, tu historial se actualizará automáticamente aquí.
            </p>
            <div class="mt-3">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary-gradient rounded-pill px-4">
                    <i class="bi bi-compass me-1"></i> Explorar Inmuebles
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm bg-white rounded-4 p-4">
            <div class="timeline position-relative ps-4 ms-2">
                @foreach (var activity in Model)
                {
                    <div class="timeline-item position-relative pb-4 ps-4 border-start border-2 border-info-subtle">
                        <!-- Icon Circle -->
                        <div class="timeline-badge position-absolute top-0 start-0 translate-middle rounded-circle bg-white border border-2 border-info d-flex align-items-center justify-content-center shadow-sm"
                             style="width: 36px; height: 36px; margin-left: -1px;">
                            <i class="bi @activity.Icon fs-6 text-info"></i>
                        </div>

                        <!-- Content Card -->
                        <div class="card border-0 bg-light rounded-3 p-3 ms-2 shadow-sm hover-lift">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <span class="fw-bold text-dark">@activity.Action</span>
                                <span class="badge bg-secondary-subtle text-secondary rounded-pill font-monospace small">
                                    <i class="bi bi-clock me-1"></i>@activity.TimeAgo
                                </span>
                            </div>
                            <p class="text-muted mb-2 small">@activity.Description</p>

                            <div class="d-flex align-items-center justify-content-between pt-1">
                                <span class="text-secondary opacity-75" style="font-size: 0.75rem;">
                                    <i class="bi bi-calendar3 me-1"></i>@activity.CreatedAt.ToString("dd/MM/yyyy - hh:mm tt")
                                </span>
                                @if (!string.IsNullOrEmpty(activity.TargetUrl))
                                {
                                    <a href="@activity.TargetUrl" class="btn btn-sm btn-outline-info rounded-pill px-3 py-1 text-decoration-none" style="font-size: 0.8rem;">
                                        Ver Más <i class="bi bi-arrow-right ms-1"></i>
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<style>
    .hover-lift {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .hover-lift:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.08) !important;
    }
</style>
