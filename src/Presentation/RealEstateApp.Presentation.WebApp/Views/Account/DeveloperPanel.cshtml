@model Microsoft.AspNetCore.Identity.IdentityUser
@{
    ViewData["Title"] = "Panel del Desarrollador";
}

<div class="container py-5">
    <!-- Encabezado Principal -->
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 mb-4 bg-white">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill font-heading fw-bold mb-2">
                    <i class="bi bi-code-slash me-1"></i> Acceso a la Web API REST
                </span>
                <h2 class="font-heading text-dark fw-bold display-6 mb-1">Panel del Desarrollador</h2>
                <p class="text-muted mb-0">Gestiona tus credenciales, genera tus tokens JWT y consume la API RESTful de RealEstateApp.</p>
            </div>
            <div>
                <a href="http://localhost:5196/index.html" target="_blank" class="btn btn-primary-gradient btn-lg px-4 font-heading fw-bold rounded-pill shadow-sm">
                    <i class="bi bi-box-arrow-up-right me-2"></i> Abrir Swagger UI (API Docs)
                </a>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Tarjeta de Datos del Desarrollador -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white">
                <h5 class="font-heading fw-bold text-dark mb-4 d-flex align-items-center gap-2">
                    <i class="bi bi-person-badge-fill text-primary"></i> Credenciales de Desarrollador
                </h5>

                <div class="d-flex align-items-center gap-3 mb-4 p-3 bg-light rounded-3">
                    <div class="avatar-lg bg-primary-soft text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold fs-3" style="width: 54px; height: 54px;">
                        <i class="bi bi-person-circle"></i>
                    </div>
                    <div>
                        <h6 class="font-heading fw-bold mb-0 text-dark">@Model.UserName</h6>
                        <span class="badge bg-primary rounded-pill mt-1">Rol: Developer</span>
                    </div>
                </div>

                <ul class="list-group list-group-flush small mb-4">
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-3 border-bottom">
                        <span class="text-muted"><i class="bi bi-envelope me-2"></i>Correo Conectado:</span>
                        <strong class="text-dark">@Model.Email</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-3 border-bottom">
                        <span class="text-muted"><i class="bi bi-shield-check me-2"></i>Estado de Cuenta:</span>
                        <span class="badge bg-success rounded-pill"><i class="bi bi-check-circle-fill me-1"></i> Activo / Verificado</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-3 border-bottom">
                        <span class="text-muted"><i class="bi bi-key-fill me-2"></i>ID de Usuario:</span>
                        <code class="text-primary font-mono">@Model.Id</code>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                        <span class="text-muted"><i class="bi bi-diagram-3 me-2"></i>Base URL (API):</span>
                        <code class="text-dark">http://localhost:5196/api/v1</code>
                    </li>
                </ul>

                <div class="alert alert-info border-0 rounded-3 p-3 mb-0 small">
                    <h6 class="font-heading fw-bold mb-1"><i class="bi bi-info-circle-fill me-1"></i> Cuentas Dev Pre-Cargadas:</h6>
                    <ul class="mb-0 ps-3">
                        <li><code>developer@realestate.com</code> | <code>Developer123!</code></li>
                        <li><code>dev2@realestate.com</code> | <code>Developer123!</code></li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Generador y Autenticador Interactivo de Token JWT -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white">
                <h5 class="font-heading fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-shield-lock-fill text-success"></i> Generador y Autenticador de Token JWT
                </h5>
                <p class="text-muted small mb-3">
                    Ingresa el correo y la contraseña de tu cuenta de desarrollador para generar y autenticar tu **Token JWT Bearer** en tiempo real.
                </p>

                <form id="jwtForm" class="row g-3 mb-3">
                    @Html.AntiForgeryToken()
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-dark mb-1">Correo Electrónico Dev</label>
                        <input type="email" id="jwtEmail" class="form-control form-control-custom" value="@Model.Email" placeholder="desarrollador@realestate.com" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-dark mb-1">Contraseña de Cuenta</label>
                        <input type="password" id="jwtPassword" class="form-control form-control-custom" placeholder="••••••••" value="Developer123!" required />
                    </div>
                    <div class="col-12">
                        <button type="button" id="btnGenerateToken" class="btn btn-primary-gradient w-100 py-2.5 font-heading fw-bold shadow-sm">
                            <i class="bi bi-key-fill me-1"></i> Generar y Autenticar Token JWT
                        </button>
                    </div>
                </form>

                <div id="jwtAlert" class="alert d-none small py-2 mb-3"></div>

                <!-- Token Result Box -->
                <div id="tokenResultBox" class="d-none">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="small font-heading fw-bold text-dark"><i class="bi bi-file-earmark-code-fill text-primary me-1"></i> Token JWT Bearer Generado:</span>
                        <button type="button" id="btnCopyToken" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1 font-heading">
                            <i class="bi bi-clipboard me-1"></i> Copiar Token
                        </button>
                    </div>
                    <textarea id="generatedJwtToken" class="form-control font-mono bg-dark text-success p-3 small rounded-3 mb-3" rows="4" readonly></textarea>

                    <div class="p-3 bg-light rounded-3 border mb-3">
                        <span class="small font-heading fw-bold text-muted d-block mb-1"><i class="bi bi-header me-1"></i> Formato de Cabecera HTTP:</span>
                        <code class="text-dark font-mono">Authorization: Bearer <span id="jwtHeaderPreview" class="text-primary">eyJhbGciOi...</span></code>
                    </div>

                    <!-- Probador Interactivo de Endpoints REST -->
                    <div class="border-top pt-3">
                        <h6 class="font-heading fw-bold text-dark mb-2"><i class="bi bi-play-circle-fill text-success me-1"></i> Probador de Endpoints REST en Vivo</h6>
                        <div class="input-group mb-2">
                            <select id="apiEndpointSelect" class="form-select font-mono small">
                                <option value="http://localhost:5196/api/v1/Properties">GET /api/v1/Properties (Catálogo)</option>
                                <option value="http://localhost:5196/api/v1/Agents">GET /api/v1/Agents (Agentes)</option>
                                <option value="http://localhost:5196/api/v1/PropertyTypes">GET /api/v1/PropertyTypes (Tipos Inmuebles)</option>
                                <option value="http://localhost:5196/api/v1/SaleTypes">GET /api/v1/SaleTypes (Tipos Ventas)</option>
                                <option value="http://localhost:5196/api/v1/Improvements">GET /api/v1/Improvements (Mejoras)</option>
                                <option value="http://localhost:5196/api/v1/Account/profile">GET /api/v1/Account/profile (Perfil)</option>
                            </select>
                            <button type="button" id="btnTestEndpoint" class="btn btn-success font-heading fw-bold px-3">
                                <i class="bi bi-send-fill me-1"></i> Probar
                            </button>
                        </div>
                        <div id="apiTestResponseBox" class="d-none">
                            <span class="small font-heading fw-bold text-muted d-block mb-1">Respuesta HTTP / JSON:</span>
                            <pre id="apiTestResponse" class="bg-dark text-light p-3 rounded-3 small font-mono mb-0" style="max-height: 220px; overflow-y: auto;"></pre>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Canal de Soporte & Solicitudes -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mt-4 bg-white">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <h5 class="font-heading fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                    <i class="bi bi-chat-left-text-fill text-info"></i> Centro de Solicitudes y Soporte Técnico
                </h5>
                <p class="text-muted small mb-0">Atiende reportes de errores y solicitudes de nuevos tipos de inmuebles o mejoras enviadas por agentes y usuarios.</p>
            </div>
            <div>
                <a asp-controller="Chats" asp-action="Index" class="btn btn-outline-info rounded-pill px-4 font-heading fw-bold">
                    <i class="bi bi-chat-dots me-1"></i> Ver Mensajes de Soporte <i class="bi bi-arrow-right-short"></i>
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $("#btnGenerateToken").click(function () {
                var email = $("#jwtEmail").val().trim();
                var password = $("#jwtPassword").val();
                var $alert = $("#jwtAlert");

                if (!email || !password) {
                    $alert.removeClass("d-none alert-success alert-info").addClass("alert-danger").text("Por favor ingresa tu correo y contraseña.").show();
                    return;
                }

                $alert.removeClass("d-none alert-danger alert-success").addClass("alert-info").text("Autenticando y generando token JWT...").show();

                function tryAuthenticate(targetUrl, fallbackUrl) {
                    var token = $('input[name="__RequestVerificationToken"]').val();
                    var reqHeaders = token ? { 'RequestVerificationToken': token } : {};

                    $.ajax({
                        url: targetUrl,
                        type: 'POST',
                        contentType: 'application/json',
                        headers: reqHeaders,
                        data: JSON.stringify({ email: email, password: password }),
                        success: function (res) {
                            if (res && res.jwToken) {
                                $alert.removeClass("alert-info alert-danger").addClass("alert-success").html('<i class="bi bi-check-circle-fill me-1"></i> ¡Token JWT generado y autenticado exitosamente para ' + (res.email || email) + '!');
                                $("#generatedJwtToken").val(res.jwToken);
                                $("#jwtHeaderPreview").text(res.jwToken.substring(0, 30) + "...");
                                $("#tokenResultBox").removeClass("d-none");
                            } else {
                                var errorMsg = (res && res.error) ? res.error : "No se pudo generar el token.";
                                $alert.removeClass("alert-info alert-success").addClass("alert-danger").text(errorMsg);
                            }
                        },
                        error: function (xhr) {
                            if (fallbackUrl) {
                                tryAuthenticate(fallbackUrl, null);
                            } else {
                                var errObj = xhr.responseJSON;
                                var msg = (errObj && errObj.error) ? errObj.error : (xhr.responseText ? xhr.responseText : "Error de autenticación. Verifica las credenciales.");
                                $alert.removeClass("alert-info alert-success").addClass("alert-danger").text(msg);
                            }
                        }
                    });
                }

                tryAuthenticate('http://localhost:5196/api/v1/Account/authenticate', '/Account/GenerateJwtToken');
            });

            $("#btnCopyToken").click(function () {
                var token = $("#generatedJwtToken").val();
                if (token) {
                    navigator.clipboard.writeText(token).then(function () {
                        $("#btnCopyToken").html('<i class="bi bi-check2 me-1"></i> ¡Copiado!');
                        setTimeout(function () {
                            $("#btnCopyToken").html('<i class="bi bi-clipboard me-1"></i> Copiar Token');
                        }, 2000);
                    });
                }
            });

            $("#btnTestEndpoint").click(function () {
                var url = $("#apiEndpointSelect").val();
                var token = $("#generatedJwtToken").val();
                var $respBox = $("#apiTestResponseBox");
                var $respPre = $("#apiTestResponse");

                if (!token) {
                    alert("Primero debes generar un Token JWT.");
                    return;
                }

                $respPre.text("Enviando petición a " + url + "...");
                $respBox.removeClass("d-none");

                $.ajax({
                    url: url,
                    type: 'GET',
                    headers: {
                        'Authorization': 'Bearer ' + token
                    },
                    success: function (data) {
                        $respPre.text(JSON.stringify(data, null, 2));
                    },
                    error: function (xhr) {
                        $respPre.text("Status " + xhr.status + " " + xhr.statusText + "\n\n" + JSON.stringify(xhr.responseJSON || xhr.responseText, null, 2));
                    }
                });
            });
        });
    </script>
}
