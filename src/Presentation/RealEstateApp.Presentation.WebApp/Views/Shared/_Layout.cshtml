<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RealEstateApp</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom sticky-top">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-building-fill text-info fs-3"></i>
                    <span>RealEstate</span>App
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
                        aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" 
                               asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Catálogo
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Agents" ? "active" : "")" 
                               asp-controller="Agents" asp-action="Index">
                                <i class="bi bi-person-badge me-1"></i> Agentes
                            </a>
                        </li>
                        
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Client"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Favorites" ? "active" : "")" 
                                       asp-controller="Favorites" asp-action="Index">
                                        <i class="bi bi-heart me-1"></i> Mis Favoritos
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Offers" ? "active" : "")" 
                                       asp-controller="Offers" asp-action="MyOffers">
                                        <i class="bi bi-cash-stack me-1"></i> Mis Ofertas
                                    </a>
                                </li>
                            }

                            @if (User.IsInRole("Agent"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Properties" ? "active" : "")" 
                                       asp-controller="Agent" asp-action="Properties">
                                        <i class="bi bi-building me-1"></i> Mis Inmuebles
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Offers" ? "active" : "")" 
                                       asp-controller="Agent" asp-action="Offers">
                                        <i class="bi bi-cash-coin me-1"></i> Ofertas Recibidas
                                    </a>
                                </li>
                            }

                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")" 
                                       asp-controller="Admin" asp-action="Dashboard">
                                        <i class="bi bi-speedometer2 me-1"></i> Dashboard
                                    </a>
                                </li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["action"]?.ToString() != "Dashboard" ? "active" : "")" 
                                       href="#" id="adminManageDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-person-gear me-1"></i> Gestión 
                                    </a>
                                    <ul class="dropdown-menu shadow-lg border-0" aria-labelledby="adminManageDropdown">
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Properties"><i class="bi bi-building me-2 text-primary"></i> Propiedades</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Agents"><i class="bi bi-person-badge me-2 text-info"></i> Agentes</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Developers"><i class="bi bi-code-slash me-2 text-dark"></i> Desarrolladores</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Admins"><i class="bi bi-shield-lock me-2 text-warning"></i> Administradores</a></li>
                                    </ul>
                                </li>
                            }

                            @if (User.IsInRole("Admin") || User.IsInRole("Developer"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="maintDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-gear-wide-connected me-1"></i> Mantenimiento
                                    </a>
                                    <ul class="dropdown-menu shadow-lg border-0" aria-labelledby="maintDropdown">
                                        <li><a class="dropdown-item" asp-controller="AdminPropertyTypes" asp-action="Index">Tipos de Propiedades</a></li>
                                        <li><a class="dropdown-item" asp-controller="AdminSaleTypes" asp-action="Index">Tipos de Ventas</a></li>
                                        <li><a class="dropdown-item" asp-controller="AdminImprovements" asp-action="Index">Mejoras de Propiedades</a></li>
                                    </ul>
                                </li>
                            }

                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Chats" ? "active" : "")" 
                                   asp-controller="Chats" asp-action="Index">
                                    <i class="bi bi-chat-dots me-1"></i> Mis Chats
                                </a>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <div class="dropdown">
                                <button class="btn btn-outline-light dropdown-toggle d-flex align-items-center gap-2 rounded-pill px-3" 
                                        type="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle fs-5 text-info"></i>
                                    <span>@User.Identity.Name</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 mt-2" aria-labelledby="userMenu">
                                    <li><h6 class="dropdown-header">Usuario Conectado</h6></li>
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Account" asp-action="Profile">
                                            <i class="bi bi-person-gear text-info"></i> Mi Perfil
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            <button type="submit" class="dropdown-item text-danger d-flex align-items-center gap-2">
                                                <i class="bi bi-box-arrow-right"></i> Cerrar Sesión
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-outline-light rounded-pill px-3 font-weight-bold" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar Sesión
                            </a>
                            <a class="btn btn-primary-gradient rounded-pill px-3" asp-controller="Account" asp-action="Register">
                                <i class="bi bi-person-plus me-1"></i> Únete a la App
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="main-content flex-grow-1">
        @RenderBody()
    </div>

    <footer class="footer-custom mt-5">
        <div class="container">
            <div class="row gy-4">
                <div class="col-md-5">
                    <h5 class="text-white font-heading d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-building-fill text-info"></i> RealEstateApp V2
                    </h5>
                    <p class="small text-muted mb-0">
                        La plataforma inmobiliaria líder para encontrar, simular y adquirir las mejores propiedades.
                        Ofrecemos transparencia, cálculo hipotecario en tiempo real y comunicación directa con agentes autorizados.
                    </p>
                </div>
                <div class="col-md-3 ms-auto">
                    <h6 class="text-white font-heading mb-3">Enlaces Rápidos</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a asp-controller="Home" asp-action="Index">Catálogo de Inmuebles</a></li>
                        <li class="mb-2"><a asp-controller="Agents" asp-action="Index">Directorio de Agentes</a></li>
                        <li class="mb-2"><a asp-controller="Account" asp-action="Register">Regístrate gratis</a></li>
                    </ul>
                </div>
                <div class="col-md-3">
                    <h6 class="text-white font-heading mb-3">Soporte y Contacto</h6>
                    <p class="small text-muted mb-1"><i class="bi bi-envelope me-2"></i> soporte@realestateapp.com</p>
                    <p class="small text-muted"><i class="bi bi-telephone me-2"></i> +1 (809) 555-0199</p>
                </div>
            </div>
            <hr class="border-secondary opacity-25 my-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center small text-muted">
                <div>&copy; @DateTime.UtcNow.Year RealEstateApp. Todos los derechos reservados.</div>
                <div>Desarrollado para arquitectura Onion & ASP.NET Core MVC 10</div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
