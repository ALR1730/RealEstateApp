<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RealEstateApp</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- PWA Manifest & Meta -->
    <link rel="manifest" href="~/manifest.json" />
    <meta name="theme-color" content="#0f172a" />
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom sticky-top">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-building-fill text-info fs-3"></i>
                    <span>RealEstate</span>App
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
                        aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" 
                               asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Catálogo
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Map" ? "active" : "")" 
                               asp-controller="Home" asp-action="Map">
                                <i class="bi bi-geo-alt me-1 text-info"></i> Mapa Global
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Agents" ? "active" : "")" 
                               asp-controller="Agents" asp-action="Index">
                                <i class="bi bi-person-badge me-1"></i> Agentes
                            </a>
                        </li>
                        
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Chats" ? "active" : "")" 
                                   asp-controller="Chats" asp-action="Index">
                                    <i class="bi bi-chat-dots me-1"></i> Mis Chats
                                </a>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        <!-- Dark Mode Theme Toggle Button -->
                        <button class="btn btn-outline-light rounded-circle p-2 theme-toggle-btn" style="width: 40px; height: 40px;" type="button" title="Modo Oscuro">
                            <i class="bi bi-moon-stars-fill text-info"></i>
                        </button>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <!-- Notification Center Bell Icon -->
                            <div class="dropdown me-1">
                                <button class="btn btn-outline-light rounded-circle p-2 position-relative" style="width: 40px; height: 40px;" type="button" id="notifBell" data-bs-toggle="dropdown" aria-expanded="false" title="Notificaciones">
                                    <i class="bi bi-bell-fill text-warning"></i>
                                    <span id="notificationBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none" style="font-size: 0.65rem;">0</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 mt-2 p-0" id="notificationDropdownMenu" style="width: 320px; max-height: 380px; overflow-y: auto;" aria-labelledby="notifBell">
                                    <li class="dropdown-header bg-dark text-white rounded-top py-2 px-3 fw-bold d-flex align-items-center justify-content-between">
                                        <span>Notificaciones en Vivo</span>
                                        <i class="bi bi-broadcast text-success"></i>
                                    </li>
                                    <li class="no-notif-item text-center py-4 text-muted small">
                                        <i class="bi bi-bell-slash d-block fs-4 mb-1 text-secondary"></i>
                                        Sin notificaciones pendientes
                                    </li>
                                </ul>
                            </div>

                            <div class="dropdown">
                                <button class="btn btn-outline-light dropdown-toggle d-flex align-items-center gap-2 rounded-pill px-3" 
                                        type="button" id="userMenu" data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false">
                                    <i class="bi bi-person-circle fs-5 text-info"></i>
                                    <span>@User.Identity.Name</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 mt-2" aria-labelledby="userMenu" style="min-width: 240px;">
                                    <li><h6 class="dropdown-header">Usuario Conectado</h6></li>
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Account" asp-action="Profile">
                                            <i class="bi bi-person-gear text-info"></i> Mi Perfil
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Account" asp-action="Activity">
                                            <i class="bi bi-clock-history text-info"></i> Historial de Actividades
                                        </a>
                                    </li>

                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li><hr class="dropdown-divider"></li>
                                        <li><h6 class="dropdown-header text-warning fw-bold">Panel Administrador</h6></li>
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Admin" asp-action="Dashboard">
                                                <i class="bi bi-speedometer2 text-warning"></i> Dashboard Admin
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Admin" asp-action="Properties">
                                                <i class="bi bi-building text-primary"></i> Gestión Propiedades
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Admin" asp-action="Agents">
                                                <i class="bi bi-person-badge text-info"></i> Gestión Agentes
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Admin" asp-action="Developers">
                                                <i class="bi bi-code-slash text-dark"></i> Gestión Desarrolladores
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Admin" asp-action="Admins">
                                                <i class="bi bi-shield-lock text-warning"></i> Administradores
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Admin" asp-action="Verifications">
                                                <i class="bi bi-patch-check-fill text-primary"></i> Verificaciones de Agentes
                                            </a>
                                        </li>
                                    }

                                    @if (User.IsInRole("Agent"))
                                    {
                                        <li><hr class="dropdown-divider"></li>
                                        <li><h6 class="dropdown-header text-warning fw-bold">Panel de Agente</h6></li>
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Agent" asp-action="Properties">
                                                <i class="bi bi-speedometer2 text-warning"></i> Dashboard / Mis Inmuebles
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Agent" asp-action="Offers">
                                                <i class="bi bi-cash-coin text-success"></i> Ofertas Recibidas
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Appointments" asp-action="AgentCalendar">
                                                <i class="bi bi-calendar3 text-info"></i> Agenda de Citas
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Agent" asp-action="Verification">
                                                <i class="bi bi-patch-check text-primary"></i> Verificación de Identidad
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Agent" asp-action="Subscriptions">
                                                <i class="bi bi-gem text-warning"></i> Mi Plan de Suscripción
                                            </a>
                                        </li>
                                    }

                                    @if (User.IsInRole("Owner"))
                                    {
                                        <li><hr class="dropdown-divider"></li>
                                        <li><h6 class="dropdown-header text-primary fw-bold">Panel de Propietario Directo</h6></li>
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Owner" asp-action="Index">
                                                <i class="bi bi-house-door text-primary"></i> Mis Inmuebles
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Owner" asp-action="CreateProperty">
                                                <i class="bi bi-plus-circle text-success"></i> Publicar Mi Inmueble
                                            </a>
                                        </li>
                                    }

                                    @if (User.IsInRole("Client"))
                                    {
                                        <li><hr class="dropdown-divider"></li>
                                        <li><h6 class="dropdown-header text-primary fw-bold">Mi Cuenta</h6></li>
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Favorites" asp-action="Index">
                                                <i class="bi bi-heart text-danger"></i> Mis Favoritos
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Offers" asp-action="MyOffers">
                                                <i class="bi bi-cash-stack text-success"></i> Mis Ofertas
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Appointments" asp-action="MyAppointments">
                                                <i class="bi bi-calendar-event text-info"></i> Mis Citas de Visita
                                            </a>
                                        </li>
                                    }

                                    @if (User.IsInRole("Admin") || User.IsInRole("Developer"))
                                    {
                                        <li><hr class="dropdown-divider"></li>
                                        <li><h6 class="dropdown-header text-secondary fw-bold">Mantenimiento</h6></li>
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center gap-2" asp-controller="AdminPropertyTypes" asp-action="Index">
                                                <i class="bi bi-house-door text-primary"></i> Tipos de Propiedades
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center gap-2" asp-controller="AdminSaleTypes" asp-action="Index">
                                                <i class="bi bi-tags text-warning"></i> Tipos de Ventas
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center gap-2" asp-controller="AdminImprovements" asp-action="Index">
                                                <i class="bi bi-stars text-danger"></i> Mejoras de Propiedades
                                            </a>
                                        </li>
                                    }

                                    @if (User.IsInRole("Developer"))
                                    {
                                        <li><hr class="dropdown-divider"></li>
                                        <li><h6 class="dropdown-header text-info fw-bold">API Developer</h6></li>
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Account" asp-action="DeveloperPanel">
                                                <i class="bi bi-code-slash text-info"></i> Panel API Developer
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center gap-2" href="http://localhost:5196/index.html" target="_blank">
                                                <i class="bi bi-box-arrow-up-right text-primary"></i> Swagger API Docs
                                            </a>
                                        </li>
                                    }

                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            <button type="submit" class="dropdown-item text-danger d-flex align-items-center gap-2">
                                                <i class="bi bi-box-arrow-right"></i> Cerrar Sesión
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-outline-light rounded-pill px-3 font-weight-bold" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar Sesión
                            </a>
                            <a class="btn btn-primary-gradient rounded-pill px-3" asp-controller="Account" asp-action="Register">
                                <i class="bi bi-person-plus me-1"></i> Únete a la App
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="main-content flex-grow-1">
        @RenderBody()
    </div>

    <footer class="footer-custom mt-5">
        <div class="container">
            <div class="row gy-4">
                <div class="col-md-5">
                    <h5 class="text-white font-heading d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-building-fill text-info"></i> RealEstateApp V3
                    </h5>
                    <p class="small text-muted mb-0">
                        La plataforma inmobiliaria líder para encontrar, simular y adquirir las mejores propiedades.
                        Ofrecemos transparencia, cálculo hipotecario en tiempo real y comunicación directa con agentes autorizados.
                    </p>
                </div>
                <div class="col-md-3 ms-auto">
                    <h6 class="text-white font-heading mb-3">Enlaces Rápidos</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a asp-controller="Home" asp-action="Index">Catálogo de Inmuebles</a></li>
                        <li class="mb-2"><a asp-controller="Home" asp-action="Map">Mapa Global</a></li>
                        <li class="mb-2"><a asp-controller="Agents" asp-action="Index">Directorio de Agentes</a></li>
                        <li class="mb-2"><a asp-controller="Account" asp-action="Register">Regístrate gratis</a></li>
                    </ul>
                </div>
                <div class="col-md-3">
                    <h6 class="text-white font-heading mb-3">Soporte y Contacto</h6>
                    <p class="small text-muted mb-1"><i class="bi bi-envelope me-2"></i> soporte@realestateapp.com</p>
                    <p class="small text-muted"><i class="bi bi-telephone me-2"></i> +1 (809) 555-0199</p>
                </div>
            </div>
            <hr class="border-secondary opacity-25 my-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center small text-muted">
                <div>&copy; @DateTime.UtcNow.Year RealEstateApp V3. Todos los derechos reservados.</div>
                <div>Desarrollado con ASP.NET Core & SignalR Realtime</div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="~/js/theme-toggle.js" asp-append-version="true"></script>
    <script src="~/js/notifications-realtime.js" asp-append-version="true"></script>
    <script src="~/js/property-comparator.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', function () {
                navigator.serviceWorker.register('/sw.js').then(function (reg) {
                    console.log('PWA ServiceWorker registrado con éxito:', reg.scope);
                }).catch(function (err) {
                    console.log('Error registrando PWA ServiceWorker:', err);
                });
            });
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
